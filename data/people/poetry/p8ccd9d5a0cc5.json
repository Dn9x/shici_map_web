},"p8ccd9d5a0cc5-item-cd2c6c98c9b4ba753f74":{"id":"p8ccd9d5a0cc5-item-cd2c6c98c9b4ba753f74","person_id":"p8ccd9d5a0cc5","title":"奉和受圖溫洛應制","units":[{"id":"p8ccd9d5a0cc5-item-cd2c6c98c9b4ba753f74-part-01","status":"automatic","work_id":"p8ccd9d5a0cc5-text-f525e754bda1fc31bdfe","title":"奉和受圖溫洛應制"}]},"p8ccd9d5a0cc5-item-784571435f27ee2ebc19":{"id":"p8ccd9d5a0cc5-item-784571435f27ee2ebc19","person_id":"p8ccd9d5a0cc5","title":"和武三思於天中寺尋復禮上人之作","units":[{"id":"p8ccd9d5a0cc5-item-784571435f27ee2ebc19-part-01","status":"automatic","work_id":"p8ccd9d5a0cc5-text-5b0a665cf589ad5d91d7","title":"和武三思於天中寺尋復禮上人之作"}]},"p8ccd9d5a0cc5-item-6c11fea87fc5b4c8a83b":{"id":"p8ccd9d5a0cc5-item-6c11fea87fc5b4c8a83b","person_id":"p8ccd9d5a0cc5","title":"","units":[]},"p8ccd9d5a0cc5-item-05105c4450bb7321af63":{"id":"p8ccd9d5a0cc5-item-05105c4450bb7321af63","person_id":"p8ccd9d5a0cc5","title":"詠霧","units":[{"id":"p8ccd9d5a0cc5-item-05105c4450bb7321af63-part-01","status":"automatic","work_id":"p8ccd9d5a0cc5-text-1b02e66bd26684e586d8","title":"詠霧"}]},"p8ccd9d5a0cc5-item-64d29fb0d7152c865d24":{"id":"p8ccd9d5a0cc5-item-64d29fb0d7152c865d24","person_id":"p8ccd9d5a0cc5","title":"","units":[]},"p8ccd9d5a0cc5-item-ebf56ed7b863341d6ac0":{"id":"p8ccd9d5a0cc5-item-ebf56ed7b863341d6ac0","person_id":"p8ccd9d5a0cc5","title":"詠霜","units":[{"id":"p8ccd9d5a0cc5-item-ebf56ed7b863341d6ac0-part-01","status":"automatic","work_id":"p8ccd9d5a0cc5-text-7b319de8121056a586e9","title":"詠霜"}]},"p8ccd9d5a0cc5-item-f729485c166c10d85c74":{"id":"p8ccd9d5a0cc5-item-f729485c166c10d85c74","person_id":"p8ccd9d5a0cc5","title":"詠井","units":[{"id":"p8ccd9d5a0cc5-item-f729485c166c10d85c74-part-01","status":"automatic","work_id":"p8ccd9d5a0cc5-text-bad1446a44980e0d5d06","title":"詠井"}]},"p8ccd9d5a0cc5-item-f7801e7ddc014f42ecb6":{"id":"p8ccd9d5a0cc5-item-f7801e7ddc014f42ecb6","person_id":"p8ccd9d5a0cc5","title":"詠石","units":[{"id":"p8ccd9d5a0cc5-item-f7801e7ddc014f42ecb6-part-01","status":"automatic","work_id":"p8ccd9d5a0cc5-text-e51ee83a486752a52b94","title":"詠石"}]},"p8ccd9d5a0cc5-item-fc0ee8ab623bab52563c":{"id":"p8ccd9d5a0cc5-item-fc0ee8ab623bab52563c","person_id":"p8ccd9d5a0cc5","title":"正月十五夜","units":[{"id":"p8ccd9d5a0cc5-item-fc0ee8ab623bab52563c-part-01","status":"automatic","work_id":"p8ccd9d5a0cc5-text-087308741d408e6e2d9e","title":"正月十五夜"}]}},"works":{"p8ccd9d5a0cc5-text-a4537cdb9642b1f30410":{"id":"p8ccd9d5a0cc5-text-a4537cdb9642b1f30410","person_id":"p8ccd9d5a0cc5","title":"單于川對雨二首 二","titles":["單于川對雨二首 二"],"text":"飛雨欲迎旬，浮雲已送春。\n還從濯枝後，來應洗兵辰。\n氣合龍祠外，聲過鯨海濱。\n伐邢知有屬，已見靜邊塵。"},"p8ccd9d5a0cc5-text-d22c709c6cfc3bc7996f":{"id":"p8ccd9d5a0cc5-text-d22c709c6cfc3bc7996f","person_id":"p8ccd9d5a0cc5","title":"單于川對雨二首 一","titles":["單于川對雨二首 一"],"text":"崇朝遘行雨，薄晚屯密雲。\n緣階起素沫，竟水聚圓文。\n河柳低未舉，山花落已芬。\n清尊久不薦，淹留遂待君。"},"p8ccd9d5a0cc5-text-82454c2677e1a8ae1621":{"id":"p8ccd9d5a0cc5-text-82454c2677e1a8ae1621","person_id":"p8ccd9d5a0cc5","title":"使嶺南聞崔馬二御史竝拜臺郎","titles":["使嶺南聞崔馬二御史竝拜臺郎"],"text":"振鷺齊飛日，遷鶯遠聽聞。\n明光共待漏，清鑒各披雲。\n喜得廊廟舉，嗟爲臺閣分。\n故林懷柏悅，新幄阻蘭薰。\n冠去神羊影，車迎瑞雉羣。\n遠從南斗外，遙仰列星文。"},"p8ccd9d5a0cc5-text-698b8c260c3840387487":{"id":"p8ccd9d5a0cc5-text-698b8c260c3840387487","person_id":"p8ccd9d5a0cc5","title":"九江口南濟北接蘄春南與潯陽岸","titles":["九江口南濟北接蘄春南與潯陽岸"],"text":"江路一悠哉，滔滔九派來。\n遠潭昏似霧，前浦沸成雷。\n鱗介多潛育，漁商幾泝洄。\n風搖蜀柹下，日照楚萍開。\n近漱湓城曲，斜吹蠡澤隈。\n錫龜猶入貢，浮獸罷爲災。\n津吏揮橈疾，郵童整傳催。\n歸心詎可問，爲視落潮迴。"},"p8ccd9d5a0cc5-text-d33fda0cf406f1530ba4":{"id":"p8ccd9d5a0cc5-text-d33fda0cf406f1530ba4","person_id":"p8ccd9d5a0cc5","title":"贈封御史入臺","titles":["贈封御史入臺"],"text":"故事推三獨，茲辰對兩闈。\n夕鴉共鳴舞，屈草接芳菲。\n盛府持清橐，殊章動繡衣。\n風連臺閣起，霜就簡書飛。\n凜凜當朝色，行行滿路威。\n惟當擊隼去，復覩落鵰歸。"},"p8ccd9d5a0cc5-text-f525e754bda1fc31bdfe":{"id":"p8ccd9d5a0cc5-text-f525e754bda1fc31bdfe","person_id":"p8ccd9d5a0cc5","title":"奉和受圖溫洛應制","titles":["奉和受圖溫洛應制"],"text":"綠綺膺河檢，清壇俯洛濱。\n天旋俄制蹕，孝享屬嚴禋。\n陟配光三祖，懷柔洎百神。\n霧開中道日，雪歛屬車塵。\n預奉咸英奏，長歌億萬春。"},"p8ccd9d5a0cc5-text-5b0a665cf589ad5d91d7":{"id":"p8ccd9d5a0cc5-text-5b0a665cf589ad5d91d7","person_id":"p8ccd9d5a0cc5","title":"和武三思於天中寺尋復禮上人之作","titles":["和武三思於天中寺尋復禮上人之作"],"text":"藩戚三雍暇，禪居二室隈。\n忽聞從桂苑，移步踐花臺。\n敏學推多藝，高談屬辯才。\n是非寧滯著，空有掠嫌猜。\n五行幽機暢，三蕃妙鍵開。\n味同甘露灑，香似逆風來。\n砌古留方石，池清辨燒灰。\n人尋鶴洲返，月逐虎谿迴。\n企躅瞻飛蓋，攀遊想渡杯。\n願陪爲善樂，從此去塵埃。"},"p8ccd9d5a0cc5-text-1b02e66bd26684e586d8":{"id":"p8ccd9d5a0cc5-text-1b02e66bd26684e586d8","person_id":"p8ccd9d5a0cc5","title":"詠霧","titles":["詠霧"],"text":"氤氳起洞壑，遙裔匝平疇。\n乍似含龍劒，還疑映蜃樓。\n拂林隨雨密，度徑帶煙浮。\n方謝公超步，終從彥輔遊。"},"p8ccd9d5a0cc5-text-7b319de8121056a586e9":{"id":"p8ccd9d5a0cc5-text-7b319de8121056a586e9","person_id":"p8ccd9d5a0cc5","title":"詠霜","titles":["詠霜"],"text":"金祇暮律盡，玉女暝氛歸。\n孕冷隨鐘徹，飄華逐劒飛。\n帶日浮寒影，乘風進晚威。\n自有貞筠質，寧將庶草腓。"},"p8ccd9d5a0cc5-text-bad1446a44980e0d5d06":{"id":"p8ccd9d5a0cc5-text-bad1446a44980e0d5d06","person_id":"p8ccd9d5a0cc5","title":"詠井","titles":["詠井"],"text":"玲瓏映玉檻，澄澈瀉銀牀。\n流聲集孔雀，帶影出羵羊。\n桐落秋蛙散，桃舒春錦芳。\n帝力終何有，機心庶此忘。"},"p8ccd9d5a0cc5-text-e51ee83a486752a52b94":{"id":"p8ccd9d5a0cc5-text-e51ee83a486752a52b94","person_id":"p8ccd9d5a0cc5","title":"詠石","titles":["詠石"],"text":"濟北甄神貺，河西濯錦文。\n聲應天池雨，影觸岱宗雲。\n燕歸猶可候，羊起自成羣。\n何當握靈髓，高枕絕囂氛。"},"p8ccd9d5a0cc5-text-087308741d408e6e2d9e":{"id":"p8ccd9d5a0cc5-text-087308741d408e6e2d9e","person_id":"p8ccd9d5a0cc5","title":"正月十五夜","titles":["正月十五夜"],"text":"火樹銀花合，星橋鐵鎖開。\n暗塵隨馬去，明月逐人來。\n遊伎皆穠李，行歌盡落梅。\n金吾不禁夜，玉漏莫相催。"}}}
