其四"},{"id":"p3988b05f7578-item-7a8ffdf8799d545fbae8-part-05","status":"automatic","work_id":"p3988b05f7578-text-2f6058fece9468f91e80","title":"南郊慶成口號二十首  其五"},{"id":"p3988b05f7578-item-7a8ffdf8799d545fbae8-part-06","status":"automatic","work_id":"p3988b05f7578-text-2864bdc0ea4c1c98dfc7","title":"南郊慶成口號二十首  其六"},{"id":"p3988b05f7578-item-7a8ffdf8799d545fbae8-part-07","status":"automatic","work_id":"p3988b05f7578-text-732ba8e746ec5aea1192","title":"南郊慶成口號二十首  其七"},{"id":"p3988b05f7578-item-7a8ffdf8799d545fbae8-part-08","status":"automatic","work_id":"p3988b05f7578-text-cbc415a3b4a8879b56be","title":"南郊慶成口號二十首  其八"},{"id":"p3988b05f7578-item-7a8ffdf8799d545fbae8-part-09","status":"automatic","work_id":"p3988b05f7578-text-3ca69e726b23b4f1a609","title":"南郊慶成口號二十首  其九"}]},"p3988b05f7578-item-17a14c832cd42b76f642":{"id":"p3988b05f7578-item-17a14c832cd42b76f642","person_id":"p3988b05f7578","title":"三犯渡江云・渡江云","units":[{"id":"p3988b05f7578-item-17a14c832cd42b76f642-part-01","status":"automatic","work_id":"p3988b05f7578-text-577e76a36b955c5df016","title":"三犯渡江云・渡江云"}]},"p3988b05f7578-item-6119195642918f6051e6":{"id":"p3988b05f7578-item-6119195642918f6051e6","person_id":"p3988b05f7578","title":"","units":[]},"p3988b05f7578-item-1b6a58063806332afdc3":{"id":"p3988b05f7578-item-1b6a58063806332afdc3","person_id":"p3988b05f7578","title":"挽王茂悅提舶二首  其一 / 挽王茂悅提舶二首  其二","units":[{"id":"p3988b05f7578-item-1b6a58063806332afdc3-part-01","status":"automatic","work_id":"p3988b05f7578-text-68937350cb9feccbbfab","title":"挽王茂悅提舶二首  其一"},{"id":"p3988b05f7578-item-1b6a58063806332afdc3-part-02","status":"automatic","work_id":"p3988b05f7578-text-40068ac6411cd18b8557","title":"挽王茂悅提舶二首  其二"}]},"p3988b05f7578-item-3c69be16d610791409c4":{"id":"p3988b05f7578-item-3c69be16d610791409c4","person_id":"p3988b05f7578","title":"乳燕飞・贺新郎","units":[{"id":"p3988b05f7578-item-3c69be16d610791409c4-part-01","status":"automatic","work_id":"p3988b05f7578-text-c9726db634e7c1c4fb64","title":"乳燕飞・贺新郎"}]},"p3988b05f7578-item-3f215d793df33f3474a7":{"id":"p3988b05f7578-item-3f215d793df33f3474a7","person_id":"p3988b05f7578","title":"柳梢青 / 柳梢青","units":[{"id":"p3988b05f7578-item-3f215d793df33f3474a7-part-01","status":"automatic","work_id":"p3988b05f7578-text-f8791898d3dafc798209","title":"柳梢青"},{"id":"p3988b05f7578-item-3f215d793df33f3474a7-part-03","status":"automatic","work_id":"p3988b05f7578-text-501ec2149d72cd5ee950","title":"柳梢青"}]},"p3988b05f7578-item-9af92a5deb658a096009":{"id":"p3988b05f7578-item-9af92a5deb658a096009","person_id":"p3988b05f7578","title":"","units":[]}},"works":{"p3988b05f7578-text-98decab4528fb40d1b4f":{"id":"p3988b05f7578-text-98decab4528fb40d1b4f","person_id":"p3988b05f7578","title":"和親老蒼玉洞韻","titles":["和親老蒼玉洞韻"],"text":"去郭僅數里，巖關忽深秀。\n人工莫窺測，天巧自成就。\n瑶草覆蓬萊，箭砂藏勾漏。\n如入萬寶山，如坐羣玉囿。\n贔屭撐巨鼇，回翔舞飛鷲。\n肉醉猛虎卧，雷轟懶蛟走。\n遠絕人世塵，靜閲古今宙。\n或若赴壑蛇，或如回顧獸。\n噴者如鯨呿，𠹛者如龍吼。\n詭然足變幻，不可窮步驟。\n土清多芷蘭，石瘦少薪槱。\n松柏森古姿，寒暑不得寇。\n風靜柳新梳，雲收山免胄。\n石鏡磨古詩，玉釵瀉寒溜。\n郊原遍紅紫，川谷成錦繡。\n玄猿叫老木，石乳滴嵌竇。\n寺建開平初，亭剏宣和後。\n客屨踏花香，僧衣卧雲縐。\n碧蘿暗雨意，綠陰靚春晝。\n高吟領景趣，玩物驚節候。\n晴箔收早蠶，烟蓑正初耨。\n暇日多勝游，嘉賓從賢守。\n歌聲振林木，妝影摇漣甃遊。\n鳥啼覺山靜，湍急和雲漱。\n清譚雜觴咏，騎竹喧童幼。\n烏絲掃奇句，碧筩汲春酎。\n千里嗟漫浪，一醉成邂逅。\n莫采西山薇，莫歌南山豆。\n滿泛一盎春，持介百年壽。\n萬壑天籟清，我琴不須奏。"},"p3988b05f7578-text-fe2f3cd471d7d1e68e28":{"id":"p3988b05f7578-text-fe2f3cd471d7d1e68e28","person_id":"p3988b05f7578","title":"长亭怨慢","titles":["长亭怨慢"],"text":"记千竹、万荷深处。\n绿净池台，翠凉亭宇。\n醉墨题香，闲箫横玉尽吟趣。\n胜流星聚。\n知几诵、燕台句。\n零落碧云空，叹转眼、岁华如许。\n凝伫。\n望涓涓一水，梦到隔花窗户。\n十年旧事，尽消得、庾郎愁赋。\n燕楼鹤表半飘零，算惟有、盟鸥堪语。\n谩倚遍河桥，一片凉云吹雨。"},"p3988b05f7578-text-aebd6a97b670c89711fa":{"id":"p3988b05f7578-text-aebd6a97b670c89711fa","person_id":"p3988b05f7578","title":"仙霞嶺次徐意一參政韻","titles":["仙霞嶺次徐意一參政韻"],"text":"不知天已近，但覺衆山微。\n世道古來險，客行何日歸。\n舊游青鬢改，故國白雲飛。\n今日重登眺，悠然悟昨非。"},"p3988b05f7578-text-65d9b998a1943e592a3d":{"id":"p3988b05f7578-text-65d9b998a1943e592a3d","person_id":"p3988b05f7578","title":"拜星月慢","titles":["拜星月慢"],"text":"腻叶阴清，孤花香冷，迤逦芳洲春换。\n薄酒孤吟，怅相如游倦。\n想人在、絮幕香帘凝望，误忍几许，烟樯风幔。\n芳草天涯，负华堂双燕。\n记箫声、淡月梨花院。\n砑笺红、谩写东风怨。\n一夜落月啼鹃，唤四桥吟缆。\n荡归心、已过江南岸。\n清宵梦、远逐飞花乱。\n几千万缕垂杨，翦春愁不断。"},"p3988b05f7578-text-abb947a2c677f29b3779":{"id":"p3988b05f7578-text-abb947a2c677f29b3779","person_id":"p3988b05f7578","title":"木兰花慢","titles":["木兰花慢"],"text":"恰芳菲梦醒，漾残月、转湘帘。\n正翠崦收钟，彤墀放仗，台榭轻烟。\n东园。\n夜游乍散，听金壶、逗晓歇花签。\n宫柳微开露眼，小莺寂妒春眠。\n冰奁。\n黛浅红鲜。\n临晓鉴、竞晨妍。\n怕误却佳期，宿妆旋整，忙上雕軿。\n都缘探芳起早，看堤边、早有已开船。\n薇帐残香泪蜡，有人病酒恹恹。"},"p3988b05f7578-text-95c2eb1698f457c1e4b4":{"id":"p3988b05f7578-text-95c2eb1698f457c1e4b4","person_id":"p3988b05f7578","title":"采绿吟","titles":["采绿吟"],"text":"采绿鸳鸯浦，画舸水北云西。\n槐薰入扇，柳阴浮桨，花露侵诗。\n点尘飞不到，冰壶里、绀霞浅压玻璃。\n想明珰、凌波远，依依心事寄谁。\n移棹舣空明，苹风度、琼丝霜管清脆。\n咫尺挹幽香，怅岸隔红衣。\n对沧洲、心与鸥闲，吟情渺、莲叶共分题。\n停杯久，凉月渐生，烟合翠微。"},"p3988b05f7578-text-f13f417ef36256027c24":{"id":"p3988b05f7578-text-f13f417ef36256027c24","person_id":"p3988b05f7578","title":"大滌洞天","titles":["大滌洞天"],"text":"太虛灝氣浮空濛，烟霞九瑣蓬萊宮。\n崩騰雲木競奇險，澗芳野實紛青紅。\n何年斷鰲立天柱，古洞陰森白鴉舞。\n玉書寶劍不可尋，老蘚封崖滴玄乳。\n光芒靈氣干斗牛，遺丹葉下誰能求。\n黄精紫杞遍巖谷，玄霜夜搗聲幽幽。\n老蛟千年睡未足，癡涎吼雷噴飛瀑。\n陰風黑穴吹海腥，石虎當關橫地軸。\n是非萬古一笑嘅，神仙不死今安在。"},"p3988b05f7578-text-7d63544ecd31daf36cec":{"id":"p3988b05f7578-text-7d63544ecd31daf36cec","person_id":"p3988b05f7578","title":"秋霁","titles":["秋霁"],"text":"重到西冷，记芳园载酒，画船横笛。\n水曲芙蓉，渚边鸥鹭，依依似曾相识。\n年芳易失。\n段桥几换垂杨色。\n谩自惜。\n愁损庾郎，霜点鬓华白。\n残蛩露草，怨蝶寒花，转眼西风，又成陈迹。\n叹如今、才消量减，尊前孤负醉吟笔。\n欲寄远情秋水隔。\n旧游空在，凭高望极斜阳，乱山浮紫，暮云凝碧。"},"p3988b05f7578-text-63afb447e494439099fb":{"id":"p3988b05f7578-text-63afb447e494439099fb","person_id":"p3988b05f7578","title":"南郊慶成口號二十首  其一","titles":["南郊慶成口號二十首  其一"],"text":"親郊詔下半年前，正是咸淳第二年。\n執玉奉璋來萬國，息烽歸馬靜三邊。"},"p3988b05f7578-text-27261d38a43f75677cf1":{"id":"p3988b05f7578-text-27261d38a43f75677cf1","person_id":"p3988b05f7578","title":"南郊慶成口號二十首  其二","titles":["南郊慶成口號二十首  其二"],"text":"別殿齋居極敬嚴，外庭職祭亦精虔。\n事天以實無科擾，應辦全支內帑錢。"},"p3988b05f7578-text-4886265fb138320faef5":{"id":"p3988b05f7578-text-4886265fb138320faef5","person_id":"p3988b05f7578","title":"南郊慶成口號二十首  其三","titles":["南郊慶成口號二十首  其三"],"text":"上界鉤陳護屬車，繡衣鹵簿列旌旟。\n駕頭已近鳴鞭急，一路迎鑾奏起居。"},"p3988b05f7578-text-7722c0331fa998d3288d":{"id":"p3988b05f7578-text-7722c0331fa998d3288d","person_id":"p3988b05f7578","title":"南郊慶成口號二十首  其四","titles":["南郊慶成口號二十首  其四"],"text":"行門贊唱似吹笙，號諾連珠繞禁城。\n五使按臨嚴柝靜，夜深初聽警場聲。"},"p3988b05f7578-text-2f6058fece9468f91e80":{"id":"p3988b05f7578-text-2f6058fece9468f91e80","person_id":"p3988b05f7578","title":"南郊慶成口號二十首  其五","titles":["南郊慶成口號二十首  其五"],"text":"和氣排冬午夜春，列星呈瑞午階明。\n千官執玉蕭薌遠，靜聽登歌奏六成。"},"p3988b05f7578-text-2864bdc0ea4c1c98dfc7":{"id":"p3988b05f7578-text-2864bdc0ea4c1c98dfc7","person_id":"p3988b05f7578","title":"南郊慶成口號二十首  其六","titles":["南郊慶成口號二十首  其六"],"text":"蒼璧黄琮藉白茅，圜壇八陛際雲高。\n景光下燭天心享，萬歲三呼祝聖堯。"},"p3988b05f7578-text-732ba8e746ec5aea1192":{"id":"p3988b05f7578-text-732ba8e746ec5aea1192","person_id":"p3988b05f7578","title":"南郊慶成口號二十首  其七","titles":["南郊慶成口號二十首  其七"],"text":"瑞靄烘春夜不寒，駿奔冠珮擁回環。\n景鐘奏徹升煙起，又報端誠立賀班。"},"p3988b05f7578-text-cbc415a3b4a8879b56be":{"id":"p3988b05f7578-text-cbc415a3b4a8879b56be","person_id":"p3988b05f7578","title":"南郊慶成口號二十首  其八","titles":["南郊慶成口號二十首  其八"],"text":"黄道宮羅瑞腦香，衮龍陞降珮鏘鏘。\n大安輦奏乾安曲，萬點明星簇紫皇。"},"p3988b05f7578-text-3ca69e726b23b4f1a609":{"id":"p3988b05f7578-text-3ca69e726b23b4f1a609","person_id":"p3988b05f7578","title":"南郊慶成口號二十首  其九","titles":["南郊慶成口號二十首  其九"],"text":"一夜東風斗柄回，紫壇葱蒨若春臺。\n熙熙萬宇風光暖，盡入君王飲福杯。"},"p3988b05f7578-text-577e76a36b955c5df016":{"id":"p3988b05f7578-text-577e76a36b955c5df016","person_id":"p3988b05f7578","title":"三犯渡江云・渡江云","titles":["三犯渡江云・渡江云"],"text":"冰溪空岁晚，苍茫雁影，浅水落寒沙。\n那回乘夜兴，云雪孤舟，曾访故人家。\n千林未绿，芳信暖、玉照霜华。\n共凭高，联诗唤酒，暝色夺昏鸦。\n堪嗟。\n澌鸣玉佩，山护云衣，又扁舟东下。\n想故园、天寒倚竹，袖薄笼纱。\n诗筒已是经年别，早暖律、春动香葭。\n愁寄远，溪边自折梅花。"},"p3988b05f7578-text-68937350cb9feccbbfab":{"id":"p3988b05f7578-text-68937350cb9feccbbfab","person_id":"p3988b05f7578","title":"挽王茂悅提舶二首  其一","titles":["挽王茂悅提舶二首  其一"],"text":"清氣鍾全蜀，風流壓盛唐。\n騷香薰屈宋，筆艷映鍾王。\n麾節平生夢，人琴一旦亡。\n卜居方有賦，埋玉重堪傷。"},"p3988b05f7578-text-40068ac6411cd18b8557":{"id":"p3988b05f7578-text-40068ac6411cd18b8557","person_id":"p3988b05f7578","title":"挽王茂悅提舶二首  其二","titles":["挽王茂悅提舶二首  其二"],"text":"洛社忘年契，惟公最己知。\n誦言司馬賦，喜說項斯詩。\n問字時携酒，鉤玄共訂碑。\n豈期三日別，遽作百年悲。"},"p3988b05f7578-text-c9726db634e7c1c4fb64":{"id":"p3988b05f7578-text-c9726db634e7c1c4fb64","person_id":"p3988b05f7578","title":"乳燕飞・贺新郎","titles":["乳燕飞・贺新郎"],"text":"波影摇涟甃。\n趁熏风、一舸来时，翠阴清昼。\n去郭轩楹才数里，藓磴松关云岫。\n快屐齿、筇枝先后。\n空半危亭堪聚远，看洞庭、缥缈争奇秀。\n人自老，景如旧。\n来帆去棹还知否。\n问古今、几度斜阳，几番回首。\n晚色一川谁管领，都付雨荷烟柳。\n知我者、燕朋鸥友。\n笑拍阑干呼范蠡，甚平吴、却倩垂纶手。\n吁万古，付卮酒。"},"p3988b05f7578-text-f8791898d3dafc798209":{"id":"p3988b05f7578-text-f8791898d3dafc798209","person_id":"p3988b05f7578","title":"柳梢青","titles":["柳梢青"],"text":"约略春痕。\n吹香新句，照影清尊。\n洗尽时妆，效颦西子，不负东昏。\n金沙旧事休论。\n尽消得、东风返魂。\n一段真情，风前孤驿，雪后前村。"},"p3988b05f7578-text-501ec2149d72cd5ee950":{"id":"p3988b05f7578-text-501ec2149d72cd5ee950","person_id":"p3988b05f7578","title":"柳梢青","titles":["柳梢青"],"text":"映水穿篱。\n新霜微月，小蕊疏枝。\n几许风流，一声龙竹，半幅鹅溪。\n江头怅望多时。\n欲待折、相思寄伊。\n真色真香，丹青难写，今古无诗。"}}}
