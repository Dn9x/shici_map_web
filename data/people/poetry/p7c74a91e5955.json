_id":"p7c74a91e5955","title":"酬周開祖示長調見索詩集","units":[{"id":"p7c74a91e5955-item-43c8287931952556ccd4-part-01","status":"automatic","work_id":"p7c74a91e5955-text-97e86d0868c6840209f4","title":"酬周開祖示長調見索詩集"}]},"p7c74a91e5955-item-b6b2387af9244c41a5d3":{"id":"p7c74a91e5955-item-b6b2387af9244c41a5d3","person_id":"p7c74a91e5955","title":"","units":[]}},"works":{"p7c74a91e5955-text-32f2b52f859087049d9d":{"id":"p7c74a91e5955-text-32f2b52f859087049d9d","person_id":"p7c74a91e5955","title":"偷声木兰花","titles":["偷声木兰花"],"text":"曾居别乘康吴俗。\n民到於今歌不足。\n骊驭征鞭。\n一去东风十二年。\n重来却拥诸侯骑。\n宝带垂鱼金照地。\n和气融人。\n清霅千家日日春。"},"p7c74a91e5955-text-669c570df8a2e1559bb7":{"id":"p7c74a91e5955-text-669c570df8a2e1559bb7","person_id":"p7c74a91e5955","title":"塞垣春","titles":["塞垣春"],"text":"野树秋声满。\n对雨壁、风灯乱。\n云低翠帐，烟销素被，签动重幔。\n甚客怀、先自无消遣。\n更篱落、秋虫叹。\n叹樊川、风流减。\n旧欢难得重见。\n停酒说扬州，平山月、应照棋观。\n绿绮为谁弹，空传广陵散。\n但光纱短帽，窄袖轻衫，犹记竹西庭院。\n老鹤何时去，认琼花一面。"},"p7c74a91e5955-text-a1c527660a5122ee75af":{"id":"p7c74a91e5955-text-a1c527660a5122ee75af","person_id":"p7c74a91e5955","title":"吳江","titles":["吳江"],"text":"春後銀魚霜後鱸，遠人曾到合思吳。\n欲圖江色不上筆，靜覓鳥聲深在蘆。\n落日未昏聞市散，青天都凈見山孤。\n橋南水漲虹垂影，清夜澄光照太湖。"},"p7c74a91e5955-text-26e1c74a2a21acf3b370":{"id":"p7c74a91e5955-text-26e1c74a2a21acf3b370","person_id":"p7c74a91e5955","title":"天仙子","titles":["天仙子"],"text":"水调数声持酒听。\n午醉醒来愁未醒。\n送春春去几时回，临晚镜。\n伤流景。\n往事后期空记省。\n沙上并禽池上暝。\n云破月来花弄影。\n重重帘幕密遮灯，风不定。\n人初静。\n明日落红应满径。"},"p7c74a91e5955-text-c91dd50799cc4b81e173":{"id":"p7c74a91e5955-text-c91dd50799cc4b81e173","person_id":"p7c74a91e5955","title":"南乡子","titles":["南乡子"],"text":"何处可魂消。\n京口终朝两信潮。\n不管离心千叠恨，滔滔。\n催促行人动去桡。\n记得旧江皋。\n绿杨轻絮几条条。\n春水一篙残照阔，遥遥。\n有个多情立画桥。"},"p7c74a91e5955-text-bc76d9d6c6d438a68377":{"id":"p7c74a91e5955-text-bc76d9d6c6d438a68377","person_id":"p7c74a91e5955","title":"南乡子","titles":["南乡子"],"text":"潮上水清浑。\n棹影轻於水底云。\n去意徘徊无奈泪，衣巾。\n犹有当时粉黛痕。\n海近古城昏。\n暮角寒沙雁队分。\n今夜相思应看月，无人。\n露冷依前独掩门。"},"p7c74a91e5955-text-798f6d295c8d3f944a51":{"id":"p7c74a91e5955-text-798f6d295c8d3f944a51","person_id":"p7c74a91e5955","title":"碧牡丹","titles":["碧牡丹"],"text":"步帐摇红绮。\n晓月堕，沈烟砌。\n缓板香檀，唱彻伊家新制。\n怨入眉头，敛黛峰横翠。\n芭蕉寒，雨声碎。\n镜华翳。\n闲照孤鸾戏。\n思量去时容易。\n钿盒瑶钗，至今冷落轻弃。\n望极蓝桥，但暮云千里。\n几重山，几重水。"},"p7c74a91e5955-text-fbd14cab4d8228f08005":{"id":"p7c74a91e5955-text-fbd14cab4d8228f08005","person_id":"p7c74a91e5955","title":"木兰花・玉楼春","titles":["木兰花・玉楼春"],"text":"檀槽碎响金丝拨。\n露湿浔阳江上月。\n不知商妇为谁愁，一曲行人留晚发。\n画堂花入新声别。\n红蕊调高弹未彻。\n暗将深意语胶弦，长愿弦丝无断绝。"},"p7c74a91e5955-text-c903b86441640b99064b":{"id":"p7c74a91e5955-text-c903b86441640b99064b","person_id":"p7c74a91e5955","title":"木兰花・玉楼春","titles":["木兰花・玉楼春"],"text":"西湖杨柳风流绝。\n满缕青春看赠别。\n墙头簌簌暗飞花，山外阴阴初落月。\n秦姬秾丽云梳发。\n持酒唱歌留晚发。\n骊驹应解恼人情，欲出重城嘶不歇。"},"p7c74a91e5955-text-7acfb0ba91c303fc448f":{"id":"p7c74a91e5955-text-7acfb0ba91c303fc448f","person_id":"p7c74a91e5955","title":"更漏子","titles":["更漏子"],"text":"杜陵春，秦树晚。\n伤别更堪临远。\n南去信，欲凭谁。\n归鸿多北归。\n小桃枝，红蓓发。\n今夜昔时风月。\n休苦意，说相思。\n少情人不知。"},"p7c74a91e5955-text-7d064a2f997bb9b80e1e":{"id":"p7c74a91e5955-text-7d064a2f997bb9b80e1e","person_id":"p7c74a91e5955","title":"題西溪無相院","titles":["題西溪無相院"],"text":"積水涵虛上下清，幾家門靜巖痕平。\n浮萍破處見山影，小艇歸時聞棹聲。\n入郭僧尋塵裏去，過橋人似鑑中行。\n已憑暫雨添秋色，莫放修林礙月生。"},"p7c74a91e5955-text-b29dd8b03c1653152b5d":{"id":"p7c74a91e5955-text-b29dd8b03c1653152b5d","person_id":"p7c74a91e5955","title":"苏幕遮","titles":["苏幕遮"],"text":"柳飞绵，花实少。\n镂板音清，浅发江南调。\n斜日两竿留碧□。\n马足重重，又近青门道。\n去尘浓，人散了。\n回首旗亭，渐渐红裳小。\n莫讶安仁头白早。\n天若有情，天也终须老。"},"p7c74a91e5955-text-0e88dce626c4083700db":{"id":"p7c74a91e5955-text-0e88dce626c4083700db","person_id":"p7c74a91e5955","title":"飛石巖","titles":["飛石巖"],"text":"石破重巖萬客疑，不堪攻玉不支機。\n長江風雨來無定，時學零陵燕子飛。"},"p7c74a91e5955-text-4aaa81bd0d451b649904":{"id":"p7c74a91e5955-text-4aaa81bd0d451b649904","person_id":"p7c74a91e5955","title":"飛仙嶺","titles":["飛仙嶺"],"text":"路接曉天人近月，真仙去後只雲歸。\n嶺頭舊曰上昇日，空有山禽自在飛。"},"p7c74a91e5955-text-6b0fa5f735221856d45b":{"id":"p7c74a91e5955-text-6b0fa5f735221856d45b","person_id":"p7c74a91e5955","title":"漫天嶺","titles":["漫天嶺"],"text":"不獨高明不可謾，仍知不似泰山安。\n五丁破道秦通蜀，卻被行人脚下看。"},"p7c74a91e5955-text-d53b91f55717fa27e3de":{"id":"p7c74a91e5955-text-d53b91f55717fa27e3de","person_id":"p7c74a91e5955","title":"將赴南平宿龍門洞","titles":["將赴南平宿龍門洞"],"text":"此心常欲老林丘，去意徘徊夜更留。\n萬客只貪門外過，少人知有洞中遊。\n春來猶見龍孫出，靜裏微聞石乳流。\n澗水送花通閣底，寺鐘催月落巖頭。\n暫時清夢生危枕，明日濃塵擁敝輈。\n南是符陽北長舉，所嗟不屬古江州。"},"p7c74a91e5955-text-7cf375e33aef69a9a825":{"id":"p7c74a91e5955-text-7cf375e33aef69a9a825","person_id":"p7c74a91e5955","title":"南歌子","titles":["南歌子"],"text":"残照催行棹，乘春拂去衣。\n海棠花下醉芳菲。\n无计少留君住、泪双垂。\n烟染春江暮，云藏阁道危。\n行行听取杜鹃啼。\n是妾此时离恨、尽呼伊。"},"p7c74a91e5955-text-971cf24c2e710e6cd44c":{"id":"p7c74a91e5955-text-971cf24c2e710e6cd44c","person_id":"p7c74a91e5955","title":"少年游","titles":["少年游"],"text":"听歌持酒且休行。\n云树几程程。\n眼看檐牙，手搓花蕊，未必两无情。\n拓夫滩上闻新雁，离袖掩盈盈。\n此恨无穷，远如江水，东去几时平。"},"p7c74a91e5955-text-dcfccf1a0f695d948876":{"id":"p7c74a91e5955-text-dcfccf1a0f695d948876","person_id":"p7c74a91e5955","title":"渔家傲","titles":["渔家傲"],"text":"巴子城头青草暮。\n巴山重叠相逢处。\n燕子占巢花脱树。\n杯且举。\n瞿塘水阔舟难渡。\n天外吴门清霅路。\n君家正在吴门住。\n赠我柳枝情几许。\n春满缕。\n为君将入江南去。"},"p7c74a91e5955-text-58437ec85e2d02cf913d":{"id":"p7c74a91e5955-text-58437ec85e2d02cf913d","person_id":"p7c74a91e5955","title":"木兰花・玉楼春","titles":["木兰花・玉楼春"],"text":"相离徒有相逢梦。\n门外马蹄尘已动。\n怨歌留待醉时听，远目不堪空际送。\n今宵风月知谁共。\n声咽琵琶槽上凤。\n人生无物比多情，江水不深山不重。"},"p7c74a91e5955-text-330568ca968cd35a75be":{"id":"p7c74a91e5955-text-330568ca968cd35a75be","person_id":"p7c74a91e5955","title":"冬日郡齋書事","titles":["冬日郡齋書事"],"text":"鈴索聲閑按牒稀，怯寒肌骨望春暉。\n凝雲垂地雪欲下，高樹無風葉自飛。\n水落淺沙魚隊聚，草枯幽隴鹿羣歸。\n安人不信彤襜貴，上相還家是錦衣。"},"p7c74a91e5955-text-9126ec6c6e5b15433a9f":{"id":"p7c74a91e5955-text-9126ec6c6e5b15433a9f","person_id":"p7c74a91e5955","title":"酬發運馬子山少卿惠與詩","titles":["酬發運馬子山少卿惠與詩"],"text":"貢餘應惜點爲山，絕唱兼遺致政官。\n嵰地雪甜多不識，吳人未食齒先寒。"},"p7c74a91e5955-text-3f2ad915c9d7f5f50114":{"id":"p7c74a91e5955-text-3f2ad915c9d7f5f50114","person_id":"p7c74a91e5955","title":"子山再惠詩見和因又續成子山不以予不才兩發章薦","titles":["子山再惠詩見和因又續成子山不以予不才兩發章薦"],"text":"清卿恩德重鼇山，詩寄閑棲白首官。\n須信夜光誰可得，玉龍沉睡玉淵寒。"},"p7c74a91e5955-text-52054b558810b7103b24":{"id":"p7c74a91e5955-text-52054b558810b7103b24","person_id":"p7c74a91e5955","title":"和元居中風水洞上祖龍圖韻","titles":["和元居中風水洞上祖龍圖韻"],"text":"水色風光近使君，浥塵輕雨逐車輪。\n暫來不宿宜無恨，多少行春不到人。"},"p7c74a91e5955-text-f259617b8b24e3cf2ae5":{"id":"p7c74a91e5955-text-f259617b8b24e3cf2ae5","person_id":"p7c74a91e5955","title":"次韻蔡君謨侍郎寒食西湖","titles":["次韻蔡君謨侍郎寒食西湖"],"text":"飛飛畫檝繞花洲，霽雨浮花出岸流。\n誰廣金明爲水戰，自來銀漢有霓舟。\n行從使節春尤盛，住買吳山老未由。\n人遲歸軒香接路，一分新月管絃樓。"},"p7c74a91e5955-text-fb3b5b2e06d6d122824c":{"id":"p7c74a91e5955-text-fb3b5b2e06d6d122824c","person_id":"p7c74a91e5955","title":"次韻清明日西湖","titles":["次韻清明日西湖"],"text":"新火飛煙上柳梢，天供好景助詩豪。\n江湖一處逢嘉月，溟海同時得巨鼇。\n白水更隨春雨長，青雲不及畫樓高。\n千橈插羽鼙聲動，十里驚雷奪暮濤。"},"p7c74a91e5955-text-e1a1de5fb1c18647531c":{"id":"p7c74a91e5955-text-e1a1de5fb1c18647531c","person_id":"p7c74a91e5955","title":"九月望日同君謨侍郎泛西湖夜飲","titles":["九月望日同君謨侍郎泛西湖夜飲"],"text":"清歌曲曲酒巡巡，一舉金蕉五十分。\n山影與天都在水，風光爲月不留雲。\n節回路口千門待，樂過湖心四岸聞。\n莫笑閑官奉歡席，自來蒿艾近蘭薰。"},"p7c74a91e5955-text-be73318133b6e483f41d":{"id":"p7c74a91e5955-text-be73318133b6e483f41d","person_id":"p7c74a91e5955","title":"好事近","titles":["好事近"],"text":"月色透横枝，短叶小花无力。\n北客一声长笛，怨江南先得。\n谁教强半腊前开，多情为春忆。\n留取大家沈醉，正雨休风息。"},"p7c74a91e5955-text-d0b32ffae2c52dfe0fa5":{"id":"p7c74a91e5955-text-d0b32ffae2c52dfe0fa5","person_id":"p7c74a91e5955","title":"破阵乐","titles":["破阵乐"],"text":"四堂互映，双门并丽，龙阁开府。\n郡美东南第一，望故苑、楼台霏雾。\n垂柳池塘，流泉巷陌，吴歌处处。\n近黄昏，渐更宜良夜，簇簇繁星灯烛，长衢如昼，暝色韶光，几许粉面，飞甍朱户。\n和煦。\n雁齿桥红，裙腰草绿，云际寺、林下路。\n酒熟梨花宾客醉，但觉满山潇鼓。\n尽朋游、同民乐，芳菲有主。\n自此归从泥诏，去指沙堤，南屏水石，西湖风月，好作千骑行春，画图写取。"},"p7c74a91e5955-text-d0c33bf7c6d88ade2cda":{"id":"p7c74a91e5955-text-d0c33bf7c6d88ade2cda","person_id":"p7c74a91e5955","title":"醉垂鞭","titles":["醉垂鞭"],"text":"酒面滟金鱼。\n吴娃唱。\n吴潮上。\n玉殿白麻书。\n待君归后除。\n勾留风月好。\n平湖晓。\n翠峰孤。\n此景出关无。\n西州空画图。"},"p7c74a91e5955-text-d1f130bcdcb55bfe4cc2":{"id":"p7c74a91e5955-text-d1f130bcdcb55bfe4cc2","person_id":"p7c74a91e5955","title":"好事近","titles":["好事近"],"text":"灯烛上山堂，香雾暖生寒夕。\n前夜雪清梅瘦，已不禁轻摘。\n双歌声断宝杯空，妆光艳瑶席。\n相趁笑声归去，有随人月色。"},"p7c74a91e5955-text-203b0a07ac1aa93ef966":{"id":"p7c74a91e5955-text-203b0a07ac1aa93ef966","person_id":"p7c74a91e5955","title":"天仙子","titles":["天仙子"],"text":"持节来时初有雁。\n十万人家春已满。\n龙标名第凤池身，堂阜远。\n江桥晚。\n一见湖山看未遍。\n障扇欲收歌泪溅。\n亭下花空罗绮散。\n樯竿渐向望中疏，旗影转。\n鼙声断。\n惆怅不如船尾燕。"},"p7c74a91e5955-text-9982499c8dc533600e46":{"id":"p7c74a91e5955-text-9982499c8dc533600e46","person_id":"p7c74a91e5955","title":"武陵春","titles":["武陵春"],"text":"每见韶娘梳鬓好，钗燕傍云飞。\n谁掬彤霞露染衣。\n□玉透柔肌。\n梅花瘦雪梨花雨，心眼未芳菲。\n看著娇妆听柳枝。\n人意觉春归。"},"p7c74a91e5955-text-1673631b92958a91729e":{"id":"p7c74a91e5955-text-1673631b92958a91729e","person_id":"p7c74a91e5955","title":"虞美人","titles":["虞美人"],"text":"恩如明月家家到。\n无处无清照。\n一帆秋色共云遥。\n眼力不知人远、上江桥。\n愿君书札来双鲤。\n古汴东流水。\n宋王台畔楚宫西。\n正是节趣归路、近沙堤。"},"p7c74a91e5955-text-615bda14067f94fa1f51":{"id":"p7c74a91e5955-text-615bda14067f94fa1f51","person_id":"p7c74a91e5955","title":"芳草渡・系裙腰","titles":["芳草渡・系裙腰"],"text":"双门晓锁响朱扉。\n千骑拥、万人随。\n风乌弄影画船移。\n歌时泪，和别怨，作秋悲。\n寒潮小，渡淮迟。\n吴越路、渐天涯。\n宋王台上为相思。\n江云下，日西尽，雁南飞。"},"p7c74a91e5955-text-43d1a16c679829500e16":{"id":"p7c74a91e5955-text-43d1a16c679829500e16","person_id":"p7c74a91e5955","title":"熙州慢","titles":["熙州慢"],"text":"武林乡，占第一湖山，咏画争巧。\n鹫石飞来，倚翠楼烟霭，清猿啼晓。\n况值禁垣师帅，惠政流入欢谣。\n朝暮万景，寒潮弄月，乱峰回照。\n天使寻春不早。\n并行乐，免有花愁花笑。\n持酒更听，红儿肉声长调。\n潇湘故人未归，但目送游云孤鸟。\n际天杪。\n离情尽寄芳草。"},"p7c74a91e5955-text-6625dea538bad5a62cb3":{"id":"p7c74a91e5955-text-6625dea538bad5a62cb3","person_id":"p7c74a91e5955","title":"河满子","titles":["河满子"],"text":"溪女送花随处，沙鸥避乐分行。\n游舸已如图障里，小屏犹画潇湘。\n人面新生酒艳，日痕更欲春长。\n衣上交枝斗色，钗头比翼相双。\n片段落霞明水底，风纹时动妆光。\n宾从夜归无月，千灯万火河塘。"},"p7c74a91e5955-text-e1084964573292457bce":{"id":"p7c74a91e5955-text-e1084964573292457bce","person_id":"p7c74a91e5955","title":"沁园春","titles":["沁园春"],"text":"心膂良臣，帷幄元勋，左右万几。\n暂武林分阃，东南外翰，锦衣乡社，未满瓜时。\n易镇梧台，宣条期岁，又西指夷桥千骑移。\n珠滩上，喜甘棠翠荫，依旧春晖。\n须知。\n系国安危。\n料节召、还趋浴凤池。\n且代工施化，持钧播泽，置盂天下，此外何思。\n素卷书名，赤松游道，飙驭云軿仙可期。\n湖山美，有啼猿唳鹤，相望东归。"},"p7c74a91e5955-text-ba3acd04e305bff0c941":{"id":"p7c74a91e5955-text-ba3acd04e305bff0c941","person_id":"p7c74a91e5955","title":"劝金船","titles":["劝金船"],"text":"流泉宛转双开窦。\n带染轻纱皱。\n何人暗得金船酒。\n拥罗绮前后。\n绿定见花影，并照与、艳妆争秀。\n行尽曲名，休更再歌杨柳。\n光生飞动摇琼甃。\n隔障笙箫奏。\n须知短景欢无足，又还过清昼。\n翰阁迟归来，传骑恨、留住难久。\n异日凤凰池上，为谁思旧。"},"p7c74a91e5955-text-7af3952e6f8ae3097f3b":{"id":"p7c74a91e5955-text-7af3952e6f8ae3097f3b","person_id":"p7c74a91e5955","title":"定风波令・定风波","titles":["定风波令・定风波"],"text":"谈辨才疏堂上兵。\n画船齐岸暗潮平。\n万乘靴袍曾好问。\n须信。\n文章传口齿牙清。\n三百寺应游未遍。\n□算。\n湖山风物岂无情。\n不独渠丘歌叔度。\n行路。\n吴谣终日有馀声。"},"p7c74a91e5955-text-42d2cc5b2f09a8faa05f":{"id":"p7c74a91e5955-text-42d2cc5b2f09a8faa05f","person_id":"p7c74a91e5955","title":"醉眠亭","titles":["醉眠亭"],"text":"醉翁家有醉眠亭，爲愛江堤亂草春。\n不聽耳邊啼鳥喚，任教風外雜花零。\n欲酣未必過此舍，樂甚應宜造大庭。\n五柳北窗知此趣，三閭南儗漫孤醒。"},"p7c74a91e5955-text-e8f21d848518115ee454":{"id":"p7c74a91e5955-text-e8f21d848518115ee454","person_id":"p7c74a91e5955","title":"泛清苕","titles":["泛清苕"],"text":"绿净无痕，过晓霁清苕，镜里游人。\n红柱巧，彩船稳，当筵主、秘馆词臣。\n吴娃劝饮韩娥唱，竞艳容、左右皆春。\n学为行雨，傍画桨，从教水溅罗裙。\n溪烟混月黄昏。\n渐楼台上下，火影星分。\n飞槛倚，斗牛近，响箫鼓、远破重云。\n归轩未至千家待，掩半妆、翠箔朱门。\n衣香拂面，扶醉卸簪花，满袖馀煴。"},"p7c74a91e5955-text-a96f1cff56dbe09eea63":{"id":"p7c74a91e5955-text-a96f1cff56dbe09eea63","person_id":"p7c74a91e5955","title":"木兰花・玉楼春","titles":["木兰花・玉楼春"],"text":"龙头舴艋吴儿竞。\n笋柱秋千游女并。\n芳洲拾翠暮忘归，秀野踏青来不定。\n行云去后遥山暝。\n已放笙歌池院静。\n中庭月色正清明，无数杨花过无影。"},"p7c74a91e5955-text-aa35b83ba97d16da463f":{"id":"p7c74a91e5955-text-aa35b83ba97d16da463f","person_id":"p7c74a91e5955","title":"天仙子","titles":["天仙子"],"text":"坐治吴州成乐土。\n诏卷风飞来圣语。\n亲舆乞得便藩归，瑶席主。\n杯休数。\n清夜为君歌白苎。\n花接旧枝新蕊吐。\n造化不知人有助。\n看花岁岁比甘棠，嘉月暮。\n东门路。\n只恐带将春色去。"},"p7c74a91e5955-text-6dd4216b24b6de85a199":{"id":"p7c74a91e5955-text-6dd4216b24b6de85a199","person_id":"p7c74a91e5955","title":"韻和上先頓首","titles":["韻和上先頓首"],"text":"池上飛橋亭外山，野禽偷靜上鈎欄。\n晚花露重香偏細，春女衣輕體尚寒。\n曲水略殊今日事，南湖曾奉昔人歡。\n郡圖可許增新致，幾處模傳畫樣看。"},"p7c74a91e5955-text-97e86d0868c6840209f4":{"id":"p7c74a91e5955-text-97e86d0868c6840209f4","person_id":"p7c74a91e5955","title":"酬周開祖示長調見索詩集","titles":["酬周開祖示長調見索詩集"],"text":"辯玉當看破石詩，泥沙有寶即山輝。\n都廛往往無真璞，誤使人評鼠臘歸。"}}}
