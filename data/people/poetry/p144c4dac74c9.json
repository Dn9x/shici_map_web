title":"","units":[]},"p144c4dac74c9-item-a23d1b6295019aecb4b9":{"id":"p144c4dac74c9-item-a23d1b6295019aecb4b9","person_id":"p144c4dac74c9","title":"永遇乐","units":[{"id":"p144c4dac74c9-item-a23d1b6295019aecb4b9-part-01","status":"automatic","work_id":"p144c4dac74c9-text-3f4cc6bc2f870ea935fd","title":"永遇乐"}]},"p144c4dac74c9-item-5b07d4e96ffcd7fb2555":{"id":"p144c4dac74c9-item-5b07d4e96ffcd7fb2555","person_id":"p144c4dac74c9","title":"兰陵王","units":[{"id":"p144c4dac74c9-item-5b07d4e96ffcd7fb2555-part-01","status":"automatic","work_id":"p144c4dac74c9-text-a6dbfbd084b5701540aa","title":"兰陵王"}]},"p144c4dac74c9-item-0768241d3fed559b6aa9":{"id":"p144c4dac74c9-item-0768241d3fed559b6aa9","person_id":"p144c4dac74c9","title":"菩萨蛮","units":[{"id":"p144c4dac74c9-item-0768241d3fed559b6aa9-part-01","status":"automatic","work_id":"p144c4dac74c9-text-185ec7f94fa016509ec6","title":"菩萨蛮"}]},"p144c4dac74c9-item-fb7ae2d223a24c8bb944":{"id":"p144c4dac74c9-item-fb7ae2d223a24c8bb944","person_id":"p144c4dac74c9","title":"壽城山六十五","units":[{"id":"p144c4dac74c9-item-fb7ae2d223a24c8bb944-part-01","status":"automatic","work_id":"p144c4dac74c9-text-da1e57f94e1a4bc2fd96","title":"壽城山六十五"}]},"p144c4dac74c9-item-190f0a7d0489ca2b98f1":{"id":"p144c4dac74c9-item-190f0a7d0489ca2b98f1","person_id":"p144c4dac74c9","title":"","units":[]},"p144c4dac74c9-item-2807b4cbcfdd125bec44":{"id":"p144c4dac74c9-item-2807b4cbcfdd125bec44","person_id":"p144c4dac74c9","title":"永遇乐","units":[{"id":"p144c4dac74c9-item-2807b4cbcfdd125bec44-part-01","status":"automatic","work_id":"p144c4dac74c9-text-06bc0d261bc49aad1181","title":"永遇乐"}]},"p144c4dac74c9-item-af6eb05a04cdf7f9d051":{"id":"p144c4dac74c9-item-af6eb05a04cdf7f9d051","person_id":"p144c4dac74c9","title":"","units":[]},"p144c4dac74c9-item-51431d5c7c7fefe99b30":{"id":"p144c4dac74c9-item-51431d5c7c7fefe99b30","person_id":"p144c4dac74c9","title":"望江南・忆江南","units":[{"id":"p144c4dac74c9-item-51431d5c7c7fefe99b30-part-01","status":"automatic","work_id":"p144c4dac74c9-text-cc2c4a287406890f70e9","title":"望江南・忆江南"}]},"p144c4dac74c9-item-befd31358809625081ae":{"id":"p144c4dac74c9-item-befd31358809625081ae","person_id":"p144c4dac74c9","title":"","units":[]},"p144c4dac74c9-item-f4010fe599e5e451c2c6":{"id":"p144c4dac74c9-item-f4010fe599e5e451c2c6","person_id":"p144c4dac74c9","title":"水调歌头","units":[{"id":"p144c4dac74c9-item-f4010fe599e5e451c2c6-part-01","status":"automatic","work_id":"p144c4dac74c9-text-af4a5115027eb7360718","title":"水调歌头"}]},"p144c4dac74c9-item-ea3143bac97dd0e18a3e":{"id":"p144c4dac74c9-item-ea3143bac97dd0e18a3e","person_id":"p144c4dac74c9","title":"","units":[]},"p144c4dac74c9-item-0d1f902e4fe462c59fba":{"id":"p144c4dac74c9-item-0d1f902e4fe462c59fba","person_id":"p144c4dac74c9","title":"","units":[]}},"works":{"p144c4dac74c9-text-1bd3176fdb7270fafce9":{"id":"p144c4dac74c9-text-1bd3176fdb7270fafce9","person_id":"p144c4dac74c9","title":"虞美人","titles":["虞美人"],"text":"黄帘绿幕窗垂雾。\n表立如承露。\n夕郎偷看御街灯。\n归奔河边残点、乱如星。\n开园蒋李游春雨。\n蛱蝶穿人舞。\n如今烟草锁春晴。\n并与苏堤葛岭、不堪行。"},"p144c4dac74c9-text-77a47e3bf3da404275f9":{"id":"p144c4dac74c9-text-77a47e3bf3da404275f9","person_id":"p144c4dac74c9","title":"摸鱼儿","titles":["摸鱼儿"],"text":"三百年、人间天上，遽如许、遽如许。\n落花寒食东风雨，漠漠长陵抔土。\n魂归否。\n怕些不分明，又堕人笺疏。\n且无相负。\n记昔与诸贤，共谈洛下，曾识老人父。\n牛衣泪，冷落闻鸡东府。\n风尘曾独深虑。\n子规声断长门晓，春梦不堪重做。\n千万古。\n但目极心伤，宛转虞兮楚。\n江东日暮。\n想野草荒田，而今何处，不待雍门鼓。"},"p144c4dac74c9-text-4b9627640cecf6e5c4a9":{"id":"p144c4dac74c9-text-4b9627640cecf6e5c4a9","person_id":"p144c4dac74c9","title":"摸鱼儿","titles":["摸鱼儿"],"text":"是他家、绛唇翠袖，可容卿有功否。\n相思不到胭脂井，只隔东林烟柳。\n春去又。\n漫一夜东风，吹得花成旧。\n无人举酒。\n但照影堤流，图他红泪，飘洒到襟袖。\n人间事，大半归谋诸妇。\n不如意十八九。\n敲门夜半窥园李，赤脚玉川惊走。\n何处有。\n更炙烛风流，看到人归后。\n休休回首。\n笑旧日园林，佺巢蜀锦，处处可携手。"},"p144c4dac74c9-text-47bebb28eaeca5b58276":{"id":"p144c4dac74c9-text-47bebb28eaeca5b58276","person_id":"p144c4dac74c9","title":"摸鱼儿","titles":["摸鱼儿"],"text":"正何须、阳关肠断，吴姬苦劝人酒。\n中年怀抱萦萦处，看取伴烟和柳。\n柳摇首。\n笑飞到家山，已是酴醿后。\n留连话旧。\n问溪上儿童，颇曾见我，有此故人否。\n相逢地，还忆今宵三韭。\n青山知了迎候。\n东风自送归帆去，吹得乱红沾袖。\n暮云皱。\n听杜宇高高，啼向无何有。\n江花垂手。\n任春色重来，江花更好，难可少年又。"},"p144c4dac74c9-text-9dfe58a1b33a208ac7d2":{"id":"p144c4dac74c9-text-9dfe58a1b33a208ac7d2","person_id":"p144c4dac74c9","title":"摸鱼儿","titles":["摸鱼儿"],"text":"待欲□、家山未得，方知名不如酒。\n丹砂便做金句漏，难遣鬓青似柳。\n试搔首。\n记移竹南塘，又是三年后。\n情怀非旧。\n叹少日相如，垆边老去，能赋上林否。\n种兰处，赢得青青种韭。\n渊明中路相候。\n何须更待三三径，也自长拖衫袖。\n青袍皱。\n便持当金貂，赊取邻家有。\n小儿拍手。\n笑昨醉如泥，盟言止酒，何事醒来又。"},"p144c4dac74c9-text-1bd12d628d164cf20340":{"id":"p144c4dac74c9-text-1bd12d628d164cf20340","person_id":"p144c4dac74c9","title":"摸鱼儿","titles":["摸鱼儿"],"text":"醉与君、狂歌又笑，不知当日何调。\n孤山梅下吟魂冷，说甚那时苏小。\n沧波眇。\n奈此岛，累累竟是谁家表。\n归欤白鸟。\n看四圣飘香，朱门金榜，化作竺飞峤。\n衰也久，旧游梦翠禽绕。\n坱兮轧、皎兮窈。\n相思一夜窗前白，谁识余怀渺渺。\n残年了。\n听画角，悲凉又是霜天晓。\n馀音杳缈。\n叹五十之年，我加八九，君隔几科诏。"},"p144c4dac74c9-text-df420fe5b229215ed0b7":{"id":"p144c4dac74c9-text-df420fe5b229215ed0b7","person_id":"p144c4dac74c9","title":"水调歌头","titles":["水调歌头"],"text":"两声深院里，歌扇小楼中。\n当时飞燕马上，妖艳为谁容。\n娇颤须扶未稳，腰袅轻笼小驻，玉女最愁峰。\n掠鬓过车骤，回首意冲冲。\n宝钗斜，云鬓乱，几曾逢。\n谁知去三步远，此痛与君同。\n玉箸残妆谁见，獭髓轻痕妙补，粉黛不须浓。\n重见为低诉，馀恨更匆匆。"},"p144c4dac74c9-text-7db835c1ffa431e85eb7":{"id":"p144c4dac74c9-text-7db835c1ffa431e85eb7","person_id":"p144c4dac74c9","title":"声声慢","titles":["声声慢"],"text":"西风坠绿。\n唤起春娇，嫣然困倚修竹。\n落帽人来，花艳乍惊郎目。\n相思尚带旧子，甚凄凉、未忺妆束。\n吟鬓底，伴寒香一朵，并簪黄菊。\n却待金盘华屋。\n园林静、多情怎禁幽独。\n蛱蝶应愁，明日落红难触。\n那堪雁霜渐重，怕黄昏、欲睡未足。\n翠袖冷，且莫辞、花下秉烛。"},"p144c4dac74c9-text-e4f8bae91eb031de40fb":{"id":"p144c4dac74c9-text-e4f8bae91eb031de40fb","person_id":"p144c4dac74c9","title":"木兰花慢","titles":["木兰花慢"],"text":"自崆峒麦熟，耕犊满、桔槔闲。\n笑吾党清谈，长衣櫑具，更进贤冠。\n仓皇庇公宇下，便秋风、江上不惊寒。\n雪夜入三城易，槐阴护一家难。\n东山。\n零雨几时还。\n领客竹林间。\n看满座空尊，轻裘缓带，绿鬓朱颜。\n风流一笑余事，定碑金、无恙庾家完。\n又赋南烹初食，明朝餐玉何山。"},"p144c4dac74c9-text-4cedc4c0d43e0bb7fe53":{"id":"p144c4dac74c9-text-4cedc4c0d43e0bb7fe53","person_id":"p144c4dac74c9","title":"菩萨蛮","titles":["菩萨蛮"],"text":"黄鸡喔喔催人起。\n困不成眠窗似水。\n清露不曾寒。\n朝来起自难。\n家人当睡美。\n又忆归程几。\n不管湿阑干。\n芙蓉花自看。"},"p144c4dac74c9-text-dddbac8f945f41909eeb":{"id":"p144c4dac74c9-text-dddbac8f945f41909eeb","person_id":"p144c4dac74c9","title":"减字木兰花","titles":["减字木兰花"],"text":"无灯可看。\n雨水从教正月半。\n探茧推盘。\n探得千秋字字看。\n铜驼故老。\n说著宣和似天宝。\n五百年前。\n曾向杭州看上元。"},"p144c4dac74c9-text-c3eb4992a90ab17328ad":{"id":"p144c4dac74c9-text-c3eb4992a90ab17328ad","person_id":"p144c4dac74c9","title":"六州歌头","titles":["六州歌头"],"text":"向来人道，真个胜周公。\n燕然眇。\n浯溪小。\n万世功。\n再建隆。\n十五年宇宙，宫中膺。\n堂中伴。\n翻虎鼠，搏鸇雀，覆蛇龙。\n鹤发庞眉，憔悴空山久，来上东封。\n便一朝符瑞，四十万人同。\n说甚东风。\n怕西风。\n甚边尘起，渔阳惨。\n霓裳断。\n广寒宫。\n青楼杳。\n朱门悄。\n镜湖空。\n里湖通。\n大纛高牙去，人不见，港重重。\n斜阳外，芳草碧，落花红。\n抛尽黄金无计，方知道、前此和戎。\n但千年传说，夜半一声铜。\n何面江东。"},"p144c4dac74c9-text-e211bd4f0bb9e73499c5":{"id":"p144c4dac74c9-text-e211bd4f0bb9e73499c5","person_id":"p144c4dac74c9","title":"浣溪沙","titles":["浣溪沙"],"text":"春日春风掠鬓须。\n乱山相对拥寒炉。\n彩鞭金胜一时无。\n自缕青丝成细柳，更堆残雪当凝酥。\n儿童且莫唱皇都。"},"p144c4dac74c9-text-acdc2d7d16804aa07992":{"id":"p144c4dac74c9-text-acdc2d7d16804aa07992","person_id":"p144c4dac74c9","title":"兰陵王","titles":["兰陵王"],"text":"送春去。\n春去人间无路。\n秋千外、芳草连天，谁遣风沙暗南浦。\n依依甚意绪。\n漫忆海门飞絮。\n乱鸦过，斗转城荒，不见来时试灯处。\n春去。\n最谁苦。\n但箭雁沉边，梁燕无主。\n杜鹃声里长门暮。\n想玉树凋土，泪盘如露。\n咸阳送客屡回顾。\n斜日未能度。\n春去。\n尚来否。\n正江令恨别，庾信愁赋。\n苏堤尽日风和雨。\n叹神游故国，花记前度。\n人生流落，顾孺子，共夜雨。"},"p144c4dac74c9-text-f46ee100261de09f7fad":{"id":"p144c4dac74c9-text-f46ee100261de09f7fad","person_id":"p144c4dac74c9","title":"唐多令","titles":["唐多令"],"text":"寒雁下荒洲。\n寒声带影流。\n便寄书、不到红楼。\n如此月明如此酒，无一事、但悲秋。\n万弩落潮头。\n灵胥还怒不。\n满湖山、犹是春愁。\n欲向涌金门外去，烟共草、不堪游。"},"p144c4dac74c9-text-35339ce9d46443459fb8":{"id":"p144c4dac74c9-text-35339ce9d46443459fb8","person_id":"p144c4dac74c9","title":"唐多令","titles":["唐多令"],"text":"风露小瀛洲。\n斜河倒海流。\n人间尘、不到琼楼。\n错向五陵陵上望，几回月、几回秋。\n落日太湖头。\n垂虹今是不。\n醉尊前、往往成愁。\n便有扁舟西子在，无汗漫、与君游。"},"p144c4dac74c9-text-4e12f0a0cee415ed37d5":{"id":"p144c4dac74c9-text-4e12f0a0cee415ed37d5","person_id":"p144c4dac74c9","title":"唐多令","titles":["唐多令"],"text":"日落紫霞洲。\n兰舟稳放流。\n玉虹仙、如在黄楼。\n何必锦袍吹玉笛，听欸乃、数声秋。\n赤壁舞涛头。\n周郎还到不。\n倚西风、袅袅余愁。\n唤起横江飞道士，来伴我、月中游。"},"p144c4dac74c9-text-28fab1fe63643e6c4685":{"id":"p144c4dac74c9-text-28fab1fe63643e6c4685","person_id":"p144c4dac74c9","title":"唐多令","titles":["唐多令"],"text":"零露下长洲。\n云翻海倒流。\n素娥深、不到西楼。\n忽觉断潮归去也，饮不尽、一轮秋。\n城外土馒头。\n人能饮恨不。\n古人不见使吾愁，莫有横江孤鹤过，来伴我、醉中游。"},"p144c4dac74c9-text-4f0217f147bffe610a48":{"id":"p144c4dac74c9-text-4f0217f147bffe610a48","person_id":"p144c4dac74c9","title":"唐多令","titles":["唐多令"],"text":"残日下瓜洲。\n平安火又流。\n月高高、挂古城楼。\n回首少年真可笑，无一事、又悲秋。\n天在海边头。\n天风有意不。\n结桂枝、袅袅余愁。\n不是银河无去路，先不去、后难游。"},"p144c4dac74c9-text-42da31673a7aac5828cd":{"id":"p144c4dac74c9-text-42da31673a7aac5828cd","person_id":"p144c4dac74c9","title":"烛影摇红","titles":["烛影摇红"],"text":"明月如冰，乱云飞下斜河去。\n旋呼艇子载箫声，风景还如故。\n袅袅余怀何许。\n听尊前、呜呜似诉。\n近年潮信，万里阴晴，和天无据。\n有客秋风，去时留下金盘露。\n少年终夜奏胡笳，谁料归无路。\n同是江南倦旅。\n封婵娟、君歌我舞。\n醉中休问，明月明年，人在何处。"},"p144c4dac74c9-text-3f4cc6bc2f870ea935fd":{"id":"p144c4dac74c9-text-3f4cc6bc2f870ea935fd","person_id":"p144c4dac74c9","title":"永遇乐","titles":["永遇乐"],"text":"璧月初晴，黛云远澹，春事谁主。\n禁苑娇寒，湖堤倦暖，前度遽如许。\n香尘暗陌，华灯明昼，长是懒携手去。\n谁知道，断烟禁夜，满城似愁风雨。\n宣和旧日，临安南渡，芳景犹自如故。\n缃帙流离，风鬟三五，能赋词最苦。\n江南无路，鄜州今夜，此苦又谁知否。\n空相对，残釭无寐，满村社鼓。"},"p144c4dac74c9-text-a6dbfbd084b5701540aa":{"id":"p144c4dac74c9-text-a6dbfbd084b5701540aa","person_id":"p144c4dac74c9","title":"兰陵王","titles":["兰陵王"],"text":"雁归北。\n渺渺茫茫似客。\n春湖里，曾见去帆，谁遣江头絮风息。\n千年记当日。\n难得。\n宽闲抱膝。\n兴亡事，马上飞花，看取残阳照亭驿。\n哀拍。\n愿归骨。\n怅毡帐何匹，湩酪何食。\n相思青冢头应白。\n想荒坟酹酒，过车回首，香魂携手抱相泣。\n但青草无色。\n语绝。\n更愁极。\n漫一番青青，一番陈迹。\n瑶池黄竹哀离席。\n约八骏犹到，露桃重摘。\n金铜知道，忍去国，忍去国。"},"p144c4dac74c9-text-185ec7f94fa016509ec6":{"id":"p144c4dac74c9-text-185ec7f94fa016509ec6","person_id":"p144c4dac74c9","title":"菩萨蛮","titles":["菩萨蛮"],"text":"殷勤欲送春归去。\n白首题将断肠句。\n春去自依依。\n欲归无处归。\n天涯同是寓。\n握手留春住。\n小住碧桃枝。\n桃根不属谁。"},"p144c4dac74c9-text-da1e57f94e1a4bc2fd96":{"id":"p144c4dac74c9-text-da1e57f94e1a4bc2fd96","person_id":"p144c4dac74c9","title":"壽城山六十五","titles":["壽城山六十五"],"text":"留得八千唐刺史，看成百億宰官身。\n不爭一月大小閏，猶是兩朝耆俊人。\n今歲兩翻初度日，明年三十六宮春。\n近來化得鄉君子，爲報麻姑不更塵。"},"p144c4dac74c9-text-06bc0d261bc49aad1181":{"id":"p144c4dac74c9-text-06bc0d261bc49aad1181","person_id":"p144c4dac74c9","title":"永遇乐","titles":["永遇乐"],"text":"灯舫华星，崖山碇口，官军围处。\n璧月辉圆，银花焰短，春事遽如许。\n麟洲清浅，鳌山流播，愁似汨罗夜雨。\n还知道，良辰美景，当时邺下仙侣。\n而今无奈，元正元夕，把似月朝十五。\n小庙看灯，团街转鼓，总是添恻楚。\n传柑袖冷，吹藜漏尽，又见岁来岁去。\n空犹记，弓弯一句，似虞兮语。"},"p144c4dac74c9-text-cc2c4a287406890f70e9":{"id":"p144c4dac74c9-text-cc2c4a287406890f70e9","person_id":"p144c4dac74c9","title":"望江南・忆江南","titles":["望江南・忆江南"],"text":"盘之所，春蝶舞晴暄。\n溪傍野梅根种玉，墙围修竹笋生鞭。\n深院待回仙。\n嘉熙好，四十二年前。\n犹记五星丁卯聚，更迟几岁甲申连。\n快活共千年。"},"p144c4dac74c9-text-af4a5115027eb7360718":{"id":"p144c4dac74c9-text-af4a5115027eb7360718","person_id":"p144c4dac74c9","title":"水调歌头","titles":["水调歌头"],"text":"似似不常似，似我一生徒。\n画工自画龙种，忽近海飞鱼。\n大笑北宫称弟，遂使西河疑女，同气自椒萸。\n且谓杜公者，即是老君乎。\n日给华，芎蓏本，薛羊书。\n马师真只这是，可是躄浮图。\n大小卢同马异，天下使君与操，但欠虎铜符。\n说甚左眼痣，已过洞庭湖。"}}}
