s":"automatic","work_id":"pbd9195709bc1-text-a304f6a0ecc5fc73bda5","title":"勸農"}]},"pbd9195709bc1-item-5bded1282374e8a57f04":{"id":"pbd9195709bc1-item-5bded1282374e8a57f04","person_id":"pbd9195709bc1","title":"","units":[]},"pbd9195709bc1-item-597478c0967368c8e551":{"id":"pbd9195709bc1-item-597478c0967368c8e551","person_id":"pbd9195709bc1","title":"","units":[]},"pbd9195709bc1-item-98028026a73b1174309d":{"id":"pbd9195709bc1-item-98028026a73b1174309d","person_id":"pbd9195709bc1","title":"","units":[]},"pbd9195709bc1-item-2382c8a4794661d89e6e":{"id":"pbd9195709bc1-item-2382c8a4794661d89e6e","person_id":"pbd9195709bc1","title":"","units":[]},"pbd9195709bc1-item-aa97ed2dcbb2c7573ba3":{"id":"pbd9195709bc1-item-aa97ed2dcbb2c7573ba3","person_id":"pbd9195709bc1","title":"","units":[]},"pbd9195709bc1-item-ced92069e967e958b24f":{"id":"pbd9195709bc1-item-ced92069e967e958b24f","person_id":"pbd9195709bc1","title":"","units":[]},"pbd9195709bc1-item-8fadb6dc4abf4610de22":{"id":"pbd9195709bc1-item-8fadb6dc4abf4610de22","person_id":"pbd9195709bc1","title":"","units":[]},"pbd9195709bc1-item-a80c60aeec37efa107db":{"id":"pbd9195709bc1-item-a80c60aeec37efa107db","person_id":"pbd9195709bc1","title":"","units":[]},"pbd9195709bc1-item-dd1237b472626134349c":{"id":"pbd9195709bc1-item-dd1237b472626134349c","person_id":"pbd9195709bc1","title":"","units":[]},"pbd9195709bc1-item-2a1e0e207aca07694c62":{"id":"pbd9195709bc1-item-2a1e0e207aca07694c62","person_id":"pbd9195709bc1","title":"","units":[]}},"works":{"pbd9195709bc1-text-78556c0c137a3d5fd307":{"id":"pbd9195709bc1-text-78556c0c137a3d5fd307","person_id":"pbd9195709bc1","title":"水调歌头","titles":["水调歌头"],"text":"生日重重见，馀闰有新春。\n为吾母寿，富贵外物总休论。\n且说家怀旧话，教学也曾菽水，亲意尽欣欣。\n只此是真乐，乐岂在邦君。\n吾二老，常说与，要廉勤。\n庐陵几千万户，休戚属儿身。\n三瑞堂中绿醑，酿就满城和气，端又属人伦。\n吾亦老吾老，谁不敬其亲。"},"pbd9195709bc1-text-a304f6a0ecc5fc73bda5":{"id":"pbd9195709bc1-text-a304f6a0ecc5fc73bda5","person_id":"pbd9195709bc1","title":"勸農","titles":["勸農"],"text":"農豈猶需我勸農，且從人意卜年豐。\n喜聞布穀聲聲急，莫爲催科處處窮。\n父老來前吾語汝，官民相近古遺風。\n欲知太守樂其樂，樂在田家歡笑中。"}}}
