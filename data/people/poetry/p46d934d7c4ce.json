art-01","status":"automatic","work_id":"p46d934d7c4ce-text-d0d7ae43ba777828e4f0","title":"鹧鸪天"}]},"p46d934d7c4ce-item-70acce9b0963effebdd4":{"id":"p46d934d7c4ce-item-70acce9b0963effebdd4","person_id":"p46d934d7c4ce","title":"","units":[]},"p46d934d7c4ce-item-c153d59bd7ad37c35e3f":{"id":"p46d934d7c4ce-item-c153d59bd7ad37c35e3f","person_id":"p46d934d7c4ce","title":"","units":[]},"p46d934d7c4ce-item-74875bce3d35d9e18418":{"id":"p46d934d7c4ce-item-74875bce3d35d9e18418","person_id":"p46d934d7c4ce","title":"点绛唇","units":[{"id":"p46d934d7c4ce-item-74875bce3d35d9e18418-part-01","status":"automatic","work_id":"p46d934d7c4ce-text-c65aebfa62c3d2ffe4f4","title":"点绛唇"}]},"p46d934d7c4ce-item-b81a54b640bf6102f156":{"id":"p46d934d7c4ce-item-b81a54b640bf6102f156","person_id":"p46d934d7c4ce","title":"蝶恋花","units":[{"id":"p46d934d7c4ce-item-b81a54b640bf6102f156-part-01","status":"automatic","work_id":"p46d934d7c4ce-text-944502e6143f5a61da8b","title":"蝶恋花"}]},"p46d934d7c4ce-item-5d2835792b496de80b20":{"id":"p46d934d7c4ce-item-5d2835792b496de80b20","person_id":"p46d934d7c4ce","title":"","units":[]},"p46d934d7c4ce-item-b9eae421beb941a49f4e":{"id":"p46d934d7c4ce-item-b9eae421beb941a49f4e","person_id":"p46d934d7c4ce","title":"","units":[]},"p46d934d7c4ce-item-1127115b3d1c332a7d21":{"id":"p46d934d7c4ce-item-1127115b3d1c332a7d21","person_id":"p46d934d7c4ce","title":"","units":[]},"p46d934d7c4ce-item-5b9c5328dd125ad43990":{"id":"p46d934d7c4ce-item-5b9c5328dd125ad43990","person_id":"p46d934d7c4ce","title":"满庭芳","units":[{"id":"p46d934d7c4ce-item-5b9c5328dd125ad43990-part-01","status":"automatic","work_id":"p46d934d7c4ce-text-f541d877676eafc3f3c2","title":"满庭芳"}]},"p46d934d7c4ce-item-a823c62136463eee99f5":{"id":"p46d934d7c4ce-item-a823c62136463eee99f5","person_id":"p46d934d7c4ce","title":"鹊桥仙","units":[{"id":"p46d934d7c4ce-item-a823c62136463eee99f5-part-01","status":"automatic","work_id":"p46d934d7c4ce-text-51baf0cf273525b5d66c","title":"鹊桥仙"}]}},"works":{"p46d934d7c4ce-text-d0d7ae43ba777828e4f0":{"id":"p46d934d7c4ce-text-d0d7ae43ba777828e4f0","person_id":"p46d934d7c4ce","title":"鹧鸪天","titles":["鹧鸪天"],"text":"竹树萧萧屋数椽。\n平湖漫漫纳通川。\n有时竹杖芒鞋至，醉著山光水色间。\n成小隐，未经年。\n功名夷路稳加鞭。\n逢时且数中书考，他日还寻独乐园。"},"p46d934d7c4ce-text-c65aebfa62c3d2ffe4f4":{"id":"p46d934d7c4ce-text-c65aebfa62c3d2ffe4f4","person_id":"p46d934d7c4ce","title":"点绛唇","titles":["点绛唇"],"text":"满路梅花，为谁开遍春风萼。\n短亭萧索。\n草草传杯酌。\n送子先归，我羡辽东鹤。\n他年约。\n瘦藤芒履。\n共子同丘壑。"},"p46d934d7c4ce-text-944502e6143f5a61da8b":{"id":"p46d934d7c4ce-text-944502e6143f5a61da8b","person_id":"p46d934d7c4ce","title":"蝶恋花","titles":["蝶恋花"],"text":"天际行云红一缕。\n无尽青山，江水悠悠去。\n更上层楼凭远处。\n凄凉今古悲三楚。\n心事多端谁共语。\n酒醒愁来，望望家何所。\n薄宦漂零成久旅。\n天涯却羡鸿遵渚。"},"p46d934d7c4ce-text-f541d877676eafc3f3c2":{"id":"p46d934d7c4ce-text-f541d877676eafc3f3c2","person_id":"p46d934d7c4ce","title":"满庭芳","titles":["满庭芳"],"text":"丹雘浮空，琉璃耀日，上云楼阁眈眈。\n□□居士，燕坐息玄谈。\n十载劳心问道，今悟罢、截日停参。\n凝神处，九苞丹凤，翔舞在山南。\n喃喃。\n成障碍，千经万论，从此休贪。\n且陶陶兀兀，对酒醺酣。\n清兴有时狂放，扁舟上、绿水澄潭。\n渔歌起，从他两岸，齐笑老翁憨。"},"p46d934d7c4ce-text-51baf0cf273525b5d66c":{"id":"p46d934d7c4ce-text-51baf0cf273525b5d66c","person_id":"p46d934d7c4ce","title":"鹊桥仙","titles":["鹊桥仙"],"text":"银花千里，玉阶三尺，远近高低一色。\n天公今岁被诗催，特地放、冬前四白。\n梅梢竹外，频频轻撼，嫌乱瑶芳素质。\n耐寒相对不胜清，毡帐底、偎红未得。"}}}
