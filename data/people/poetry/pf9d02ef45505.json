}]},"pf9d02ef45505-item-49adc2e5877167f07736":{"id":"pf9d02ef45505-item-49adc2e5877167f07736","person_id":"pf9d02ef45505","title":"贺新郎","units":[{"id":"pf9d02ef45505-item-49adc2e5877167f07736-part-01","status":"automatic","work_id":"pf9d02ef45505-text-ab1a86a636a65ee95723","title":"贺新郎"}]},"pf9d02ef45505-item-1a416f26880471ef47af":{"id":"pf9d02ef45505-item-1a416f26880471ef47af","person_id":"pf9d02ef45505","title":"沁园春","units":[{"id":"pf9d02ef45505-item-1a416f26880471ef47af-part-01","status":"automatic","work_id":"pf9d02ef45505-text-cfc7541f2c0ab51fba27","title":"沁园春"}]},"pf9d02ef45505-item-d6b3711fce346826369f":{"id":"pf9d02ef45505-item-d6b3711fce346826369f","person_id":"pf9d02ef45505","title":"水调歌・水调","units":[{"id":"pf9d02ef45505-item-d6b3711fce346826369f-part-01","status":"automatic","work_id":"pf9d02ef45505-text-b548fb8b1089c4d12458","title":"水调歌・水调"}]},"pf9d02ef45505-item-f70d820483df72852d8a":{"id":"pf9d02ef45505-item-f70d820483df72852d8a","person_id":"pf9d02ef45505","title":"沁园春","units":[{"id":"pf9d02ef45505-item-f70d820483df72852d8a-part-01","status":"automatic","work_id":"pf9d02ef45505-text-5d3685514f89e1d984cd","title":"沁园春"}]},"pf9d02ef45505-item-7716bb2c38934ba4f958":{"id":"pf9d02ef45505-item-7716bb2c38934ba4f958","person_id":"pf9d02ef45505","title":"","units":[]},"pf9d02ef45505-item-e2c20d076daadf4e01ef":{"id":"pf9d02ef45505-item-e2c20d076daadf4e01ef","person_id":"pf9d02ef45505","title":"","units":[]},"pf9d02ef45505-item-0102da145a9c3f79ed8c":{"id":"pf9d02ef45505-item-0102da145a9c3f79ed8c","person_id":"pf9d02ef45505","title":"","units":[]}},"works":{"pf9d02ef45505-text-11690e5135b89a28cda8":{"id":"pf9d02ef45505-text-11690e5135b89a28cda8","person_id":"pf9d02ef45505","title":"醉蓬莱","titles":["醉蓬莱"],"text":"正三边月静，万国年丰，菊多梅小。\n吐玉擎香，蔼黄都清晓。\n龙驾徐驱，貂冠夹侍，天也和人笑。\n紫陌欢谣，如今事事，胜端平好。\n玉带垂虹，衮衣华日，秋水精神，臞仙容貌。\n长对凝旒，不羡商岩老。\n胸次乾坤，掌中霖雨，造化知多少。\n便好重将，绛人甲子，数中书考。"},"pf9d02ef45505-text-ee186c8ac17f87bcad7b":{"id":"pf9d02ef45505-text-ee186c8ac17f87bcad7b","person_id":"pf9d02ef45505","title":"探春慢","titles":["探春慢"],"text":"屑璐飘寒，镂金献巧，妆成水晶亭榭。\n飞絮悠扬，散花零乱，绝胜翠娇红冶。\n粉艳嘻嘻道，尽飞上、使君鬚也。\n多情莫笑衰翁，旧时梁苑声价。\n窗外小梅羞涩，倩羯鼓尊前，慢敲轻打。\n鲸海停波，鹤谯宾月，赢得残年清暇。\n心事知谁会，但梦绕、越王城下。\n白玉青丝，且同醉吟春夜。"},"pf9d02ef45505-text-3d31b4fc74033fde88d6":{"id":"pf9d02ef45505-text-3d31b4fc74033fde88d6","person_id":"pf9d02ef45505","title":"探春慢","titles":["探春慢"],"text":"宝胜宾春，华灯照夜，穷冬浑然如客。\n炉焰鳞红，杯深翡翠，早减三分寒力。\n一笑团栾处，恰喜得、雪消风息。\n苔枝数蕊明珠，恍疑香麝初拆。\n懊恨东君无准，甚朝做重阴，暮还晴色。\n唤燕呼莺，雕花镂叶，机巧可曾休得。\n静里无穷意，漫看尽、纷纷红白。\n且听新腔，红牙玉纤低拍。"},"pf9d02ef45505-text-0fb6d12f04367e5fda37":{"id":"pf9d02ef45505-text-0fb6d12f04367e5fda37","person_id":"pf9d02ef45505","title":"芰荷香","titles":["芰荷香"],"text":"倚晴空。\n爱湖光潋滟，楼影青红。\n彩丝金黍，水边还又相逢。\n怀沙人问，二千年、犹带酸风。\n骚人洒墨香浓。\n幽情要眇，雅调惺松。\n天上菖蒲五色，倩掺掺素手，分入雕锺。\n新欢往恨，一时付与歌童。\n斜阳正好，且留连、休要匆匆。\n应须倒尽郫筒。\n归鞭笑指，月挂苍龙。"},"pf9d02ef45505-text-bc15feef5410e2b16f67":{"id":"pf9d02ef45505-text-bc15feef5410e2b16f67","person_id":"pf9d02ef45505","title":"桂枝香","titles":["桂枝香"],"text":"青霄望极。\n际万里月明，无点云色。\n一片冰壶世界，水乡先得。\n年年客里惊秋半，倚西风、鬓华吹白。\n觅闲无路，相逢且醉，好天凉夕。\n听曲曲、仙韶促拍。\n趁画舸飞空，雪浪翻激。\n行乐风流，暗省旧时京国。\n插空翠巇连星麓，但波痕、浮动金碧。\n不如归去，扁舟五湖，钓竿渔笛。"},"pf9d02ef45505-text-667d1baf476aa5d47dfe":{"id":"pf9d02ef45505-text-667d1baf476aa5d47dfe","person_id":"pf9d02ef45505","title":"龙山会","titles":["龙山会"],"text":"佳节明朝九。\n彩舫凌虚，共醉西风酒。\n湖光蓝滴透。\n云浪碎、巧学波纹吹皱。\n碧落杳无边，但玉削，千峰寒瘦。\n留连久，秋容似洗，月华如昼。\n回头南楚东徐，暝霭苍烟，处处空刁斗。\n山公今健否。\n功名事、付与年时交旧。\n白发苦欺人，尚堪插、黄花盈首。\n归去也、东篱好在，觅渊明友。"},"pf9d02ef45505-text-ecb3a13dfccc24e16cf6":{"id":"pf9d02ef45505-text-ecb3a13dfccc24e16cf6","person_id":"pf9d02ef45505","title":"桂枝香","titles":["桂枝香"],"text":"水天一色。\n正四野秋高，千古愁极。\n多少黄花密意，付他欢伯。\n楼前马戏星球过，又依稀、东徐陈迹。\n一时豪俊，风流济济，酒朋诗敌。\n画不就、江东暮碧。\n想阅尽千帆，来往潮汐。\n烟草萋迷，此际为谁心恻。\n引杯抚剑凭高处，黯消魂、目断天北。\n至今人笑，新亭坐间，泪珠空滴。"},"pf9d02ef45505-text-ab1a86a636a65ee95723":{"id":"pf9d02ef45505-text-ab1a86a636a65ee95723","person_id":"pf9d02ef45505","title":"贺新郎","titles":["贺新郎"],"text":"满酌蓬莱酒。\n最苦是、中年作恶，送人时候。\n一夜朔风吹石裂，惊得梅花也瘦，更衣袂、严霜寒透。\n卷起潮头无丈尺，甚扁舟、拍上三江口。\n明月冷，载归否。\n分携欲折无垂柳。\n但层楼徙倚，两眉空皱。\n海阔天高无处问，万事不堪回首。\n况目断、孤鸿去后。\n玉样松鲈今正美，想子真、微笑还招手。\n且为我，饮三斗。"},"pf9d02ef45505-text-cfc7541f2c0ab51fba27":{"id":"pf9d02ef45505-text-cfc7541f2c0ab51fba27","person_id":"pf9d02ef45505","title":"沁园春","titles":["沁园春"],"text":"客问吾年，吾将老矣，今五十三。\n似北海先生，过之又过，善财童子，参到无参。\n官路太行，世情沧海，何止嵇康七不堪。\n归来也，是休官令尹，有发瞿昙。\n千岩。\n秀色如蓝。\n新著个楼儿恰对南。\n看浮云自在，百般态度，长江无际，一碧虚涵。\n荔子江珧，莼羹鲈鲙，一曲春风酒半酣。\n凭阑处，正空流皓月，光满寒潭。"},"pf9d02ef45505-text-b548fb8b1089c4d12458":{"id":"pf9d02ef45505-text-b548fb8b1089c4d12458","person_id":"pf9d02ef45505","title":"水调歌・水调","titles":["水调歌・水调"],"text":"竞渡楚乡事，夸胜锦缠头。\n湖光渌净，转胜雪浪舞潜虬。\n刚道琉璃宝苑，移作水晶珠阙，鳌顶出中流。\n一钓惊天地，能动此心不。\n活千年，封万户，等虚舟。\n渺然身世，烟水浩荡一沙鸥。\n听得长淮风景，唤起离骚往恨，杜若满汀洲。\n相对老榕下，五月已先秋。"},"pf9d02ef45505-text-5d3685514f89e1d984cd":{"id":"pf9d02ef45505-text-5d3685514f89e1d984cd","person_id":"pf9d02ef45505","title":"沁园春","titles":["沁园春"],"text":"秋入书帏，漏箭初长，熏炉未灰。\n向酒边陶写，韩情杜思，案头料理，汉蠹秦煨。\n天有高情，世无慧眼，刚道先生是不斋。\n人都笑，这当行铺席，又不成开。\n忘怀。\n物外徘徊。\n与鸥鹭同盟两莫猜。\n似琉璃匣里，光涵牛斗，凤凰台上，声挟风雷。\n宝汞一钱，冰衔三字，浮利浮名安在哉。\n太平也，要泥金镂玉，除是公来。"}}}
