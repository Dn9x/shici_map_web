5c-item-3eea8bd01ad0df79be44":{"id":"p746019fe9e5c-item-3eea8bd01ad0df79be44","person_id":"p746019fe9e5c","title":"送許棠歸涇縣作尉","units":[{"id":"p746019fe9e5c-item-3eea8bd01ad0df79be44-part-01","status":"automatic","work_id":"p746019fe9e5c-text-e92e7bfe7745b5b1978e","title":"送許棠歸涇縣作尉"}]},"p746019fe9e5c-item-40c5c11d671f2f4981c0":{"id":"p746019fe9e5c-item-40c5c11d671f2f4981c0","person_id":"p746019fe9e5c","title":"送許棠及第歸宣州","units":[{"id":"p746019fe9e5c-item-40c5c11d671f2f4981c0-part-01","status":"automatic","work_id":"p746019fe9e5c-text-1c11b018afd5adb6c2d4","title":"送許棠及第歸宣州"}]},"p746019fe9e5c-item-a35b3f5adf315c396735":{"id":"p746019fe9e5c-item-a35b3f5adf315c396735","person_id":"p746019fe9e5c","title":"鄜州留別王從事","units":[{"id":"p746019fe9e5c-item-a35b3f5adf315c396735-part-01","status":"automatic","work_id":"p746019fe9e5c-text-cafefe97488122a4f919","title":"鄜州留別王從事"}]},"p746019fe9e5c-item-372ccf2df81000815289":{"id":"p746019fe9e5c-item-372ccf2df81000815289","person_id":"p746019fe9e5c","title":"","units":[]},"p746019fe9e5c-item-1f803219eb1e485a3bc7":{"id":"p746019fe9e5c-item-1f803219eb1e485a3bc7","person_id":"p746019fe9e5c","title":"朔中即事","units":[{"id":"p746019fe9e5c-item-1f803219eb1e485a3bc7-part-01","status":"automatic","work_id":"p746019fe9e5c-text-8ae2c32cbb4f3e741023","title":"朔中即事"}]},"p746019fe9e5c-item-3516f1825bc29880c4e3":{"id":"p746019fe9e5c-item-3516f1825bc29880c4e3","person_id":"p746019fe9e5c","title":"贈涇州王侍御","units":[{"id":"p746019fe9e5c-item-3516f1825bc29880c4e3-part-01","status":"automatic","work_id":"p746019fe9e5c-text-7d48ddf283f84e05212d","title":"贈涇州王侍御"}]},"p746019fe9e5c-item-632f5588faba97997b16":{"id":"p746019fe9e5c-item-632f5588faba97997b16","person_id":"p746019fe9e5c","title":"感懷獻門下相公","units":[{"id":"p746019fe9e5c-item-632f5588faba97997b16-part-01","status":"automatic","work_id":"p746019fe9e5c-text-4e735aa79ff356a49a92","title":"感懷獻門下相公"}]},"p746019fe9e5c-item-0061fd612959aa2ae4ac":{"id":"p746019fe9e5c-item-0061fd612959aa2ae4ac","person_id":"p746019fe9e5c","title":"送薛能赴鎮徐方","units":[{"id":"p746019fe9e5c-item-0061fd612959aa2ae4ac-part-01","status":"automatic","work_id":"p746019fe9e5c-text-b570c1d9c4afd4de9786","title":"送薛能赴鎮徐方"}]},"p746019fe9e5c-item-8011ab938aad7d2943b6":{"id":"p746019fe9e5c-item-8011ab938aad7d2943b6","person_id":"p746019fe9e5c","title":"送鄂渚韋尚書赴鎮","units":[{"id":"p746019fe9e5c-item-8011ab938aad7d2943b6-part-01","status":"automatic","work_id":"p746019fe9e5c-text-6680882dda5b9323aea3","title":"送鄂渚韋尚書赴鎮"}]},"p746019fe9e5c-item-7a63f967cc318a024901":{"id":"p746019fe9e5c-item-7a63f967cc318a024901","person_id":"p746019fe9e5c","title":"五月一日蒙替本官不得隨例入關感懷獻送相公","units":[{"id":"p746019fe9e5c-item-7a63f967cc318a024901-part-01","status":"automatic","work_id":"p746019fe9e5c-text-168b30bb6da5d0306aa0","title":"五月一日蒙替本官不得隨例入關感懷獻送相公"}]},"p746019fe9e5c-item-e22cdb3a22b935c0821b":{"id":"p746019fe9e5c-item-e22cdb3a22b935c0821b","person_id":"p746019fe9e5c","title":"之任建安淥溪亭偶作二首 一 / 之任建安淥溪亭偶作二首 二","units":[{"id":"p746019fe9e5c-item-e22cdb3a22b935c0821b-part-01","status":"automatic","work_id":"p746019fe9e5c-text-79e9fedb7bcc794d8699","title":"之任建安淥溪亭偶作二首 一"},{"id":"p746019fe9e5c-item-e22cdb3a22b935c0821b-part-02","status":"automatic","work_id":"p746019fe9e5c-text-d0aa8673b7cc55bf7d0b","title":"之任建安淥溪亭偶作二首 二"}]}},"works":{"p746019fe9e5c-text-0952c2016f8c4c49d0c6":{"id":"p746019fe9e5c-text-0952c2016f8c4c49d0c6","person_id":"p746019fe9e5c","title":"陝府上姚中丞","titles":["陝府上姚中丞"],"text":"關東領藩鎮，[闕]下授旌旄。\n覓句秋吟苦，酬恩夜坐勞。\n天開吹角出，木落上樓高。\n閑話錢塘郡，半年聽海潮。"},"p746019fe9e5c-text-5ac2083e511f06b016d9":{"id":"p746019fe9e5c-text-5ac2083e511f06b016d9","person_id":"p746019fe9e5c","title":"陝下投姚諫議","titles":["陝下投姚諫議"],"text":"舊業在東鄙，西遊從楚荆。\n風雷幾夜坐，山水半年行。\n夢永秋燈滅，吟孤曉露明。\n前心若不遂，有耻却歸耕。"},"p746019fe9e5c-text-75786ca1aaca878edcd0":{"id":"p746019fe9e5c-text-75786ca1aaca878edcd0","person_id":"p746019fe9e5c","title":"陝下懷歸","titles":["陝下懷歸"],"text":"故園何處在，零落五湖東。\n日暮無來客，天寒有去鴻。\n大河冰徹塞，高嶽雪連空。\n獨夜懸歸思，迢迢永漏中。"},"p746019fe9e5c-text-929bf73bc7c9cd663028":{"id":"p746019fe9e5c-text-929bf73bc7c9cd663028","person_id":"p746019fe9e5c","title":"長安書情投知己","titles":["長安書情投知己"],"text":"陝服因詩句，從容已半年。\n一從歸闕下，罕得到門前。\n每候朝軒出，常看列宿懸。\n重投期見獎，數首果蒙傳。\n轉覺功宜倍，兼令住更堅。\n都忘春暫醉，少省夜曾眠。\n煩暑燈誰讀，孤雲業自專。\n精華搜未竭，騷雅琢須全。\n此事勤雖過，他謀拙莫先。\n槐街勞白日，桂路在青天。\n取第殊無序，還鄉可有緣。\n旅情長越鳥，秋思幾秦蟬。\n月色千樓滿，砧聲萬井連。\n江山阻迢遞，時節暗推遷。\n道即窮通守，才應始末憐。\n書紳相戒語，藏篋贈行篇。\n致主當齊聖，爲郎本是仙。\n人心期際會，鳳翼許遷延。\n畢竟良圖在，何妨逸性便。\n幽齋中寢覺，珍木正陰圓。\n隱几閑瞻夜，臨雲興渺然。\n五陵供麗景，六義動花牋。\n倘與潛生翼，寧非助化權。\n免教垂素髪，歸種海隅田。"},"p746019fe9e5c-text-3a40eec53a5400f95168":{"id":"p746019fe9e5c-text-3a40eec53a5400f95168","person_id":"p746019fe9e5c","title":"夏日宿秘書姚監宅","titles":["夏日宿秘書姚監宅"],"text":"貴宅多嘉樹，先秋有好風。\n情閑離闕下，夢野在山中。\n露色浮寒瓦，螢光墮暗叢。\n聽吟麗句盡，河漢任西東。"},"p746019fe9e5c-text-01c6abcef15a085a7392":{"id":"p746019fe9e5c-text-01c6abcef15a085a7392","person_id":"p746019fe9e5c","title":"太和公主還宮","titles":["太和公主還宮"],"text":"天驕發使犯邊塵，漢將推功遂奪親。\n離亂應無初去貌，死生難有却回身。\n禁花半老曾攀樹，宮女多非舊識人。\n重上鳳樓追故事，幾多愁思向青春。"},"p746019fe9e5c-text-9930220ac58678a9ef4f":{"id":"p746019fe9e5c-text-9930220ac58678a9ef4f","person_id":"p746019fe9e5c","title":"哭賈島","titles":["哭賈島"],"text":"秦樓吟苦夜，南望只悲君。\n一宦終遐徼，千山隔旅墳。\n恨聲流蜀魄，冤氣入湘雲。\n無限風騷句，時來日夜聞。"},"p746019fe9e5c-text-3ba6694637f2e2cf4887":{"id":"p746019fe9e5c-text-3ba6694637f2e2cf4887","person_id":"p746019fe9e5c","title":"送許渾侍御赴潤州","titles":["送許渾侍御赴潤州"],"text":"家山近石頭，遂意恣東遊。\n祖席離烏府，歸帆轉蜃樓。\n陰氛出海散，落月向潮流。\n別有爲霖日，孤雲未自由。"},"p746019fe9e5c-text-ea5c0208bff4f1597f86":{"id":"p746019fe9e5c-text-ea5c0208bff4f1597f86","person_id":"p746019fe9e5c","title":"蜀中逢友人","titles":["蜀中逢友人"],"text":"自古有行役，誰人免別家。\n相歡猶陌上，一醉任天涯。\n積疊山藏蜀，潺湲水遶巴。\n他年復何處，共說海棠花。"},"p746019fe9e5c-text-3ecacc9b3aaaebec30b8":{"id":"p746019fe9e5c-text-3ecacc9b3aaaebec30b8","person_id":"p746019fe9e5c","title":"眉州別李使君","titles":["眉州別李使君"],"text":"回首雪峰前，朱門心杳然。\n離人自嗚咽，流水莫潺湲。\n毒草通蠻徼，秋林近漏天。\n一生從此去，五字有誰憐。"},"p746019fe9e5c-text-f881f142c2ed667e6156":{"id":"p746019fe9e5c-text-f881f142c2ed667e6156","person_id":"p746019fe9e5c","title":"過長江傷賈島","titles":["過長江傷賈島"],"text":"忽從一宦遠流離，無罪無人子細知。\n到得長江聞杜宇，想君魂魄也相隨。"},"p746019fe9e5c-text-0014b8063533cdf8b566":{"id":"p746019fe9e5c-text-0014b8063533cdf8b566","person_id":"p746019fe9e5c","title":"奉和鄭薰相公","titles":["奉和鄭薰相公"],"text":"三四株松匝草亭，便成彭澤柳爲名。\n蓮峰隱去難辭闕，滻水朝回與出城。"},"p746019fe9e5c-text-4289ec503f1577d6d543":{"id":"p746019fe9e5c-text-4289ec503f1577d6d543","person_id":"p746019fe9e5c","title":"送薛能少府任盩厔","titles":["送薛能少府任盩厔"],"text":"不才甘下第，君子蹇何重。\n相送昆明岸，同看太白峰。\n數瓢留頃刻，殘照迫從容。\n好去煙霞縣，仙人有舊蹤。"},"p746019fe9e5c-text-f35a5237ab55dba126ed":{"id":"p746019fe9e5c-text-f35a5237ab55dba126ed","person_id":"p746019fe9e5c","title":"及第後還家過峴嶺","titles":["及第後還家過峴嶺"],"text":"魏馱山前一朵花，嶺西更有幾千家。\n石斑魚鮓香衝鼻，淺水沙田飯遶牙。"},"p746019fe9e5c-text-3e26e394823e78ecae34":{"id":"p746019fe9e5c-text-3e26e394823e78ecae34","person_id":"p746019fe9e5c","title":"及第後歸","titles":["及第後歸"],"text":"家臨浙水傍，岸對買臣鄉。\n縱棹隨歸鳥，乘潮向夕陽。\n苦吟身得雪，甘意鬢成霜。\n況此年猶少，酬知足自強。"},"p746019fe9e5c-text-1e65c14dc4b30ae69626":{"id":"p746019fe9e5c-text-1e65c14dc4b30ae69626","person_id":"p746019fe9e5c","title":"黔中酬同院韋判官","titles":["黔中酬同院韋判官"],"text":"平生同所爲，相遇偶然遲。\n各著青袍後，無歸白社期。\n江流來絕域，府地管諸夷。\n聖代都無事，從公且賦詩。"},"p746019fe9e5c-text-65bcc524df50bdd3c451":{"id":"p746019fe9e5c-text-65bcc524df50bdd3c451","person_id":"p746019fe9e5c","title":"初離黔中泊江上","titles":["初離黔中泊江上"],"text":"去去把青桂，平生心不違。\n更蒙蓮府辟，兼脫布衣歸。\n霽岳明殘雪，清波漾落暉。\n無窮幽鳥戲，時向棹前飛。"},"p746019fe9e5c-text-4ab0405c2428a01636de":{"id":"p746019fe9e5c-text-4ab0405c2428a01636de","person_id":"p746019fe9e5c","title":"黔中罷職將泛江東","titles":["黔中罷職將泛江東"],"text":"黔中初罷職，薄俸亦無殘。\n舉目鄉關遠，攜家旅食難。\n野梅將雪競，江月與沙寒。\n兩鬢愁應白，何勞把鏡看。"},"p746019fe9e5c-text-77cb1d0d479e974c3f4a":{"id":"p746019fe9e5c-text-77cb1d0d479e974c3f4a","person_id":"p746019fe9e5c","title":"黔中罷職過峽州題田使君北樓","titles":["黔中罷職過峽州題田使君北樓"],"text":"巴中初去日，已遇使君留。\n及得尋東道，還陪上北樓。\n江衝巫峽出，檣過洛宮收。\n好是從戎罷，看山覺自由。"},"p746019fe9e5c-text-0342e1e1e8fff7a293fa":{"id":"p746019fe9e5c-text-0342e1e1e8fff7a293fa","person_id":"p746019fe9e5c","title":"江上送從兄羣玉校書東遊","titles":["江上送從兄羣玉校書東遊"],"text":"逍遙蓬閣吏，才子復詩流。\n墳籍因窮覽，江湖却縱遊。\n眠波聽戍鼓，飯浦約魚舟。\n處處迎高密，先應掃郡樓。"},"p746019fe9e5c-text-caea4e9972e2f137dc2c":{"id":"p746019fe9e5c-text-caea4e9972e2f137dc2c","person_id":"p746019fe9e5c","title":"宣州獻從叔大夫","titles":["宣州獻從叔大夫"],"text":"清時選地任賢明，從此觀風輟尹京。\n日月天中辭洛邑，雲山江上領宣城。\n萬家閭井俱安寢，千里農桑竟起耕。\n聞說聖朝同漢代，已愁徵入拜公卿。"},"p746019fe9e5c-text-e92e7bfe7745b5b1978e":{"id":"p746019fe9e5c-text-e92e7bfe7745b5b1978e","person_id":"p746019fe9e5c","title":"送許棠歸涇縣作尉","titles":["送許棠歸涇縣作尉"],"text":"青桂復青袍，一歸榮一高。\n縣人齊下拜，邑宰共分曹。\n遶郭看秧插，尋街聽繭繅。\n封侯萬里者，燕頷乃徒勞。"},"p746019fe9e5c-text-1c11b018afd5adb6c2d4":{"id":"p746019fe9e5c-text-1c11b018afd5adb6c2d4","person_id":"p746019fe9e5c","title":"送許棠及第歸宣州","titles":["送許棠及第歸宣州"],"text":"高科終自致，志業信如神。\n待得逢公道，由來合貴身。\n秋歸方覺好，舊夢始知真。\n更想青山宅，誰爲後主人。"},"p746019fe9e5c-text-cafefe97488122a4f919":{"id":"p746019fe9e5c-text-cafefe97488122a4f919","person_id":"p746019fe9e5c","title":"鄜州留別王從事","titles":["鄜州留別王從事"],"text":"相識未十日，相知如十年。\n從來易離別，此去忽留連。\n路險行衝雨，山高度隔天。\n難終清夜坐，更聽說安邊。"},"p746019fe9e5c-text-8ae2c32cbb4f3e741023":{"id":"p746019fe9e5c-text-8ae2c32cbb4f3e741023","person_id":"p746019fe9e5c","title":"朔中即事","titles":["朔中即事"],"text":"關門南北雜戎夷，草木秋來即出師。\n落日風沙長暝早，窮冬雨雪轉春遲。\n山頭堠火孤明後，星外行人四絕時。\n自古邊功何不立，漢家中外自相疑。"},"p746019fe9e5c-text-7d48ddf283f84e05212d":{"id":"p746019fe9e5c-text-7d48ddf283f84e05212d","person_id":"p746019fe9e5c","title":"贈涇州王侍御","titles":["贈涇州王侍御"],"text":"一旦天書下紫微，三年旌斾隴雲飛。\n塞門無事春空到，邊草青青戰馬肥。"},"p746019fe9e5c-text-4e735aa79ff356a49a92":{"id":"p746019fe9e5c-text-4e735aa79ff356a49a92","person_id":"p746019fe9e5c","title":"感懷獻門下相公","titles":["感懷獻門下相公"],"text":"誰云郎選不由詩，上相憐才積有時。\n却是龍鍾到門晚，終非稽古致身遲。\n謀將郡印歸難遂，讀著家書坐欲癡。\n日望南宮看列宿，迢迢婺女與鄉比。"},"p746019fe9e5c-text-b570c1d9c4afd4de9786":{"id":"p746019fe9e5c-text-b570c1d9c4afd4de9786","person_id":"p746019fe9e5c","title":"送薛能赴鎮徐方","titles":["送薛能赴鎮徐方"],"text":"列土人間盛，彭門屬九州。\n山河天設險，禮樂牧分憂。\n皎日爲明信，清風占早秋。\n雖同郤縠舉，郤縠不封侯。"},"p746019fe9e5c-text-6680882dda5b9323aea3":{"id":"p746019fe9e5c-text-6680882dda5b9323aea3","person_id":"p746019fe9e5c","title":"送鄂渚韋尚書赴鎮","titles":["送鄂渚韋尚書赴鎮"],"text":"夏口本吳頭，重城據上遊。\n戈船轉江漢，風月宿汀洲。\n執憲傾民望，銜恩赴主憂。\n誰知舊寮屬，攀餞淚仍流。"},"p746019fe9e5c-text-168b30bb6da5d0306aa0":{"id":"p746019fe9e5c-text-168b30bb6da5d0306aa0","person_id":"p746019fe9e5c","title":"五月一日蒙替本官不得隨例入關感懷獻送相公","titles":["五月一日蒙替本官不得隨例入關感懷獻送相公"],"text":"五月傾朝謁紫宸，一朝無分在清塵。\n含香已去星郎位，衣錦惟思婺女隣。\n折獄也曾爲俗吏，勸農元本是耕人。\n知將何事酬公道，只養生靈似養身。"},"p746019fe9e5c-text-79e9fedb7bcc794d8699":{"id":"p746019fe9e5c-text-79e9fedb7bcc794d8699","person_id":"p746019fe9e5c","title":"之任建安淥溪亭偶作二首 一","titles":["之任建安淥溪亭偶作二首 一"],"text":"入境當春務，農蠶事正殷。\n逢溪難飲馬，度嶺更勞人。\n想取烝黎泰，無過賦歛均。\n不知成政後，誰是得爲鄰。"},"p746019fe9e5c-text-d0aa8673b7cc55bf7d0b":{"id":"p746019fe9e5c-text-d0aa8673b7cc55bf7d0b","person_id":"p746019fe9e5c","title":"之任建安淥溪亭偶作二首 二","titles":["之任建安淥溪亭偶作二首 二"],"text":"維舟綠溪岸，繞郡白雲峰。\n將幕連山起，人家向水重。\n短才無獨見，長策未相逢。\n所幸分堯理，烝民悉可封。"}}}
