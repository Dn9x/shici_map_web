dcad1f22e5":{"id":"p41d520853b04-item-1f496aefdfdcad1f22e5","person_id":"p41d520853b04","title":"滕王閣","units":[{"id":"p41d520853b04-item-1f496aefdfdcad1f22e5-part-01","status":"automatic","work_id":"p41d520853b04-text-a7a1cab95305e33d04e5","title":"滕王閣"}]},"p41d520853b04-item-4041eb97ffcd60844027":{"id":"p41d520853b04-item-4041eb97ffcd60844027","person_id":"p41d520853b04","title":"","units":[]},"p41d520853b04-item-8de59fa29c13058e9dc3":{"id":"p41d520853b04-item-8de59fa29c13058e9dc3","person_id":"p41d520853b04","title":"","units":[]},"p41d520853b04-item-b37c5d9c7be588ca9d03":{"id":"p41d520853b04-item-b37c5d9c7be588ca9d03","person_id":"p41d520853b04","title":"","units":[]}},"works":{"p41d520853b04-text-8ae907d2fcf61301d7a8":{"id":"p41d520853b04-text-8ae907d2fcf61301d7a8","person_id":"p41d520853b04","title":"白下驛餞唐少府","titles":["白下驛餞唐少府"],"text":"下驛窮交日，昌亭旅食年。\n相知何用早，懷抱即依然。\n浦樓低晚照，鄉路隔風煙。\n去去如何道，長安在日邊。"},"p41d520853b04-text-2e5c2733e618097da770":{"id":"p41d520853b04-text-2e5c2733e618097da770","person_id":"p41d520853b04","title":"杜少府之任蜀州","titles":["杜少府之任蜀州"],"text":"城闕輔三秦，風煙望五津。\n與君離別意，同是宦遊人。\n海內存知己，天涯若比隣。\n無爲在岐路，兒女共霑巾。"},"p41d520853b04-text-2fc1d3edeee719202409":{"id":"p41d520853b04-text-2fc1d3edeee719202409","person_id":"p41d520853b04","title":"始平晚息","titles":["始平晚息"],"text":"觀闕長安近，江山蜀路賒。\n客行朝復夕，無處是鄉家。"},"p41d520853b04-text-f5459f901395d2e9e2d7":{"id":"p41d520853b04-text-f5459f901395d2e9e2d7","person_id":"p41d520853b04","title":"扶風晝屆離京浸遠","titles":["扶風晝屆離京浸遠"],"text":"帝里金莖去，扶風石柱來。\n山川殊未已，行路方悠哉。"},"p41d520853b04-text-e149c8471205fa146416":{"id":"p41d520853b04-text-e149c8471205fa146416","person_id":"p41d520853b04","title":"長柳","titles":["長柳"],"text":"晨征犯煙磴，夕憩在雲關。\n晚風清近壑，新月照澄灣。\n郊童樵唱返，津叟釣歌還。\n客行無與晤，賴此釋愁顏。"},"p41d520853b04-text-328b27d2bffbbaa554c2":{"id":"p41d520853b04-text-328b27d2bffbbaa554c2","person_id":"p41d520853b04","title":"普安建陰題壁","titles":["普安建陰題壁"],"text":"江漢深無極，梁岷不可攀。\n山川雲霧裏，遊子幾時還。"},"p41d520853b04-text-9c003254b121e4d7daf1":{"id":"p41d520853b04-text-9c003254b121e4d7daf1","person_id":"p41d520853b04","title":"別薛華","titles":["別薛華"],"text":"送送多窮路，遑遑獨問津。\n悲涼千里道，悽斷百年身。\n心事同漂泊，生涯共苦辛。\n無論去與住，俱是夢中人。"},"p41d520853b04-text-b2465d3dc84efdfe60cc":{"id":"p41d520853b04-text-b2465d3dc84efdfe60cc","person_id":"p41d520853b04","title":"蜀中九日","titles":["蜀中九日"],"text":"九月九日望鄉臺，他席他鄉送客杯。\n人情已厭南中苦，鴻雁那從北地來。"},"p41d520853b04-text-c07e58c4232e60fb9a37":{"id":"p41d520853b04-text-c07e58c4232e60fb9a37","person_id":"p41d520853b04","title":"聖泉宴","titles":["聖泉宴"],"text":"披襟乘石磴，列籍俯春泉。\n蘭氣熏山酌，松聲韻野弦。\n影飄垂葉外，香度落花前。\n興洽林塘晚，重巖起夕煙。"},"p41d520853b04-text-456a31c43f5454eb3fa5":{"id":"p41d520853b04-text-456a31c43f5454eb3fa5","person_id":"p41d520853b04","title":"遊梵宇三覺寺","titles":["遊梵宇三覺寺"],"text":"杏閣披青磴，琱臺控紫岑。\n葉齊山路狹，花積野壇深。\n蘿幌棲禪影，松門聽梵音。\n遽忻陪妙躅，延賞滌煩襟。"},"p41d520853b04-text-63a7d2542351e8b6aab2":{"id":"p41d520853b04-text-63a7d2542351e8b6aab2","person_id":"p41d520853b04","title":"八仙逕","titles":["八仙逕"],"text":"柰園欣八正，松巖訪九仙。\n援蘿窺霧術，攀林俯雲烟。\n代北鸞驂至，遼西鶴騎旋。\n終希脫塵網，連翼下芝田。"},"p41d520853b04-text-de68111c86b4a33354ce":{"id":"p41d520853b04-text-de68111c86b4a33354ce","person_id":"p41d520853b04","title":"尋道觀","titles":["尋道觀"],"text":"芝廛光分野，蓬闕盛規模。\n碧壇清桂閾，丹洞肅松樞。\n玉笈三山記，金箱五嶽圖。\n蒼虬不可得，空望白雲衢。"},"p41d520853b04-text-5733d345a030babf0f85":{"id":"p41d520853b04-text-5733d345a030babf0f85","person_id":"p41d520853b04","title":"觀內懷仙","titles":["觀內懷仙"],"text":"玉架殘書隱，金壇舊跡迷。\n牽花尋紫澗，步葉下清谿。\n瓊漿猶類乳，石髓尚如泥。\n自能成羽翼，何必仰雲梯。"},"p41d520853b04-text-fed39918d2fbd44d8162":{"id":"p41d520853b04-text-fed39918d2fbd44d8162","person_id":"p41d520853b04","title":"山居晚眺贈王道士","titles":["山居晚眺贈王道士"],"text":"金壇疎俗宇，玉洞侶仙羣。\n花枝棲晚露，峰葉度晴雲。\n斜照移山影，回沙擁籀文。\n琴尊方待興，竹樹已迎曛。"},"p41d520853b04-text-8284944bd9e6b505df1c":{"id":"p41d520853b04-text-8284944bd9e6b505df1c","person_id":"p41d520853b04","title":"重別薛華","titles":["重別薛華"],"text":"明月沈珠浦，秋風濯錦川。\n樓臺臨絕岸，洲渚亙長天。\n旅泊成千里，棲遑共百年。\n窮途唯有淚，還望獨潸然。"},"p41d520853b04-text-7c5fa2cdca1fd7e62422":{"id":"p41d520853b04-text-7c5fa2cdca1fd7e62422","person_id":"p41d520853b04","title":"別人四首 二","titles":["別人四首 二"],"text":"江上風煙積，山幽雲霧多。\n送君南浦外，還望將如何。"},"p41d520853b04-text-9a28df6c908df9c45929":{"id":"p41d520853b04-text-9a28df6c908df9c45929","person_id":"p41d520853b04","title":"別人四首 三","titles":["別人四首 三"],"text":"桂軺雖不駐，蘭筵幸未開。\n林塘風月賞，還待故人來。"},"p41d520853b04-text-be5308e329d64c7cfd24":{"id":"p41d520853b04-text-be5308e329d64c7cfd24","person_id":"p41d520853b04","title":"別人四首 四","titles":["別人四首 四"],"text":"霜華淨天末，霧色籠江際。\n客子常畏人，何爲久留滯。"},"p41d520853b04-text-0c5ce8a6cf97b0a062f4":{"id":"p41d520853b04-text-0c5ce8a6cf97b0a062f4","person_id":"p41d520853b04","title":"春遊","titles":["春遊"],"text":"客念紛無極，春淚倍成行。\n今朝花樹下，不覺戀年光。"},"p41d520853b04-text-352f8f5c71e64d10f0b4":{"id":"p41d520853b04-text-352f8f5c71e64d10f0b4","person_id":"p41d520853b04","title":"羈春","titles":["羈春"],"text":"客心千里倦，春事一朝歸。\n還傷北園裏，重見落花飛。"},"p41d520853b04-text-ed1adf4059e21427f1c2":{"id":"p41d520853b04-text-ed1adf4059e21427f1c2","person_id":"p41d520853b04","title":"山中","titles":["山中"],"text":"長江悲已滯，萬里念將歸。\n況屬高風晚，山山黃葉飛。"},"p41d520853b04-text-618e92e9d68c9634b6dc":{"id":"p41d520853b04-text-618e92e9d68c9634b6dc","person_id":"p41d520853b04","title":"江亭夜月送別二首 一","titles":["江亭夜月送別二首 一"],"text":"江送巴南水，山橫塞北雲。\n津亭秋月夜，誰見泣離羣。"},"p41d520853b04-text-04edcbc6ef5946e306ec":{"id":"p41d520853b04-text-04edcbc6ef5946e306ec","person_id":"p41d520853b04","title":"江亭夜月送別二首 二","titles":["江亭夜月送別二首 二"],"text":"亂煙籠碧砌，飛月向南端。\n寂寂離亭掩，江山此夜寒。"},"p41d520853b04-text-79ac0ee6db0793157046":{"id":"p41d520853b04-text-79ac0ee6db0793157046","person_id":"p41d520853b04","title":"晚留鳳州","titles":["晚留鳳州"],"text":"寶雞辭舊役，仙鳳歷遺墟。\n去此近城闕，青山明月初。"},"p41d520853b04-text-442c971643bed7b0540e":{"id":"p41d520853b04-text-442c971643bed7b0540e","person_id":"p41d520853b04","title":"散關晨度","titles":["散關晨度"],"text":"關山凌旦開，石路無塵埃。\n白馬高譚去，青牛真氣來。\n重門臨巨壑，連棟起崇隈。\n即今揚策度，非是棄繻回。"},"p41d520853b04-text-985d87418ece9965280d":{"id":"p41d520853b04-text-985d87418ece9965280d","person_id":"p41d520853b04","title":"三月曲水宴得煙字","titles":["三月曲水宴得煙字"],"text":"彭澤官初去，河陽賦始傳。\n田園歸舊國，詩酒間長筵。\n列室窺丹洞，分樓瞰紫煙。\n縈回亙津渡，出沒控郊鄽。\n鳳琴調上客，龍轡儼羣仙。\n松石偏宜古，藤蘿不記年。\n重簷交密樹，複磴擁危泉。\n抗石晞南嶺，乘沙眇北川。\n傅巖來築處，磻谿入釣前。\n日斜真趣遠，幽思夢涼蟬。"},"p41d520853b04-text-769aa1a43ab72370d5e6":{"id":"p41d520853b04-text-769aa1a43ab72370d5e6","person_id":"p41d520853b04","title":"倬彼我系 二","titles":["倬彼我系 二"],"text":"晉曆崩坼，衣冠擾弊。\n粵自太原，播徂江澨。\n禮喪賢隱，時屯道閉。\n王室如燬，生人多殪。"},"p41d520853b04-text-a17633b69cc30b01c78a":{"id":"p41d520853b04-text-a17633b69cc30b01c78a","person_id":"p41d520853b04","title":"倬彼我系 三","titles":["倬彼我系 三"],"text":"伊我有器，思逢其主。\n自東施西，擇木開宇。\n田彼河曲，家乎汾浦。\n天未厭亂，吾將誰輔。"},"p41d520853b04-text-286113f44bff1f5408a6":{"id":"p41d520853b04-text-286113f44bff1f5408a6","person_id":"p41d520853b04","title":"倬彼我系 四","titles":["倬彼我系 四"],"text":"伊我祖德，思濟九埏。\n不常厥所，于茲五遷。\n欲及時也，夫豈願焉。\n其位雖屈，其言則傳。"},"p41d520853b04-text-ed89c9e5c87553e9b199":{"id":"p41d520853b04-text-ed89c9e5c87553e9b199","person_id":"p41d520853b04","title":"倬彼我系 五","titles":["倬彼我系 五"],"text":"爰述帝制，大蒐王道。\n曰天曰人，是祖是考。\n禮樂咸若，詩書具草。\n貽厥孫謀，永爲家寶。"},"p41d520853b04-text-c6d6ccb7011f2d975ece":{"id":"p41d520853b04-text-c6d6ccb7011f2d975ece","person_id":"p41d520853b04","title":"倬彼我系 七","titles":["倬彼我系 七"],"text":"來絏伊何，謂余曰仕。\n我瞻先達，三十方起。\n夫豈不懷，高山仰止。\n願言毓德，啜菽飲水。"},"p41d520853b04-text-e387b4c418849047d507":{"id":"p41d520853b04-text-e387b4c418849047d507","person_id":"p41d520853b04","title":"倬彼我系 八","titles":["倬彼我系 八"],"text":"有鳥反哺，其聲嗷嗷。\n言念舊德，憂心忉忉。\n今我不養，歲月其滔。\n僶俛從役，豈敢告勞。"},"p41d520853b04-text-6b7706e2171504fea468":{"id":"p41d520853b04-text-6b7706e2171504fea468","person_id":"p41d520853b04","title":"倬彼我系 九","titles":["倬彼我系 九"],"text":"從役伊何，薄求卑位。\n告勞伊何，來參卿事。\n名存實爽，負信愆義。\n靜言遐思，中心是愧。"},"p41d520853b04-text-a7a1cab95305e33d04e5":{"id":"p41d520853b04-text-a7a1cab95305e33d04e5","person_id":"p41d520853b04","title":"滕王閣","titles":["滕王閣"],"text":"滕王高閣臨江渚，珮玉鳴鸞罷歌舞。\n畫棟朝飛南浦雲，珠簾暮捲西山雨。\n閑雲潭影日悠悠，物換星移幾度秋。\n閣中帝子今何在？檻外長江空自流。"}}}
