s":[{"id":"p6bb1e6ed447c-item-3381edcea87a9f70ae95-part-01","status":"automatic","work_id":"p6bb1e6ed447c-text-e3c42d7dfbaaacc96ef9","title":"寄贈柳殿院開授崇儀使赴邊上"}]},"p6bb1e6ed447c-item-029d3f744a6e934e5cb9":{"id":"p6bb1e6ed447c-item-029d3f744a6e934e5cb9","person_id":"p6bb1e6ed447c","title":"中秋與柳贊善開宗贊善坦寇學士準宿宋拾遺白宅不見月","units":[{"id":"p6bb1e6ed447c-item-029d3f744a6e934e5cb9-part-01","status":"automatic","work_id":"p6bb1e6ed447c-text-68732a66081f7f52d51f","title":"中秋與柳贊善開宗贊善坦寇學士準宿宋拾遺白宅不見月"}]},"p6bb1e6ed447c-item-270303f2a88602234a27":{"id":"p6bb1e6ed447c-item-270303f2a88602234a27","person_id":"p6bb1e6ed447c","title":"送王長洲禹偁赴闕","units":[{"id":"p6bb1e6ed447c-item-270303f2a88602234a27-part-01","status":"automatic","work_id":"p6bb1e6ed447c-text-091ae97acdefc02ae5ee","title":"送王長洲禹偁赴闕"}]},"p6bb1e6ed447c-item-4d4262aa3d991764c6e7":{"id":"p6bb1e6ed447c-item-4d4262aa3d991764c6e7","person_id":"p6bb1e6ed447c","title":"闕下留別孫丁二學士歸舊山","units":[{"id":"p6bb1e6ed447c-item-4d4262aa3d991764c6e7-part-01","status":"automatic","work_id":"p6bb1e6ed447c-text-cc9cc72255ba33c5e406","title":"闕下留別孫丁二學士歸舊山"}]},"p6bb1e6ed447c-item-c10ca69209cca02394a6":{"id":"p6bb1e6ed447c-item-c10ca69209cca02394a6","person_id":"p6bb1e6ed447c","title":"送馮尊師德之出長安","units":[{"id":"p6bb1e6ed447c-item-c10ca69209cca02394a6-part-01","status":"automatic","work_id":"p6bb1e6ed447c-text-0bee87b851e2ff586e4b","title":"送馮尊師德之出長安"}]},"p6bb1e6ed447c-item-61ca722a234d6085103a":{"id":"p6bb1e6ed447c-item-61ca722a234d6085103a","person_id":"p6bb1e6ed447c","title":"","units":[]},"p6bb1e6ed447c-item-e3b7c75a6ece541efe5e":{"id":"p6bb1e6ed447c-item-e3b7c75a6ece541efe5e","person_id":"p6bb1e6ed447c","title":"","units":[]}},"works":{"p6bb1e6ed447c-text-e3c42d7dfbaaacc96ef9":{"id":"p6bb1e6ed447c-text-e3c42d7dfbaaacc96ef9","person_id":"p6bb1e6ed447c","title":"寄贈柳殿院開授崇儀使赴邊上","titles":["寄贈柳殿院開授崇儀使赴邊上"],"text":"從來長見說兵機，今日君恩志豈違。\n驄馬不騎騎鐵馬，繡衣休挂挂戎衣。\n雄師已聽心皆伏，醜虜將聞魄盡飛。\n應笑苦吟頭白者，二南章句轉衰微。"},"p6bb1e6ed447c-text-68732a66081f7f52d51f":{"id":"p6bb1e6ed447c-text-68732a66081f7f52d51f","person_id":"p6bb1e6ed447c","title":"中秋與柳贊善開宗贊善坦寇學士準宿宋拾遺白宅不見月","titles":["中秋與柳贊善開宗贊善坦寇學士準宿宋拾遺白宅不見月"],"text":"共約中秋來看月，一輪終不見清輝。\n衆人眠後唯孤坐，翻憶無雲宿翠微。"},"p6bb1e6ed447c-text-091ae97acdefc02ae5ee":{"id":"p6bb1e6ed447c-text-091ae97acdefc02ae5ee","person_id":"p6bb1e6ed447c","title":"送王長洲禹偁赴闕","titles":["送王長洲禹偁赴闕"],"text":"蒿蘭不並香，涇渭安同流。\n小人有千險，君子生百憂。\n名重聖主徵，道光史策收。\n一鶚秋空飛，鳥雀徒啾啾。"},"p6bb1e6ed447c-text-cc9cc72255ba33c5e406":{"id":"p6bb1e6ed447c-text-cc9cc72255ba33c5e406","person_id":"p6bb1e6ed447c","title":"闕下留別孫丁二學士歸舊山","titles":["闕下留別孫丁二學士歸舊山"],"text":"名利路萬轍，我來意如何。\n紅塵三尺深，中有是非波。\n波翻幾潛沒，來者猶更過。\n歸去感知淚，永灑青松柯。"},"p6bb1e6ed447c-text-0bee87b851e2ff586e4b":{"id":"p6bb1e6ed447c-text-0bee87b851e2ff586e4b","person_id":"p6bb1e6ed447c","title":"送馮尊師德之出長安","titles":["送馮尊師德之出長安"],"text":"浩浩霜風萬木寒，高吟大醉出長安。\n杖頭一卷金丹訣，塵世何人借得看。"}}}
