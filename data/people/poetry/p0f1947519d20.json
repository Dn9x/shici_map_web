{"id":"p0f1947519d20-item-4e1a7f59e55e2772c633-part-01","status":"automatic","work_id":"p0f1947519d20-text-f89f363b5990d1e18b6a","title":"贈學仙者"}]},"p0f1947519d20-item-00328427a1d49188c856":{"id":"p0f1947519d20-item-00328427a1d49188c856","person_id":"p0f1947519d20","title":"遊仙四首 一 / 遊仙四首 二 / 遊仙四首 三 / 遊仙四首 四","units":[{"id":"p0f1947519d20-item-00328427a1d49188c856-part-01","status":"automatic","work_id":"p0f1947519d20-text-d8edfdad2ef41e9695a6","title":"遊仙四首 一"},{"id":"p0f1947519d20-item-00328427a1d49188c856-part-02","status":"automatic","work_id":"p0f1947519d20-text-0a0b5e6771d6ceed438c","title":"遊仙四首 二"},{"id":"p0f1947519d20-item-00328427a1d49188c856-part-03","status":"automatic","work_id":"p0f1947519d20-text-26ebdf95bc186e452a0d","title":"遊仙四首 三"},{"id":"p0f1947519d20-item-00328427a1d49188c856-part-04","status":"automatic","work_id":"p0f1947519d20-text-1fd8816acd4721364fff","title":"遊仙四首 四"}]},"p0f1947519d20-item-f4df8fcd4d7761353aee":{"id":"p0f1947519d20-item-f4df8fcd4d7761353aee","person_id":"p0f1947519d20","title":"策杖尋隱士","units":[{"id":"p0f1947519d20-item-f4df8fcd4d7761353aee-part-01","status":"automatic","work_id":"p0f1947519d20-text-89db95d8b7997446e413","title":"策杖尋隱士"}]},"p0f1947519d20-item-b041a63723d90b8e8397":{"id":"p0f1947519d20-item-b041a63723d90b8e8397","person_id":"p0f1947519d20","title":"","units":[]},"p0f1947519d20-item-f43d625f195f6792c5b0":{"id":"p0f1947519d20-item-f43d625f195f6792c5b0","person_id":"p0f1947519d20","title":"","units":[]}},"works":{"p0f1947519d20-text-88455282a18619d590f0":{"id":"p0f1947519d20-text-88455282a18619d590f0","person_id":"p0f1947519d20","title":"野望","titles":["野望"],"text":"東皐薄暮望，徙倚欲何依。\n樹樹皆秋色，山山唯落暉。\n牧人驅犢返，獵馬帶禽歸。\n相顧無相識，長歌懷采薇。"},"p0f1947519d20-text-deb9eb500f2493d470ef":{"id":"p0f1947519d20-text-deb9eb500f2493d470ef","person_id":"p0f1947519d20","title":"薛記室收過莊見尋率題古意以贈","titles":["薛記室收過莊見尋率題古意以贈"],"text":"伊昔逢喪亂，曆數閏當餘。\n豺狼塞衢路，桑梓成丘墟。\n余及爾皆亡，東西各異居。\n爾爲背風鳥，我爲涸轍魚。\n逮承雲雷後，欣逢天地初。\n東川聊下釣，南畝試揮鋤。\n資稅幸不及，伏臘常有儲。\n散誕時須酒，蕭條嬾向書。\n朽木不可雕，短翮將焉攄。\n故人有深契，過我蓬高廬。\n曳裾出門迎，握手登前除。\n相看非舊顏，忽若形骸疎。\n追道宿昔事，切切心相於。\n憶我少年時，攜手遊東渠。\n梅李夾兩岸，花枝何扶疏。\n同志亦不多，西莊有姚徐。\n嘗愛陶淵明，酌醴焚枯魚。\n嘗學公孫弘，策杖牧羣豬。\n追念甫如昨，奄忽成空虛。\n人生詎能幾，歲歲常不舒。\n賴有北山僧，教我以真如。\n使我視聽遣，自覺塵累祛。\n何事須筌蹄，今已得兔魚。\n舊遊儻多暇，同此釋紛拏。"},"p0f1947519d20-text-6fd962a7336341ac8038":{"id":"p0f1947519d20-text-6fd962a7336341ac8038","person_id":"p0f1947519d20","title":"春桂問荅二首 一","titles":["春桂問荅二首 一"],"text":"問春桂：桃李正芬華，年光隨處滿，何事獨無花。"},"p0f1947519d20-text-0d13eb22fbfecd0e6c10":{"id":"p0f1947519d20-text-0d13eb22fbfecd0e6c10","person_id":"p0f1947519d20","title":"春桂問荅二首 二","titles":["春桂問荅二首 二"],"text":"春桂荅：春華詎能久，風霜搖落時，獨秀君知不。"},"p0f1947519d20-text-7394beda22c500f4ad58":{"id":"p0f1947519d20-text-7394beda22c500f4ad58","person_id":"p0f1947519d20","title":"建德破後入長安詠秋蓬示辛學士","titles":["建德破後入長安詠秋蓬示辛學士"],"text":"遇坎聊知止，逢風或未歸。\n孤根何處斷？輕葉強能飛。"},"p0f1947519d20-text-f2bfb22f1a0afeeb3734":{"id":"p0f1947519d20-text-f2bfb22f1a0afeeb3734","person_id":"p0f1947519d20","title":"在京思故園見鄉人問","titles":["在京思故園見鄉人問"],"text":"旅泊多年歲，老去不知迴。\n忽逢門前客，道發故鄉來。\n斂眉俱握手，破涕共銜杯。\n殷勤訪朋舊，屈曲問童孩。\n衰宗多弟姪，若箇賞池臺。\n舊園今在否，新樹也應栽。\n柳行疎密布，茅齋寬窄裁。\n經移何處竹？別種幾株梅。\n渠當無絕水，石計總生苔。\n院果誰先熟，林花那後開。\n羇心祗欲問，爲報不須猜。\n行當驅下澤，去剪故園萊。"},"p0f1947519d20-text-853ea3e48010244aa53c":{"id":"p0f1947519d20-text-853ea3e48010244aa53c","person_id":"p0f1947519d20","title":"春日","titles":["春日"],"text":"前旦出園遊，林華都未有。\n今朝下堂來，池冰開已久。\n雪被南軒梅，風催北庭柳。\n遙呼竈前妾，却報機中婦。\n年光恰恰來，滿甕營春酒。"},"p0f1947519d20-text-f2d63ac223b9975092f4":{"id":"p0f1947519d20-text-f2d63ac223b9975092f4","person_id":"p0f1947519d20","title":"贈程處士","titles":["贈程處士"],"text":"百年長擾擾，萬事悉悠悠。\n日光隨意落，河水任情流。\n禮樂囚姬旦，詩書縛孔丘。\n不如高枕枕，時取醉消愁。"},"p0f1947519d20-text-35f681d1b3419daacfdd":{"id":"p0f1947519d20-text-35f681d1b3419daacfdd","person_id":"p0f1947519d20","title":"田家三首 三","titles":["田家三首 三"],"text":"平生唯酒樂，作性不能無。\n朝朝訪鄉里，夜夜遣人酤。\n家貧留客久，不暇道精麤。\n抽簾持益炬，拔簀更燃爐。\n恆聞飲不足，何見有殘壺。"},"p0f1947519d20-text-a386b25094ffff093454":{"id":"p0f1947519d20-text-a386b25094ffff093454","person_id":"p0f1947519d20","title":"食後","titles":["食後"],"text":"田家無所有，晚食遂爲常。\n菜剪三秋綠，飧炊百日黃。\n胡麻山麨樣，楚豆野麋方。\n始暴松皮脯，新添杜若漿。\n葛花消酒毒，萸蔕發羹香。\n鼓腹聊乘興，寧知逢世昌。"},"p0f1947519d20-text-b61f465d455e513d3e41":{"id":"p0f1947519d20-text-b61f465d455e513d3e41","person_id":"p0f1947519d20","title":"夜還東溪","titles":["夜還東溪"],"text":"石苔應可踐，叢枝幸易攀。\n青溪歸路直，乘月夜歌還。"},"p0f1947519d20-text-84f6d2f524472f6ccead":{"id":"p0f1947519d20-text-84f6d2f524472f6ccead","person_id":"p0f1947519d20","title":"黃頰山","titles":["黃頰山"],"text":"別有青溪道，斜亙碧巖隈。\n崩榛橫古蔓，荒石擁寒苔。\n野心長寂寞，山徑本幽迴。\n步步攀藤上，朝朝負藥來。\n幾看松葉秀，頻值菊花開。\n無人堪作伴，歲晚獨悠哉。"},"p0f1947519d20-text-b763a7f195c6ebbe729f":{"id":"p0f1947519d20-text-b763a7f195c6ebbe729f","person_id":"p0f1947519d20","title":"採藥","titles":["採藥"],"text":"野情貪藥餌，郊居倦蓬蓽。\n青龍護道符，白犬遊仙術。\n腰鎌戊己月，負鍤庚辛日。\n時時斷嶂遮，往往孤峰出。\n行披葛仙經，坐檢神農帙。\n龜蛇採二苓，赤白尋雙朮。\n地凍根難盡，藂枯苗易失。\n從容肉作名，薯蕷高成質。\n家豐松葉酒，器貯參花蜜。\n且復歸去來，刀圭輔衰疾。"},"p0f1947519d20-text-d0f0c4c105079a77b21d":{"id":"p0f1947519d20-text-d0f0c4c105079a77b21d","person_id":"p0f1947519d20","title":"贈李徵君大壽","titles":["贈李徵君大壽"],"text":"孔淳辭散騎，陸昶謝中郎。\n幅巾朝帝罷，杖策去官忙。\n附車還趙郡，乘船向武昌。\n九徵書未已，十辟譽彌彰。\n副君迎綺季，天子送嚴光。\n灞陵幽徑近，磻谿隱路長。\n編蓬還作室，績草更爲裳。\n會稽置樵處，蘭陵賣藥行。\n看書惟道德，開教止農桑。\n別有幽懷侶，由來高讓王。\n前年辭厚幣，今歲返寒鄉。\n有書橫石架，無氈坐土牀。\n蘭英猶足釀，竹實本無糧。\n澗松寒轉直，山菊秋自香。\n管寧存祭禮，王霸重朝章。\n去去相隨去，披裘驕盛唐。"},"p0f1947519d20-text-20a5a1feb00d0b28b11e":{"id":"p0f1947519d20-text-20a5a1feb00d0b28b11e","person_id":"p0f1947519d20","title":"山中別李處士","titles":["山中別李處士"],"text":"爲向東溪道，人來路漸賒。\n山中春酒熟，何處得停家。"},"p0f1947519d20-text-dbf9f6605db1ea611ccc":{"id":"p0f1947519d20-text-dbf9f6605db1ea611ccc","person_id":"p0f1947519d20","title":"贈梁公","titles":["贈梁公"],"text":"我欲圖世樂，斯樂難可常。\n位大招譏嫌，祿極生禍殃。\n聖莫若周公，忠豈踰霍光。\n成王已興誚，宣帝如負芒。\n范蠡何智哉，單舟戒輕裝。\n疏廣豈不懷，策杖還故鄉。\n朱門雖足悅，赤族亦可傷。\n履霜成堅冰，知足勝不祥。\n我今窮家子，自言此見長。\n功成皆能退，在昔誰滅亡。"},"p0f1947519d20-text-86d1cf937a4c1171da51":{"id":"p0f1947519d20-text-86d1cf937a4c1171da51","person_id":"p0f1947519d20","title":"晚年敍志示翟處士","titles":["晚年敍志示翟處士"],"text":"弱齡慕奇調，無事不兼修。\n望氣登重閣，占星上小樓。\n明經思待詔，學劍覓封侯。\n棄繻頻北上，懷刺幾西遊。\n中年逢喪亂，非復昔追求。\n失路青門隱，藏名白社遊。\n風雲私所愛，屠博暗爲儔。\n解紛曾霸越，釋難頗存周。\n晚歲聊長想，生涯太若浮。\n歸來南畝上，更坐北溪頭。\n古岸多磐石，春泉足細流。\n東隅誠已謝，西景懼難收。\n無謂退耕近，伏念已經秋。\n庚桑逢處跪，陶潛見人羞。\n三晨寧舉火，五月鎮披裘。\n自有居常樂，誰知身世憂。"},"p0f1947519d20-text-26b4a770bf3e811c4b01":{"id":"p0f1947519d20-text-26b4a770bf3e811c4b01","person_id":"p0f1947519d20","title":"北山","titles":["北山"],"text":"舊知山裏絕氛埃，登高日暮心悠哉。\n子平一去何時返？仲叔長遊遂不來。\n幽蘭獨夜清琴曲，桂樹凌雲濁酒杯。\n槁項同枯木，丹心等死灰。"},"p0f1947519d20-text-3b0afaa6331973c8d0ff":{"id":"p0f1947519d20-text-3b0afaa6331973c8d0ff","person_id":"p0f1947519d20","title":"獨坐","titles":["獨坐"],"text":"問君樽酒外，獨坐更何須。\n有客談名理，無人索地租。\n三男婚令族，五女嫁賢夫。\n百年隨分了，未羨陟方壺。"},"p0f1947519d20-text-31f50831179c6f69f0fa":{"id":"p0f1947519d20-text-31f50831179c6f69f0fa","person_id":"p0f1947519d20","title":"過酒家五首 一","titles":["過酒家五首 一"],"text":"洛陽無大宅，長安乏主人。\n黃金銷未盡，祗爲酒家貧。"},"p0f1947519d20-text-db447e7ff866dfee548e":{"id":"p0f1947519d20-text-db447e7ff866dfee548e","person_id":"p0f1947519d20","title":"過酒家五首 二","titles":["過酒家五首 二"],"text":"此日長昏飲，非關養性靈。\n眼看人盡醉，何忍獨爲醒。"},"p0f1947519d20-text-39d2a94aa33d374fde05":{"id":"p0f1947519d20-text-39d2a94aa33d374fde05","person_id":"p0f1947519d20","title":"過酒家五首 三","titles":["過酒家五首 三"],"text":"竹葉連糟翠，蒲萄帶麴紅。\n相逢不令盡，別後爲誰空。"},"p0f1947519d20-text-15d48a0ad30c4b82ab27":{"id":"p0f1947519d20-text-15d48a0ad30c4b82ab27","person_id":"p0f1947519d20","title":"嘗春酒","titles":["嘗春酒"],"text":"野觴浮鄭酌，山酒漉陶巾。\n但令千日醉，何惜兩三春。"},"p0f1947519d20-text-22da1ad75ff1e84d22c2":{"id":"p0f1947519d20-text-22da1ad75ff1e84d22c2","person_id":"p0f1947519d20","title":"初春","titles":["初春"],"text":"春來日漸長，醉客喜年光。\n稍覺池亭好，偏宜酒甕香。"},"p0f1947519d20-text-b45264f45b3a02e8abae":{"id":"p0f1947519d20-text-b45264f45b3a02e8abae","person_id":"p0f1947519d20","title":"山夜調琴","titles":["山夜調琴"],"text":"促軫乘明月，抽弦對白雲。\n從來山水韻，不使俗人聞。"},"p0f1947519d20-text-986c98e57b760de8e2d8":{"id":"p0f1947519d20-text-986c98e57b760de8e2d8","person_id":"p0f1947519d20","title":"看釀酒","titles":["看釀酒"],"text":"六月調神麴，正朝汲美泉。\n從來作春酒，未省不經年。"},"p0f1947519d20-text-f58408ae2788507226cc":{"id":"p0f1947519d20-text-f58408ae2788507226cc","person_id":"p0f1947519d20","title":"戲題卜鋪壁","titles":["戲題卜鋪壁"],"text":"旦逐劉伶去，宵隨畢卓眠。\n不應長賣卜，須得杖頭錢。"},"p0f1947519d20-text-f89f363b5990d1e18b6a":{"id":"p0f1947519d20-text-f89f363b5990d1e18b6a","person_id":"p0f1947519d20","title":"贈學仙者","titles":["贈學仙者"],"text":"採藥層城遠，尋師海路賒。\n玉壺橫日月，金闕斷煙霞。\n仙人何處在？道士未還家。\n誰知彭澤意，更覔步兵那。\n春釀煎松葉，秋杯浸菊花。\n相逢寧可醉，定不學丹砂。"},"p0f1947519d20-text-d8edfdad2ef41e9695a6":{"id":"p0f1947519d20-text-d8edfdad2ef41e9695a6","person_id":"p0f1947519d20","title":"遊仙四首 一","titles":["遊仙四首 一"],"text":"暫出東陂路，過訪北巖前。\n蔡經新學道，王烈舊成仙。\n駕鶴來無日，乘龍去幾年。\n三山銀作地，八洞玉爲天。\n金精飛欲盡，石髓溜應堅。\n自悲生世促，無暇待桑田。"},"p0f1947519d20-text-0a0b5e6771d6ceed438c":{"id":"p0f1947519d20-text-0a0b5e6771d6ceed438c","person_id":"p0f1947519d20","title":"遊仙四首 二","titles":["遊仙四首 二"],"text":"上月芝蘭徑，中巖紫翠房。\n金壺新練乳，玉釜始煎香。\n六局黃公術，三門赤帝方。\n吹沙聊作鳥，動石試爲羊。\n緱氏還程促，瀛洲會日長。\n誰知北巖下，延首詠霓裳。"},"p0f1947519d20-text-26ebdf95bc186e452a0d":{"id":"p0f1947519d20-text-26ebdf95bc186e452a0d","person_id":"p0f1947519d20","title":"遊仙四首 三","titles":["遊仙四首 三"],"text":"結衣尋野路，負杖入山門。\n道士言無宅，仙人更有村。\n斜溪橫桂渚，小徑入桃源。\n玉牀塵稍冷，金爐火尚溫。\n心疑遊北極，望似陟西崑。\n逆愁歸舊里，蕭條訪子孫。"},"p0f1947519d20-text-1fd8816acd4721364fff":{"id":"p0f1947519d20-text-1fd8816acd4721364fff","person_id":"p0f1947519d20","title":"遊仙四首 四","titles":["遊仙四首 四"],"text":"真經知那是，仙骨定何爲。\n許邁心長切，嵇康命似奇。\n桑疎金闕迥，苔重石梁危。\n照水然犀角，遊山費虎皮。\n鴨桃聞已種，龍竹未經騎。\n爲向天仙道，棲遑君詎知。"},"p0f1947519d20-text-89db95d8b7997446e413":{"id":"p0f1947519d20-text-89db95d8b7997446e413","person_id":"p0f1947519d20","title":"策杖尋隱士","titles":["策杖尋隱士"],"text":"策杖尋隱士，行行路漸賒。\n石梁橫澗斷，土室映山斜。\n孝然縱有舍，威輦遂無家。\n置酒燒枯葉，披書坐落花。\n新垂滋水釣，舊結茂陵罝。\n歲歲長如此，方知輕世華。"}}}
