05","title":"柔卿解籍戲呈飛卿三首 三"}]},"p067895806a8a-item-650f895284c70017aed9":{"id":"p067895806a8a-item-650f895284c70017aed9","person_id":"p067895806a8a","title":"嘲飛卿七首 一 / 嘲飛卿七首 二 / 嘲飛卿七首 三 / 嘲飛卿七首 五 / 嘲飛卿七首 六 / 嘲飛卿七首 七 / 嘲飛卿七首 四","units":[{"id":"p067895806a8a-item-650f895284c70017aed9-part-01","status":"automatic","work_id":"p067895806a8a-text-5009ef2b554bed2ccb03","title":"嘲飛卿七首 一"},{"id":"p067895806a8a-item-650f895284c70017aed9-part-02","status":"automatic","work_id":"p067895806a8a-text-4ef89a5e0cd7e0502b68","title":"嘲飛卿七首 二"},{"id":"p067895806a8a-item-650f895284c70017aed9-part-03","status":"automatic","work_id":"p067895806a8a-text-67d8f7f080b05de8b7a4","title":"嘲飛卿七首 三"},{"id":"p067895806a8a-item-650f895284c70017aed9-part-04","status":"automatic","work_id":"p067895806a8a-text-a22bda4607258e2faa7b","title":"嘲飛卿七首 五"},{"id":"p067895806a8a-item-650f895284c70017aed9-part-05","status":"automatic","work_id":"p067895806a8a-text-f789829158c0f1967e71","title":"嘲飛卿七首 六"},{"id":"p067895806a8a-item-650f895284c70017aed9-part-06","status":"automatic","work_id":"p067895806a8a-text-9158f4a685ced6698928","title":"嘲飛卿七首 七"},{"id":"p067895806a8a-item-650f895284c70017aed9-part-07","status":"automatic","work_id":"p067895806a8a-text-a0cbf4265b54f509ea6f","title":"嘲飛卿七首 四"}]},"p067895806a8a-item-c42b2c73c537acd99546":{"id":"p067895806a8a-item-c42b2c73c537acd99546","person_id":"p067895806a8a","title":"送穆郎中赴闕","units":[{"id":"p067895806a8a-item-c42b2c73c537acd99546-part-01","status":"automatic","work_id":"p067895806a8a-text-8e21277c5663bbf2b479","title":"送穆郎中赴闕"}]},"p067895806a8a-item-f027172567dc6bd23723":{"id":"p067895806a8a-item-f027172567dc6bd23723","person_id":"p067895806a8a","title":"","units":[]},"p067895806a8a-item-dbe4c638ce60e69c5e25":{"id":"p067895806a8a-item-dbe4c638ce60e69c5e25","person_id":"p067895806a8a","title":"題僧壁","units":[{"id":"p067895806a8a-item-dbe4c638ce60e69c5e25-part-01","status":"automatic","work_id":"p067895806a8a-text-0cfdf52e21a46ea35feb","title":"題僧壁"}]},"p067895806a8a-item-efea651aa60adf7a0df0":{"id":"p067895806a8a-item-efea651aa60adf7a0df0","person_id":"p067895806a8a","title":"寄溫飛卿牋紙","units":[{"id":"p067895806a8a-item-efea651aa60adf7a0df0-part-01","status":"automatic","work_id":"p067895806a8a-text-a0eb0b9cc6718fe2032d","title":"寄溫飛卿牋紙"}]},"p067895806a8a-item-2231a99725638430c328":{"id":"p067895806a8a-item-2231a99725638430c328","person_id":"p067895806a8a","title":"","units":[]},"p067895806a8a-item-2b4805c442c4a0b56077":{"id":"p067895806a8a-item-2b4805c442c4a0b56077","person_id":"p067895806a8a","title":"","units":[]},"p067895806a8a-item-4deee7e096dcce19ff6f":{"id":"p067895806a8a-item-4deee7e096dcce19ff6f","person_id":"p067895806a8a","title":"哭李羣玉","units":[{"id":"p067895806a8a-item-4deee7e096dcce19ff6f-part-01","status":"automatic","work_id":"p067895806a8a-text-798d6e18f1962edc450c","title":"哭李羣玉"}]},"p067895806a8a-item-b84a233d75b7a51a2a7e":{"id":"p067895806a8a-item-b84a233d75b7a51a2a7e","person_id":"p067895806a8a","title":"哭李羣玉","units":[{"id":"p067895806a8a-item-b84a233d75b7a51a2a7e-part-01","status":"automatic","work_id":"p067895806a8a-text-67d92f35dcc1565f22af","title":"哭李羣玉"}]}},"works":{"p067895806a8a-text-e622ca8e8ba85ac679de":{"id":"p067895806a8a-text-e622ca8e8ba85ac679de","person_id":"p067895806a8a","title":"猨","titles":["猨"],"text":"却憶書齋值晚晴，挽枝閑嘯激蟬清。\n影沈巴峽夜巖色，蹤絕石塘寒瀨聲。"},"p067895806a8a-text-ecabf1972a8a0e1d8dfc":{"id":"p067895806a8a-text-ecabf1972a8a0e1d8dfc","person_id":"p067895806a8a","title":"河出榮光","titles":["河出榮光"],"text":"符命自陶唐，吾君應會昌。\n千年清德水，九折滿榮花。\n極岸浮佳氣，微波照夕陽。\n澄輝明貝闕，散彩入龍堂。\n近帶關雲紫，遙連日道黃。\n馮夷矜海若，漢武貴宣房。\n漸沒孤槎影，仍呈一葦航。\n撫躬悲未濟，作頌喜時康。"},"p067895806a8a-text-05ade9cb10feeff1f775":{"id":"p067895806a8a-text-05ade9cb10feeff1f775","person_id":"p067895806a8a","title":"遊長安諸寺聯句 招國坊崇濟寺 奇松聯二十字絕句","titles":["遊長安諸寺聯句 招國坊崇濟寺 奇松聯二十字絕句"],"text":"杉松何相疎，榆柳方迥屑。\n無人擅談柄，一枝不敢折。\n中庭苔蘚深，吹餘鳴佛禽。\n至於摧折枝，凡草猶避陰。\n僻徑根從露，閑房枝任侵。\n一株風正好，來助碧雲吟。\n時時埽窗聲，重露滴寒砌。\n風颭一枝遒，閑窺別生勢。\n偃蓋入樓妨，盤根侵井窄。\n高僧獨惆悵，爲與澄嵐隔。"},"p067895806a8a-text-2b9913d9e4160516024c":{"id":"p067895806a8a-text-2b9913d9e4160516024c","person_id":"p067895806a8a","title":"遊長安諸寺聯句 崇仁坊資聖寺 諸畫聯句","titles":["遊長安諸寺聯句 崇仁坊資聖寺 諸畫聯句"],"text":"吳生畫勇矛戟攢，出變奇勢千萬端。\n蒼蒼鬼怪層壁寬，覩之忽忽毛髮寒。\n稜伽之力所疲殫，李真周昉優劣難。\n活禽生卉推邊鸞，花房嫩彩猶未乾。\n韓幹變態如激湍，惜哉壁畫世未殫。\n後人新畫何汗漫。"},"p067895806a8a-text-acfb915baef195d7b1c6":{"id":"p067895806a8a-text-acfb915baef195d7b1c6","person_id":"p067895806a8a","title":"送僧二首 一","titles":["送僧二首 一"],"text":"形神不滅論初成，愛馬乘閑入帝京。\n四十三年虛過了，方知僧裏有唐生。"},"p067895806a8a-text-10ae48f547b89719fddf":{"id":"p067895806a8a-text-10ae48f547b89719fddf","person_id":"p067895806a8a","title":"送僧二首 二","titles":["送僧二首 二"],"text":"想到頭陀最上方，桂陰猶認惠宗房。\n因行戀燒歸來晚，窗下猶殘一字香。"},"p067895806a8a-text-cc39e4483c69eb092f2c":{"id":"p067895806a8a-text-cc39e4483c69eb092f2c","person_id":"p067895806a8a","title":"題谷隱蘭若三首 一","titles":["題谷隱蘭若三首 一"],"text":"風惹閑雲半谷陰，巖西隱者醉相尋。\n草衰乍覺徑增險，葉盡却疑溪不深。"},"p067895806a8a-text-71d080614b7e96cb4268":{"id":"p067895806a8a-text-71d080614b7e96cb4268","person_id":"p067895806a8a","title":"題谷隱蘭若三首 二","titles":["題谷隱蘭若三首 二"],"text":"鳥啄靈雛戀落暉，村情山趣頓忘機。\n丹成道士過門數，葉盡寒猨下嶺稀。"},"p067895806a8a-text-82505a71fc696d617bf5":{"id":"p067895806a8a-text-82505a71fc696d617bf5","person_id":"p067895806a8a","title":"和周繇見嘲","titles":["和周繇見嘲"],"text":"才甘魚目並，藝怯馬蹄間。\n王謝初飛蓋，姬姜盡下山。\n縛雞方角逐，射雉豈開顏。\n亂翠移林色，狂紅照座殷。\n防梭齒雖在，乞帽鬢慙斑。\n儻恕相如瘦，應容累騎還。"},"p067895806a8a-text-c0a76c7b8e0b1a808d6a":{"id":"p067895806a8a-text-c0a76c7b8e0b1a808d6a","person_id":"p067895806a8a","title":"寄周繇求人參","titles":["寄周繇求人參"],"text":"少賦令才猶強作，衆醫多識不能呼。\n九莖仙草真難得，五葉靈根許惠無。"},"p067895806a8a-text-0952afcaedd38baa3427":{"id":"p067895806a8a-text-0952afcaedd38baa3427","person_id":"p067895806a8a","title":"嘲元中丞","titles":["嘲元中丞"],"text":"鶯裏花前選孟光，東山逋客酒初狂。\n素蛾畢竟難防備，燒得河車莫遣嘗。"},"p067895806a8a-text-1282643702db8d4068fe":{"id":"p067895806a8a-text-1282643702db8d4068fe","person_id":"p067895806a8a","title":"不赴光風亭夜飲贈周繇","titles":["不赴光風亭夜飲贈周繇"],"text":"屏開屈膝見吳娃，蠻蠟同心四照花。\n姹女不愁難管領，斬新鉛裏得黃牙。"},"p067895806a8a-text-0c992b0150a7ef9d2256":{"id":"p067895806a8a-text-0c992b0150a7ef9d2256","person_id":"p067895806a8a","title":"觀山燈獻徐尚書 一","titles":["觀山燈獻徐尚書 一"],"text":"風杪影凌亂，露輕光陸離。\n如霞散仙掌，似燒上峨嵋。\n道樹千花發，扶桑九日移。\n因山成衆像，不復藉蟠螭。"},"p067895806a8a-text-bcfda06f290aac290ea3":{"id":"p067895806a8a-text-bcfda06f290aac290ea3","person_id":"p067895806a8a","title":"觀山燈獻徐尚書 二","titles":["觀山燈獻徐尚書 二"],"text":"湧出多寶塔，往來飛錫僧。\n分明三五月，傳照百千燈。\n馴狖移高柱，慶雲遮半層。\n夜深寒焰白，猶自綴金繩。"},"p067895806a8a-text-dc036c5723910ce01c8c":{"id":"p067895806a8a-text-dc036c5723910ce01c8c","person_id":"p067895806a8a","title":"柔卿解籍戲呈飛卿三首 一","titles":["柔卿解籍戲呈飛卿三首 一"],"text":"長擔犢車初入門，金牙新醞盈深罇。\n良人爲漬木瓜粉，遮却紅腮交午痕。"},"p067895806a8a-text-b833541ae190e37f1031":{"id":"p067895806a8a-text-b833541ae190e37f1031","person_id":"p067895806a8a","title":"柔卿解籍戲呈飛卿三首 二","titles":["柔卿解籍戲呈飛卿三首 二"],"text":"最宜全幅碧鮫綃，自襞春羅等舞腰。\n未有長錢求鄴錦，且令裁取一團嬌。"},"p067895806a8a-text-06318814c0f93e12f305":{"id":"p067895806a8a-text-06318814c0f93e12f305","person_id":"p067895806a8a","title":"柔卿解籍戲呈飛卿三首 三","titles":["柔卿解籍戲呈飛卿三首 三"],"text":"出意挑鬟一尺長，金爲鈿鳥簇釵梁。\n鬱金種得花茸細，添入春衫領裏香。"},"p067895806a8a-text-5009ef2b554bed2ccb03":{"id":"p067895806a8a-text-5009ef2b554bed2ccb03","person_id":"p067895806a8a","title":"嘲飛卿七首 一","titles":["嘲飛卿七首 一"],"text":"曾見當壚一箇人，入時裝束好腰身。\n少年花蔕多芳思，只向詩中寫取真。"},"p067895806a8a-text-4ef89a5e0cd7e0502b68":{"id":"p067895806a8a-text-4ef89a5e0cd7e0502b68","person_id":"p067895806a8a","title":"嘲飛卿七首 二","titles":["嘲飛卿七首 二"],"text":"醉袂幾侵魚子纈，飄纓長罥鳳皇釵。\n知君欲作閑情賦，應願將身作錦鞋。"},"p067895806a8a-text-67d8f7f080b05de8b7a4":{"id":"p067895806a8a-text-67d8f7f080b05de8b7a4","person_id":"p067895806a8a","title":"嘲飛卿七首 三","titles":["嘲飛卿七首 三"],"text":"翠蝶密偎金叉首，青蟲危泊玉釵梁。\n愁生半額不開靨，只爲多情團扇郎。"},"p067895806a8a-text-a22bda4607258e2faa7b":{"id":"p067895806a8a-text-a22bda4607258e2faa7b","person_id":"p067895806a8a","title":"嘲飛卿七首 五","titles":["嘲飛卿七首 五"],"text":"愁機嬾織同心苣，悶繡先描連理枝。\n多少風流詞句裏，愁中空詠早環詩。"},"p067895806a8a-text-f789829158c0f1967e71":{"id":"p067895806a8a-text-f789829158c0f1967e71","person_id":"p067895806a8a","title":"嘲飛卿七首 六","titles":["嘲飛卿七首 六"],"text":"燕支山色重能輕，南陽水澤鬬分明。\n不煩射雉先張翳，自有琴中威鳳聲。"},"p067895806a8a-text-9158f4a685ced6698928":{"id":"p067895806a8a-text-9158f4a685ced6698928","person_id":"p067895806a8a","title":"嘲飛卿七首 七","titles":["嘲飛卿七首 七"],"text":"半歲愁中鏡似荷，牽環撩鬢却須磨。\n花前不復抱瓶渴，月底還應琢刺歌。"},"p067895806a8a-text-a0cbf4265b54f509ea6f":{"id":"p067895806a8a-text-a0cbf4265b54f509ea6f","person_id":"p067895806a8a","title":"嘲飛卿七首 四","titles":["嘲飛卿七首 四"],"text":"柳煙梅雪隱青樓，殘日黃鸝語未休。\n見說自能裁袙腹，不知誰更著帩頭。"},"p067895806a8a-text-8e21277c5663bbf2b479":{"id":"p067895806a8a-text-8e21277c5663bbf2b479","person_id":"p067895806a8a","title":"送穆郎中赴闕","titles":["送穆郎中赴闕"],"text":"應念愁中恨索居，鸝歌聲裏且踟蹰。\n若逢金馬門前客，爲說虞卿久著書。"},"p067895806a8a-text-0cfdf52e21a46ea35feb":{"id":"p067895806a8a-text-0cfdf52e21a46ea35feb","person_id":"p067895806a8a","title":"題僧壁","titles":["題僧壁"],"text":"有僧支頰撚眉毫，起就夕陽磨剃刀。\n到此既知閑最樂，俗心何啻九牛毛。"},"p067895806a8a-text-a0eb0b9cc6718fe2032d":{"id":"p067895806a8a-text-a0eb0b9cc6718fe2032d","person_id":"p067895806a8a","title":"寄溫飛卿牋紙","titles":["寄溫飛卿牋紙"],"text":"三十六鱗充使時，數番猶得裹相思。\n待將袍襖重抄了，盡寫襄陽播掿詞。"},"p067895806a8a-text-798d6e18f1962edc450c":{"id":"p067895806a8a-text-798d6e18f1962edc450c","person_id":"p067895806a8a","title":"哭李羣玉","titles":["哭李羣玉"],"text":"曾話黃陵事，今爲白日摧。\n老無兒女累，誰哭到泉臺。"},"p067895806a8a-text-67d92f35dcc1565f22af":{"id":"p067895806a8a-text-67d92f35dcc1565f22af","person_id":"p067895806a8a","title":"哭李羣玉","titles":["哭李羣玉"],"text":"酒裏詩中三十年，縱橫唐突世喧喧。\n明時不作禰衡死，傲盡公卿歸九泉。"}}}
