c16026-item-ba8bfe82c71c85dcc806"]},"event-7c4e9f11415a8b27c7f9":{"year":1124,"lon":114.313904,"lat":34.802941,"item_ids":["p80ed8ac16026-item-e739e74f3649c7055e76"]},"event-921fb85b8408abd6708d":{"year":1124,"lon":114.313904,"lat":34.802941,"item_ids":[]}},"items":{"p80ed8ac16026-item-563f89215e70172818a4":{"id":"p80ed8ac16026-item-563f89215e70172818a4","person_id":"p80ed8ac16026","title":"賞心亭","units":[{"id":"p80ed8ac16026-item-563f89215e70172818a4-part-01","status":"automatic","work_id":"p80ed8ac16026-text-e76cb4ad67268e0852ef","title":"賞心亭"}]},"p80ed8ac16026-item-b3b77dcc106a769c4919":{"id":"p80ed8ac16026-item-b3b77dcc106a769c4919","person_id":"p80ed8ac16026","title":"","units":[]},"p80ed8ac16026-item-f441f112b53a8aeb04bd":{"id":"p80ed8ac16026-item-f441f112b53a8aeb04bd","person_id":"p80ed8ac16026","title":"","units":[]},"p80ed8ac16026-item-aae02ce66e8d06b576b0":{"id":"p80ed8ac16026-item-aae02ce66e8d06b576b0","person_id":"p80ed8ac16026","title":"","units":[]},"p80ed8ac16026-item-9d467cc4d7cb60e8fc5c":{"id":"p80ed8ac16026-item-9d467cc4d7cb60e8fc5c","person_id":"p80ed8ac16026","title":"","units":[]},"p80ed8ac16026-item-120772fcc12d73c68d28":{"id":"p80ed8ac16026-item-120772fcc12d73c68d28","person_id":"p80ed8ac16026","title":"","units":[]},"p80ed8ac16026-item-ba8bfe82c71c85dcc806":{"id":"p80ed8ac16026-item-ba8bfe82c71c85dcc806","person_id":"p80ed8ac16026","title":"","units":[]},"p80ed8ac16026-item-e739e74f3649c7055e76":{"id":"p80ed8ac16026-item-e739e74f3649c7055e76","person_id":"p80ed8ac16026","title":"脱银袍","units":[{"id":"p80ed8ac16026-item-e739e74f3649c7055e76-part-01","status":"automatic","work_id":"p80ed8ac16026-text-25b90cb5d4d1fa6a6c46","title":"脱银袍"}]}},"works":{"p80ed8ac16026-text-e76cb4ad67268e0852ef":{"id":"p80ed8ac16026-text-e76cb4ad67268e0852ef","person_id":"p80ed8ac16026","title":"賞心亭","titles":["賞心亭"],"text":"白鷺洲邊蘆葉黄，石頭城下水茫茫。\n江山不管事興廢，今古坐令人感傷。\n六代豪華空處所，千秋城闕委荒凉。\n空餘眼外無窮景，助我憑欄到夕陽。"},"p80ed8ac16026-text-25b90cb5d4d1fa6a6c46":{"id":"p80ed8ac16026-text-25b90cb5d4d1fa6a6c46","person_id":"p80ed8ac16026","title":"脱银袍","titles":["脱银袍"],"text":"济楚风光，升平时世。\n端门支散，碗遂逐旋温来，吃得过、那堪更使金器。\n分明是。\n与穷汉、消灾灭罪。\n又没支分，犹然递滞。\n打笃磨槎来根底。\n换头巾，便上弄交番斯替。\n告官里。\n驼逗高阳饿鬼。"}}}
