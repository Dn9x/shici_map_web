id":"pd843b0ab4d99-item-5006b919346d2012f56a-part-01","status":"automatic","work_id":"pd843b0ab4d99-text-fb526449d5716d74c2f4","title":"和梁王衆傳張光祿是王子晉後身"}]},"pd843b0ab4d99-item-4c2f96d429390800b96b":{"id":"pd843b0ab4d99-item-4c2f96d429390800b96b","person_id":"pd843b0ab4d99","title":"","units":[]},"pd843b0ab4d99-item-ef35b9dc5bf49a7f7680":{"id":"pd843b0ab4d99-item-ef35b9dc5bf49a7f7680","person_id":"pd843b0ab4d99","title":"","units":[]},"pd843b0ab4d99-item-0600858513168171e2c8":{"id":"pd843b0ab4d99-item-0600858513168171e2c8","person_id":"pd843b0ab4d99","title":"","units":[]},"pd843b0ab4d99-item-8d86aec663ef2c4a004c":{"id":"pd843b0ab4d99-item-8d86aec663ef2c4a004c","person_id":"pd843b0ab4d99","title":"","units":[]},"pd843b0ab4d99-item-4e18d9b4220169847957":{"id":"pd843b0ab4d99-item-4e18d9b4220169847957","person_id":"pd843b0ab4d99","title":"","units":[]},"pd843b0ab4d99-item-00ece0ed8bb0d8d6ac3e":{"id":"pd843b0ab4d99-item-00ece0ed8bb0d8d6ac3e","person_id":"pd843b0ab4d99","title":"和宋之問寒食題黃梅臨江驛","units":[{"id":"pd843b0ab4d99-item-00ece0ed8bb0d8d6ac3e-part-01","status":"automatic","work_id":"pd843b0ab4d99-text-4354411d7dfc5ab190a2","title":"和宋之問寒食題黃梅臨江驛"}]},"pd843b0ab4d99-item-19cbfcf990a66f0c8684":{"id":"pd843b0ab4d99-item-19cbfcf990a66f0c8684","person_id":"pd843b0ab4d99","title":"","units":[]},"pd843b0ab4d99-item-10e2754144e3e09d95c8":{"id":"pd843b0ab4d99-item-10e2754144e3e09d95c8","person_id":"pd843b0ab4d99","title":"則天皇后挽歌二首 二 / 則天皇后挽歌二首 一","units":[{"id":"pd843b0ab4d99-item-10e2754144e3e09d95c8-part-01","status":"automatic","work_id":"pd843b0ab4d99-text-e2a7e168db0e91f70c58","title":"則天皇后挽歌二首 二"},{"id":"pd843b0ab4d99-item-10e2754144e3e09d95c8-part-02","status":"automatic","work_id":"pd843b0ab4d99-text-67bf4b04286d02e4ecef","title":"則天皇后挽歌二首 一"}]},"pd843b0ab4d99-item-7e3a0ad33f691093b3fb":{"id":"pd843b0ab4d99-item-7e3a0ad33f691093b3fb","person_id":"pd843b0ab4d99","title":"","units":[]},"pd843b0ab4d99-item-8f5d0e853455d0c3a17f":{"id":"pd843b0ab4d99-item-8f5d0e853455d0c3a17f","person_id":"pd843b0ab4d99","title":"","units":[]},"pd843b0ab4d99-item-2f4540973172a0173c8e":{"id":"pd843b0ab4d99-item-2f4540973172a0173c8e","person_id":"pd843b0ab4d99","title":"","units":[]}},"works":{"pd843b0ab4d99-text-5d53fd2c319a2ddf5f9d":{"id":"pd843b0ab4d99-text-5d53fd2c319a2ddf5f9d","person_id":"pd843b0ab4d99","title":"哭蔣詹事儼","titles":["哭蔣詹事儼"],"text":"江上有長離，從容盛羽儀。\n一鳴百獸舞，一舉羣鳥隨。\n應我聖明代，巢君阿閣垂。\n鉤陳侍帷扆，環衞奉旌麾。\n雅量滄海納，完才廟廊施。\n養親光孝道，事主竭忠規。\n貞節既已固，殊榮良不訾。\n朝遊雲漢省，夕宴芙蓉池。\n汲黯言當直，陳平智本奇。\n功成喜身退，時往惜年馳。\n鎮國山基毀，中天柱石頹。\n將軍空有頌，刺史獨留碑。\n蕪漫藏書壁，荒涼懸劒枝。\n昔余參下位，數載忝牽羈。\n置榻恩逾重，迎門禮自卑。\n竹林常接興，黍谷每逢吹。\n逸翰金相發，清談玉柄揮。\n不輕文舉少，深歎子雲疲。\n遺愛猶如在，殘編尚可窺。\n即今流水曲，何處俗人知。"},"pd843b0ab4d99-text-866a91a082ff054a7511":{"id":"pd843b0ab4d99-text-866a91a082ff054a7511","person_id":"pd843b0ab4d99","title":"橫吹曲辭 關山月","titles":["橫吹曲辭 關山月","關山月"],"text":"月生西海上，氣逐邊風壯。\n萬里度關山，蒼茫非一狀。\n漢兵開郡國，胡馬窺亭障。\n夜夜聞悲笳，征人起南望。"},"pd843b0ab4d99-text-88ccb8d0e59b5c4af13c":{"id":"pd843b0ab4d99-text-88ccb8d0e59b5c4af13c","person_id":"pd843b0ab4d99","title":"擬古","titles":["擬古"],"text":"飲馬臨濁河，濁河深不測。\n河水日東注，河源乃西極。\n思君正如此，誰爲生羽翼。\n日夕大川陰，雲霞千里色。\n所思在河處，宛在機中織。\n離夢當有魂，愁容定無力。\n夙齡負奇志，中夜三歎息。\n拔劒斬長榆，彎弓射小棘。\n班張固非擬，衞霍行可即。\n寄謝閨中人，努力加飱食。"},"pd843b0ab4d99-text-f0fcf477c5dfa8b57748":{"id":"pd843b0ab4d99-text-f0fcf477c5dfa8b57748","person_id":"pd843b0ab4d99","title":"西征軍行遇風","titles":["西征軍行遇風"],"text":"北風卷塵沙，左右不相識。\n颯颯吹萬里，昏昏同一色。\n馬煩莫敢進，人急未遑食。\n曹木春更悲，天景晝相匿。\n夙齡慕忠義，雅尚存孤直。\n覽史懷浸驕，讀詩歎孔棘。\n及茲戎旅地，忝從書記職。\n兵氣騰北荒，軍聲振西極。\n坐覺威靈遠，行看氛祲息。\n愚臣何以報，倚馬申微力。"},"pd843b0ab4d99-text-20fdc6611b7a8f9ad28c":{"id":"pd843b0ab4d99-text-20fdc6611b7a8f9ad28c","person_id":"pd843b0ab4d99","title":"從軍行","titles":["從軍行"],"text":"穹廬雜種亂金方，武將神兵下玉堂。\n天子旌旗過細柳，匈奴運數盡枯楊。\n關頭落月橫西嶺，塞下凝雲斷北荒。\n漠漠邊塵飛衆鳥，昏昏朔氣聚羣羊。\n依稀蜀杖迷新竹，髣髴胡牀識故桑。\n臨海舊來聞驃騎，尋河本自有中郎。\n坐看戰壁爲平土，近待軍營作破羌。"},"pd843b0ab4d99-text-73167e89a2fc3844a076":{"id":"pd843b0ab4d99-text-73167e89a2fc3844a076","person_id":"pd843b0ab4d99","title":"留別杜審言幷呈洛中舊遊","titles":["留別杜審言幷呈洛中舊遊"],"text":"斑鬢今爲別，紅顏昨共遊。\n年年春不待，處處酒相留。\n駐馬西橋上，回車南陌頭。\n故人從此隔，風月坐悠悠。"},"pd843b0ab4d99-text-117959bd5b9dd64c8fe8":{"id":"pd843b0ab4d99-text-117959bd5b9dd64c8fe8","person_id":"pd843b0ab4d99","title":"嵩山石淙侍宴應制","titles":["嵩山石淙侍宴應制"],"text":"洞口仙巖類削成，泉香石冷晝含清。\n龍旗畫月中天下，鳳管披雲此地迎。\n樹作帷屏陽景翳，芝如宮闕夏涼生。\n今朝出豫臨懸圃，明日陪遊向赤城。"},"pd843b0ab4d99-text-fb526449d5716d74c2f4":{"id":"pd843b0ab4d99-text-fb526449d5716d74c2f4","person_id":"pd843b0ab4d99","title":"和梁王衆傳張光祿是王子晉後身","titles":["和梁王衆傳張光祿是王子晉後身"],"text":"聞有沖天客，披雲下帝畿。\n三年上賓去，千載忽來歸。\n昔偶浮丘伯，今同丁令威。\n中郎才貌是，柱史姓名非。\n祗召趨龍闕，承恩拜虎闈。\n丹成金鼎獻，酒至玉杯揮。\n天仗分旄節，朝容間羽衣。\n舊壇何處所，新廟坐光輝。\n漢主存仙要，淮南愛道機。\n朝朝緱氏鶴，長向洛城飛。"},"pd843b0ab4d99-text-4354411d7dfc5ab190a2":{"id":"pd843b0ab4d99-text-4354411d7dfc5ab190a2","person_id":"pd843b0ab4d99","title":"和宋之問寒食題黃梅臨江驛","titles":["和宋之問寒食題黃梅臨江驛"],"text":"春分自淮北，寒食渡江南。\n忽見潯陽水，疑是宋家潭。\n明主閽難呌，孤臣逐未堪。\n遙思故園陌，桃李正酣酣。"},"pd843b0ab4d99-text-e2a7e168db0e91f70c58":{"id":"pd843b0ab4d99-text-e2a7e168db0e91f70c58","person_id":"pd843b0ab4d99","title":"則天皇后挽歌二首 二","titles":["則天皇后挽歌二首 二"],"text":"前殿臨朝罷，長陵合葬歸。\n山川不可望，文物盡成非。\n陰月霾中道，軒星落太微。\n空餘天子孝，松上景雲飛。"},"pd843b0ab4d99-text-67bf4b04286d02e4ecef":{"id":"pd843b0ab4d99-text-67bf4b04286d02e4ecef","person_id":"pd843b0ab4d99","title":"則天皇后挽歌二首 一","titles":["則天皇后挽歌二首 一"],"text":"宵陳虛禁夜，夕臨空山陰。\n日月昏尺景，天地慘何心。\n紫殿金鋪澀，黃陵玉座深。\n鏡匳長不啓，聖主淚霑巾。"}}}
