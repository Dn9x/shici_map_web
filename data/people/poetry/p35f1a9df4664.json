57c3afeea2db5ed2ad","person_id":"p35f1a9df4664","title":"天賜白","units":[{"id":"p35f1a9df4664-item-4757c3afeea2db5ed2ad-part-01","status":"automatic","work_id":"p35f1a9df4664-text-d8ff8a05ace2a06fb378","title":"天賜白"}]},"p35f1a9df4664-item-dad91ecaac237dacb697":{"id":"p35f1a9df4664-item-dad91ecaac237dacb697","person_id":"p35f1a9df4664","title":"","units":[]},"p35f1a9df4664-item-e9e91b5e2a00657f7229":{"id":"p35f1a9df4664-item-e9e91b5e2a00657f7229","person_id":"p35f1a9df4664","title":"薛侯馬","units":[{"id":"p35f1a9df4664-item-e9e91b5e2a00657f7229-part-01","status":"automatic","work_id":"p35f1a9df4664-text-8fe94d8176d20fb81f58","title":"薛侯馬"}]},"p35f1a9df4664-item-376b18a28385af978e8f":{"id":"p35f1a9df4664-item-376b18a28385af978e8f","person_id":"p35f1a9df4664","title":"","units":[]},"p35f1a9df4664-item-260721ad508338bbd709":{"id":"p35f1a9df4664-item-260721ad508338bbd709","person_id":"p35f1a9df4664","title":"","units":[]},"p35f1a9df4664-item-9f7ed202902bbcce5404":{"id":"p35f1a9df4664-item-9f7ed202902bbcce5404","person_id":"p35f1a9df4664","title":"","units":[]},"p35f1a9df4664-item-a2111dc8eaba9ae9adf4":{"id":"p35f1a9df4664-item-a2111dc8eaba9ae9adf4","person_id":"p35f1a9df4664","title":"","units":[]},"p35f1a9df4664-item-47283381a4ff7bd7f7a5":{"id":"p35f1a9df4664-item-47283381a4ff7bd7f7a5","person_id":"p35f1a9df4664","title":"红林擒近","units":[{"id":"p35f1a9df4664-item-47283381a4ff7bd7f7a5-part-02","status":"automatic","work_id":"p35f1a9df4664-text-9ad731d2133c44b27209","title":"红林擒近"}]},"p35f1a9df4664-item-764ab62669b5d764fb65":{"id":"p35f1a9df4664-item-764ab62669b5d764fb65","person_id":"p35f1a9df4664","title":"","units":[]},"p35f1a9df4664-item-ccc52561852de99ccb29":{"id":"p35f1a9df4664-item-ccc52561852de99ccb29","person_id":"p35f1a9df4664","title":"","units":[]},"p35f1a9df4664-item-e340a22158c1781c4e64":{"id":"p35f1a9df4664-item-e340a22158c1781c4e64","person_id":"p35f1a9df4664","title":"","units":[]},"p35f1a9df4664-item-2be3f5f708e660b92f2f":{"id":"p35f1a9df4664-item-2be3f5f708e660b92f2f","person_id":"p35f1a9df4664","title":"游定夫見過晡飯既去燭下目昏不能閱書感而賦之","units":[{"id":"p35f1a9df4664-item-2be3f5f708e660b92f2f-part-01","status":"automatic","work_id":"p35f1a9df4664-text-27f69aa7e6a861be8dc9","title":"游定夫見過晡飯既去燭下目昏不能閱書感而賦之"}]},"p35f1a9df4664-item-8bf3e4f74cbadbf718fb":{"id":"p35f1a9df4664-item-8bf3e4f74cbadbf718fb","person_id":"p35f1a9df4664","title":"","units":[]},"p35f1a9df4664-item-f74290fdc7c8eff0a084":{"id":"p35f1a9df4664-item-f74290fdc7c8eff0a084","person_id":"p35f1a9df4664","title":"","units":[]},"p35f1a9df4664-item-6380bfd0f7f17398134f":{"id":"p35f1a9df4664-item-6380bfd0f7f17398134f","person_id":"p35f1a9df4664","title":"","units":[]},"p35f1a9df4664-item-b168e6bfe58997f84a5e":{"id":"p35f1a9df4664-item-b168e6bfe58997f84a5e","person_id":"p35f1a9df4664","title":"","units":[]},"p35f1a9df4664-item-dade4b47ec8ea564ae00":{"id":"p35f1a9df4664-item-dade4b47ec8ea564ae00","person_id":"p35f1a9df4664","title":"","units":[]},"p35f1a9df4664-item-5a36217ed5f585a070dd":{"id":"p35f1a9df4664-item-5a36217ed5f585a070dd","person_id":"p35f1a9df4664","title":"","units":[]},"p35f1a9df4664-item-db642d57b48dbb98416d":{"id":"p35f1a9df4664-item-db642d57b48dbb98416d","person_id":"p35f1a9df4664","title":"","units":[]}},"works":{"p35f1a9df4664-text-d8ff8a05ace2a06fb378":{"id":"p35f1a9df4664-text-d8ff8a05ace2a06fb378","person_id":"p35f1a9df4664","title":"天賜白","titles":["天賜白"],"text":"君不見書生鎸羌勒兵入，羌來薄城束縛急。\n蠟丸飛出辭大家，帳下健兒紛雨泣。\n鑿沙到石終無水，擾擾萬人如渴蟻。\n挽絙竊出兩將軍，敵箭隨來風掠耳。\n道傍神馬白雪毛，噤口不嘶深夜逃。\n忽聞漢語米脂下，黑霧壓城風怒號。\n脫身歸來對刀筆，短衣射虎朝朝出。\n自椎雜寶塗箭創，心折骨驚如昨日。\n穀城魯公天下雄，陰陵一跌兵力窮。\n檥舟不渡謝亭長，有何面目歸江東。\n將軍偶生名已弱，鐵花暗澀龍文鍔。\n縞帳肥芻酬馬恩，閒望旄頭向西落。"},"p35f1a9df4664-text-8fe94d8176d20fb81f58":{"id":"p35f1a9df4664-text-8fe94d8176d20fb81f58","person_id":"p35f1a9df4664","title":"薛侯馬","titles":["薛侯馬"],"text":"薛侯俊健如生猱，不識中原生土豪。\n蛇矛丈八常在手，駱馬蕃鞍雲錦袍。\n往屬嫖姚探虎穴，狐鳴蕭蕭風立髮。\n短韉淋血斬將歸，夜斲堅冰濡馬渴。\n中都久住武城坊，屋頭養駱如養羊。\n枯萁不飽籬壁盡，狹巷怒蹄盆盎傷。\n只今栖栖守環堵，五月樵風吹宿莽。\n千金夜出酬市兒，客帳晝眠聽戲鼓。\n邊人視死亦尋常，笑裏辭家登戰場。\n銓勞定次屈壯士，兩眼熒熒收淚光。\n齒堅食肉何曾老，騎馬身輕飛一鳥。\n焉知不將萬人行，橫槊秋風賀蘭道。"},"p35f1a9df4664-text-9ad731d2133c44b27209":{"id":"p35f1a9df4664-text-9ad731d2133c44b27209","person_id":"p35f1a9df4664","title":"红林擒近","titles":["红林擒近"],"text":"高柳春才软，冻梅寒更香。\n暮雪助清峭，玉尘散林塘。\n那堪飘风递冷，故遣度幕穿窗。\n似欲料理新妆。\n呵手弄丝簧。\n冷落词赋客，萧索水云乡。\n援毫授简，风流犹忆东梁。\n望虚檐徐转，迥廊未扫，夜长莫惜空酒觞。"},"p35f1a9df4664-text-27f69aa7e6a861be8dc9":{"id":"p35f1a9df4664-text-27f69aa7e6a861be8dc9","person_id":"p35f1a9df4664","title":"游定夫見過晡飯既去燭下目昏不能閱書感而賦之","titles":["游定夫見過晡飯既去燭下目昏不能閱書感而賦之"],"text":"烟草里門秋，暮氣幽人宅。\n遙知金輪升，戶牖粲虛白。\n風驅雲將來，市聲落几格。\n連曹屬解鞚，一飯已掃迹。\n餘羶未潔鼎，傲鼠已出額。\n銅英洗病眼，烏舄畏斷冊。\n已爲兒輩翁，茲事豈不迫。\n昔見羨門生，童子身三尺。\n捐家問道要，顓聲不好劇。\n頗觀鳥跡書，保氣如保璧。\n貪餌投禍羅，煎絲廢前績。\n上慚玄元教，溘死有餘責。\n濁鏡在兩眸，看朱忽成碧。\n當時方瞳叟，變滅雲霧隔。\n肝勞憂久痼，瞑坐救昏幕。\n尚須文字間，侵盡百年客。\n非圖矚秋毫，所要分菽麥。"}}}
