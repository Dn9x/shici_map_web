1,"lon":120.586673,"lat":30.036519,"item_ids":[]},"event-7360874be9c394e73450":{"year":882,"lon":120.586673,"lat":30.036519,"item_ids":[]},"event-12b6f9ce3588225e981d":{"year":883,"lon":120.586673,"lat":30.036519,"item_ids":[]},"event-48bec1b1c56cf38e5240":{"year":884,"lon":120.586673,"lat":30.036519,"item_ids":[]},"event-721f9a7ca9c30c94e5b4":{"year":885,"lon":120.586673,"lat":30.036519,"item_ids":[]},"event-734b78bf038d2e85b18e":{"year":886,"lon":120.586673,"lat":30.036519,"item_ids":["p19b92c82fcf8-item-c8e195cb51b9a00470bd"]}},"items":{"p19b92c82fcf8-item-1755f97f4543e9e29f10":{"id":"p19b92c82fcf8-item-1755f97f4543e9e29f10","person_id":"p19b92c82fcf8","title":"送姚合員外赴金州","units":[{"id":"p19b92c82fcf8-item-1755f97f4543e9e29f10-part-01","status":"automatic","work_id":"p19b92c82fcf8-text-c145a5addb28d584e76f","title":"送姚合員外赴金州"}]},"p19b92c82fcf8-item-deeb6ef81b070313441e":{"id":"p19b92c82fcf8-item-deeb6ef81b070313441e","person_id":"p19b92c82fcf8","title":"上杭州姚郎中","units":[{"id":"p19b92c82fcf8-item-deeb6ef81b070313441e-part-01","status":"automatic","work_id":"p19b92c82fcf8-text-94ca4d7f6dadd20172e1","title":"上杭州姚郎中"}]},"p19b92c82fcf8-item-26547f708bd9a70ab05a":{"id":"p19b92c82fcf8-item-26547f708bd9a70ab05a","person_id":"p19b92c82fcf8","title":"寄普州賈司倉島","units":[{"id":"p19b92c82fcf8-item-26547f708bd9a70ab05a-part-01","status":"automatic","work_id":"p19b92c82fcf8-text-05f559ff7aff585ea86c","title":"寄普州賈司倉島"}]},"p19b92c82fcf8-item-0c6bbdd31216d77a475d":{"id":"p19b92c82fcf8-item-0c6bbdd31216d77a475d","person_id":"p19b92c82fcf8","title":"寒食宿先天寺無可上人房","units":[{"id":"p19b92c82fcf8-item-0c6bbdd31216d77a475d-part-01","status":"automatic","work_id":"p19b92c82fcf8-text-35f605c112313bd21fcd","title":"寒食宿先天寺無可上人房"}]},"p19b92c82fcf8-item-b03619a151a7da96a257":{"id":"p19b92c82fcf8-item-b03619a151a7da96a257","person_id":"p19b92c82fcf8","title":"","units":[]},"p19b92c82fcf8-item-4725ed91b287fe9dc3d6":{"id":"p19b92c82fcf8-item-4725ed91b287fe9dc3d6","person_id":"p19b92c82fcf8","title":"","units":[]},"p19b92c82fcf8-item-d2800cdf111ceef2cc1f":{"id":"p19b92c82fcf8-item-d2800cdf111ceef2cc1f","person_id":"p19b92c82fcf8","title":"送睦州侯郎中赴闕","units":[{"id":"p19b92c82fcf8-item-d2800cdf111ceef2cc1f-part-01","status":"automatic","work_id":"p19b92c82fcf8-text-46a06e2d94e76098034c","title":"送睦州侯郎中赴闕"}]},"p19b92c82fcf8-item-10b1ffecc70b03dd6c52":{"id":"p19b92c82fcf8-item-10b1ffecc70b03dd6c52","person_id":"p19b92c82fcf8","title":"獻王大夫二首 一 / 獻王大夫二首 二","units":[{"id":"p19b92c82fcf8-item-10b1ffecc70b03dd6c52-part-01","status":"automatic","work_id":"p19b92c82fcf8-text-46c7b4ec8f6de1fa723a","title":"獻王大夫二首 一"},{"id":"p19b92c82fcf8-item-10b1ffecc70b03dd6c52-part-02","status":"automatic","work_id":"p19b92c82fcf8-text-b03ce5cd1b4688575df4","title":"獻王大夫二首 二"}]},"p19b92c82fcf8-item-d493e81379ba68cf36d2":{"id":"p19b92c82fcf8-item-d493e81379ba68cf36d2","person_id":"p19b92c82fcf8","title":"尚書新創敵樓二首 一","units":[{"id":"p19b92c82fcf8-item-d493e81379ba68cf36d2-part-01","status":"automatic","work_id":"p19b92c82fcf8-text-f3f2200f7662086b017b","title":"尚書新創敵樓二首 一"}]},"p19b92c82fcf8-item-c8e195cb51b9a00470bd":{"id":"p19b92c82fcf8-item-c8e195cb51b9a00470bd","person_id":"p19b92c82fcf8","title":"謝王大夫奏表","units":[{"id":"p19b92c82fcf8-item-c8e195cb51b9a00470bd-part-01","status":"automatic","work_id":"p19b92c82fcf8-text-0064a062d82cfd4f7d12","title":"謝王大夫奏表"}]}},"works":{"p19b92c82fcf8-text-c145a5addb28d584e76f":{"id":"p19b92c82fcf8-text-c145a5addb28d584e76f","person_id":"p19b92c82fcf8","title":"送姚合員外赴金州","titles":["送姚合員外赴金州"],"text":"受詔從華省，開旗發帝州。\n野煙新驛曙，殘照古山秋。\n樹勢連巴沒，江聲入楚流。\n唯應化行後，吟句上閑樓。"},"p19b92c82fcf8-text-94ca4d7f6dadd20172e1":{"id":"p19b92c82fcf8-text-94ca4d7f6dadd20172e1","person_id":"p19b92c82fcf8","title":"上杭州姚郎中","titles":["上杭州姚郎中"],"text":"能除疾瘼似良醫，一郡鄉風當日移。\n身貴久離行藥伴，才高獨作後人師。\n春遊下馬皆成醼，吏散看山即有詩。\n借問公方與文道，而今中夏更傳誰。"},"p19b92c82fcf8-text-05f559ff7aff585ea86c":{"id":"p19b92c82fcf8-text-05f559ff7aff585ea86c","person_id":"p19b92c82fcf8","title":"寄普州賈司倉島","titles":["寄普州賈司倉島"],"text":"亂山重復疊，何路訪先生。\n豈料多才者，空垂不世名閑曹猶得醉，薄俸亦勝耕。\n莫問吟詩石，年年芳草平。"},"p19b92c82fcf8-text-35f605c112313bd21fcd":{"id":"p19b92c82fcf8-text-35f605c112313bd21fcd","person_id":"p19b92c82fcf8","title":"寒食宿先天寺無可上人房","titles":["寒食宿先天寺無可上人房"],"text":"雙扉檜下開，寄宿石房苔。\n幡北燈花動，城西雪霰來。\n收棊想雲夢，罷茗議天台。\n同憶前年臘，師初白閣回。"},"p19b92c82fcf8-text-46a06e2d94e76098034c":{"id":"p19b92c82fcf8-text-46a06e2d94e76098034c","person_id":"p19b92c82fcf8","title":"送睦州侯郎中赴闕","titles":["送睦州侯郎中赴闕"],"text":"昔著政聲聞國外，今留儒術化江東。\n青雲舊路歸仙掖，白鳳新詞入聖聰。\n弦管未知銀燭曉，旌旗已侍錦帆風。\n郡人難議酬恩德，徧在三年禮遇中。"},"p19b92c82fcf8-text-46c7b4ec8f6de1fa723a":{"id":"p19b92c82fcf8-text-46c7b4ec8f6de1fa723a","person_id":"p19b92c82fcf8","title":"獻王大夫二首 一","titles":["獻王大夫二首 一"],"text":"都緣聲價振皇州，高臥中條不自由。\n早副急徵來鳳沼，常陪內宴醉龍樓。\n鏘金五字能援筆，釣玉三年信直鉤。\n必恐借留終不遂，越人相顧已先愁。"},"p19b92c82fcf8-text-b03ce5cd1b4688575df4":{"id":"p19b92c82fcf8-text-b03ce5cd1b4688575df4","person_id":"p19b92c82fcf8","title":"獻王大夫二首 二","titles":["獻王大夫二首 二"],"text":"功成猶自更行春，塞路旌旗十里塵。\n只用篇章爲教化，不知夷夏望陶鈞。\n金章照耀浮光動，玉面生獰細步勻。\n歷任聖朝清峻地，至今依是少年身。"},"p19b92c82fcf8-text-f3f2200f7662086b017b":{"id":"p19b92c82fcf8-text-f3f2200f7662086b017b","person_id":"p19b92c82fcf8","title":"尚書新創敵樓二首 一","titles":["尚書新創敵樓二首 一"],"text":"下馬政成無一事，應須勝地過朝昏。\n笙歌引出桃花洞，羅繡擁來金谷園。\n十里水雲吞半郭，九秋山月入千門。\n常聞大廈堪棲息，燕雀心知不敢言。"},"p19b92c82fcf8-text-0064a062d82cfd4f7d12":{"id":"p19b92c82fcf8-text-0064a062d82cfd4f7d12","person_id":"p19b92c82fcf8","title":"謝王大夫奏表","titles":["謝王大夫奏表"],"text":"非唯言下變榮衰，大海可傾山可移。\n如剖夜光歸暗室，似驅春氣入寒枝。\n死灰到底翻騰焰，朽骨隨頭却長肥。\n便殺微躬復何益，生成恩重報無期。"}}}
