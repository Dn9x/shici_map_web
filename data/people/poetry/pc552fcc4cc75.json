"id":"pc552fcc4cc75-item-552a952c339194e90d6e-part-01","status":"automatic","work_id":"pc552fcc4cc75-text-7cf4be6dc276ae4d8ea2","title":"渡桑乾河"}]},"pc552fcc4cc75-item-8e7457e484155323ea6d":{"id":"pc552fcc4cc75-item-8e7457e484155323ea6d","person_id":"pc552fcc4cc75","title":"懷無可上人","units":[{"id":"pc552fcc4cc75-item-8e7457e484155323ea6d-part-01","status":"automatic","work_id":"pc552fcc4cc75-text-12305ea210fdacac4215","title":"懷無可上人"}]},"pc552fcc4cc75-item-4edcd3b58500bafa2a0b":{"id":"pc552fcc4cc75-item-4edcd3b58500bafa2a0b","person_id":"pc552fcc4cc75","title":"盧岳閑居十韻","units":[{"id":"pc552fcc4cc75-item-4edcd3b58500bafa2a0b-part-01","status":"automatic","work_id":"pc552fcc4cc75-text-619afff306c474850012","title":"盧岳閑居十韻"}]}},"works":{"pc552fcc4cc75-text-c2b0a6730afc61086fc1":{"id":"pc552fcc4cc75-text-c2b0a6730afc61086fc1","person_id":"pc552fcc4cc75","title":"離家後作","titles":["離家後作"],"text":"世上無媒似我希，一身惟有影相隨。\n出門便作焚舟計，生不成名死不歸。"},"pc552fcc4cc75-text-4fb66d6cf2c8d7f288c7":{"id":"pc552fcc4cc75-text-4fb66d6cf2c8d7f288c7","person_id":"pc552fcc4cc75","title":"峽中行","titles":["峽中行"],"text":"兩崖開盡水回環，一葉纔通石罅間。\n楚客莫言山勢險，世人心更險於山。"},"pc552fcc4cc75-text-90d8b456d016f63d31eb":{"id":"pc552fcc4cc75-text-90d8b456d016f63d31eb","person_id":"pc552fcc4cc75","title":"再下第將歸荆楚上白舍人","titles":["再下第將歸荆楚上白舍人"],"text":"窮通應計一時間，今日甘從刖足還。\n長倚玉人心自醉，不辭歸去哭荆山。"},"pc552fcc4cc75-text-ed197203b09eb6ada135":{"id":"pc552fcc4cc75-text-ed197203b09eb6ada135","person_id":"pc552fcc4cc75","title":"離京城宿商山作","titles":["離京城宿商山作"],"text":"山月吟聲苦，春風引思長。\n無由及塵土，猶帶杏花香。"},"pc552fcc4cc75-text-d4c942bc70fe5bb284cf":{"id":"pc552fcc4cc75-text-d4c942bc70fe5bb284cf","person_id":"pc552fcc4cc75","title":"春行武關作","titles":["春行武關作"],"text":"風香春暖展歸程，全勝遊仙入洞情。\n一路緣溪花覆水，不妨閑看不妨行。"},"pc552fcc4cc75-text-88b1ef1161f2594828c3":{"id":"pc552fcc4cc75-text-88b1ef1161f2594828c3","person_id":"pc552fcc4cc75","title":"寄題峴亭","titles":["寄題峴亭"],"text":"峴亭留恨爲傷杯，未得醒醒看便回。\n卻想醉游如夢見，直疑元本不曾來。"},"pc552fcc4cc75-text-dd9ee7597d2280b796ca":{"id":"pc552fcc4cc75-text-dd9ee7597d2280b796ca","person_id":"pc552fcc4cc75","title":"送徐山人歸睦州舊隱","titles":["送徐山人歸睦州舊隱"],"text":"君在桐廬何處住，草堂應與戴家鄰。\n初歸山犬翻驚主，久別江鷗却避人。\n終日欲爲相逐計，臨岐空羨獨行身。\n秋風釣艇遙相憶，七里灘西片月新。"},"pc552fcc4cc75-text-0961b87c80135128dc82":{"id":"pc552fcc4cc75-text-0961b87c80135128dc82","person_id":"pc552fcc4cc75","title":"送于中丞使北蕃","titles":["送于中丞使北蕃"],"text":"朔將引雙旌，山遙磧雪平。\n經年通國信，計日得蕃情。\n野次依泉宿，沙中望火行。\n遠鵰秋有力，寒馬夜無聲。\n看獵臨胡帳，思鄉見漢城。\n來春擁邊騎，新草滿歸程。"},"pc552fcc4cc75-text-0521b59ad2796dff0966":{"id":"pc552fcc4cc75-text-0521b59ad2796dff0966","person_id":"pc552fcc4cc75","title":"寄永樂殷堯藩明府","titles":["寄永樂殷堯藩明府"],"text":"古縣蕭條秋景晚，昔年陶令亦如君。\n頭巾漉酒臨黃菊，手[板]支頤向白雲。\n百里豈能容驥足，九霄終自別雞羣。\n相思不恨書來少，佳句多從闕下聞。"},"pc552fcc4cc75-text-8371137dcca2a5515ac0":{"id":"pc552fcc4cc75-text-8371137dcca2a5515ac0","person_id":"pc552fcc4cc75","title":"永樂殷堯藩明府縣池嘉蓮詠","titles":["永樂殷堯藩明府縣池嘉蓮詠"],"text":"青蘋白石匝蓮塘，水裏蓮開帶瑞光。\n露濕紅芳雙朵重，風飄綠蔕一枝長。\n同心梔子徒誇豔，合穗嘉禾豈解香。\n不獨豐祥先有應，更宜花縣對潘郎。"},"pc552fcc4cc75-text-ae07abc4ad06b849b354":{"id":"pc552fcc4cc75-text-ae07abc4ad06b849b354","person_id":"pc552fcc4cc75","title":"哭饒州吳諫議使君","titles":["哭饒州吳諫議使君"],"text":"忽聞身謝滿朝驚，俄感鄱陽罷市情。\n遺愛永存今似古，高名不朽死如生。\n神仙難見青騾事，諫議空留白馬名。\n授館曾爲門下客，幾迴垂淚過宣平。"},"pc552fcc4cc75-text-88329f40223a52a56663":{"id":"pc552fcc4cc75-text-88329f40223a52a56663","person_id":"pc552fcc4cc75","title":"送前鄠縣李少府","titles":["送前鄠縣李少府"],"text":"近出圭峯下，還期又不賒。\n身閑多宿寺，官滿未移家。\n罷釣臨秋水，開尊對月華。\n自當蓬閣選，豈得臥煙霞。"},"pc552fcc4cc75-text-200dfe888edb2f3e7d47":{"id":"pc552fcc4cc75-text-200dfe888edb2f3e7d47","person_id":"pc552fcc4cc75","title":"哀蜀人爲南蠻俘虜五章 別巂州一時慟哭雲日爲之變色","titles":["哀蜀人爲南蠻俘虜五章 別巂州一時慟哭雲日爲之變色"],"text":"越巂城南無漢地，傷心從此便爲蠻。\n冤聲一慟悲風起，雲暗青天日下山。"},"pc552fcc4cc75-text-7415b45aa2935f4515b2":{"id":"pc552fcc4cc75-text-7415b45aa2935f4515b2","person_id":"pc552fcc4cc75","title":"哀蜀人爲南蠻俘虜五章 初出成都聞哭聲","titles":["哀蜀人爲南蠻俘虜五章 初出成都聞哭聲"],"text":"但見城池還漢將，豈知佳麗屬蠻兵。\n錦江南度遙聞哭，盡是離家別國聲。"},"pc552fcc4cc75-text-9221a3e55b233347ad46":{"id":"pc552fcc4cc75-text-9221a3e55b233347ad46","person_id":"pc552fcc4cc75","title":"哀蜀人爲南蠻俘虜五章 出青溪關有遲留之意","titles":["哀蜀人爲南蠻俘虜五章 出青溪關有遲留之意"],"text":"欲出鄉關行步遲，此生無復卻回時。\n千冤萬恨何人見，唯有空山鳥獸知。"},"pc552fcc4cc75-text-11a373c70bab6d8ef784":{"id":"pc552fcc4cc75-text-11a373c70bab6d8ef784","person_id":"pc552fcc4cc75","title":"哀蜀人爲南蠻俘虜五章 過大渡河蠻使許之泣望鄉國","titles":["哀蜀人爲南蠻俘虜五章 過大渡河蠻使許之泣望鄉國"],"text":"大渡河邊蠻亦愁，漢人將渡盡回頭。\n此中剩寄思鄉淚，南去應無水北流。"},"pc552fcc4cc75-text-620f8e15054f4d705cb9":{"id":"pc552fcc4cc75-text-620f8e15054f4d705cb9","person_id":"pc552fcc4cc75","title":"哀蜀人爲南蠻俘虜五章 入蠻界不許有悲泣之聲","titles":["哀蜀人爲南蠻俘虜五章 入蠻界不許有悲泣之聲"],"text":"雲南路出陷河西，毒草長青瘴色低。\n漸近蠻城誰敢哭，一時收淚羨猨啼。"},"pc552fcc4cc75-text-420cd4b5eee87df8b137":{"id":"pc552fcc4cc75-text-420cd4b5eee87df8b137","person_id":"pc552fcc4cc75","title":"蜀中戰後感事","titles":["蜀中戰後感事"],"text":"蜀道英靈地，山重水又回。\n文章四子盛，道路五丁開。\n詞客題橋去，忠臣叱馭來。\n臥龍同駭浪，躍馬比浮埃。\n已謂無妖土，那知有禍胎。\n蕃兵依𣾴柳，蠻斾指江梅。\n戰後悲逢血，燒餘恨見灰。\n空留犀厭怪，無復酒除災。\n歲積萇弘怨，春深杜宇哀。\n家貧移未得，愁上望鄉臺。"},"pc552fcc4cc75-text-8ae60283191328a18998":{"id":"pc552fcc4cc75-text-8ae60283191328a18998","person_id":"pc552fcc4cc75","title":"荅蜀中經蠻後友人馬艾見寄","titles":["荅蜀中經蠻後友人馬艾見寄"],"text":"茜馬渡瀘水，北來如鳥輕。\n幾年朝鳳闕，一日破龜城。\n此地有征戰，誰家無死生。\n人悲還舊里，鳥喜下空營。\n弟姪意初定，交朋心尚驚。\n自從經難後，吟苦似猿聲。"},"pc552fcc4cc75-text-ab1d56ef481cc9abfba0":{"id":"pc552fcc4cc75-text-ab1d56ef481cc9abfba0","person_id":"pc552fcc4cc75","title":"和河南白尹西池北新葺水齋招賞十二韻","titles":["和河南白尹西池北新葺水齋招賞十二韻"],"text":"二室峯前水，三川府右亭。\n亂流深竹逕，分遶小花汀。\n池角通泉脈，堂心豁地形。\n坐中寒瑟瑟，牀下細泠泠。\n雨夜思巫峽，秋朝想洞庭。\n千年孤鏡碧，一片遠天青。\n魚戲搖紅尾，鷗閑退白翎。\n荷傾瀉珠露，沙亂動金星。\n藤架如紗帳，苔牆似錦屏。\n龍門人少到，仙棹自多停。\n游憶高僧伴，吟招野客聽。\n餘波不能惜，便欲養浮萍。"},"pc552fcc4cc75-text-1b9e806af16065953b39":{"id":"pc552fcc4cc75-text-1b9e806af16065953b39","person_id":"pc552fcc4cc75","title":"苦寒","titles":["苦寒"],"text":"今年無異去年寒，何事朝來獨忍難。\n應是漸爲貧客久，錦衣著盡布衣單。"},"pc552fcc4cc75-text-d25ef756f33319d53356":{"id":"pc552fcc4cc75-text-d25ef756f33319d53356","person_id":"pc552fcc4cc75","title":"陰地關見入蕃公主石上手跡","titles":["陰地關見入蕃公主石上手跡"],"text":"漢家公主昔和蕃，石上今餘手跡存。\n風雨幾年侵不滅，分明纖指印苔痕。"},"pc552fcc4cc75-text-ec6aab168a50169e85b2":{"id":"pc552fcc4cc75-text-ec6aab168a50169e85b2","person_id":"pc552fcc4cc75","title":"春懷舊游","titles":["春懷舊游"],"text":"吟想舊經過，花時奈遠何。\n別來長似見，春夢入關多。"},"pc552fcc4cc75-text-2be4e06ddbb6b1f21bf1":{"id":"pc552fcc4cc75-text-2be4e06ddbb6b1f21bf1","person_id":"pc552fcc4cc75","title":"晴詩","titles":["晴詩"],"text":"晚虹斜日塞天昏，一半山川帶雨痕。\n新水亂侵青草路，殘煙猶傍綠楊村。\n胡人羊馬休南牧，漢將旌旗在北門。\n行子喜聞無戰伐，閑看遊騎獵秋原。"},"pc552fcc4cc75-text-0c7329e8b7826b3c4998":{"id":"pc552fcc4cc75-text-0c7329e8b7826b3c4998","person_id":"pc552fcc4cc75","title":"塞上宿野寺","titles":["塞上宿野寺"],"text":"塞上蕃僧老，天寒疾上關。\n遠煙平似水，高樹暗如山。\n去馬朝常急，行人夜始閑。\n更深聽刁斗，時到磬聲間。"},"pc552fcc4cc75-text-bb2cd21a06a1c9863672":{"id":"pc552fcc4cc75-text-bb2cd21a06a1c9863672","person_id":"pc552fcc4cc75","title":"再經天涯地角山","titles":["再經天涯地角山"],"text":"每憶雲山養短才，悔緣名利入塵埃。\n十年馬足行多少，兩度天涯地角來。"},"pc552fcc4cc75-text-22af61b672b1fbedeb59":{"id":"pc552fcc4cc75-text-22af61b672b1fbedeb59","person_id":"pc552fcc4cc75","title":"路中問程知欲達青雲驛","titles":["路中問程知欲達青雲驛"],"text":"行愁驛路問來人，西去經過願一聞。\n落日回鞭相指點，前程從此是青雲。"},"pc552fcc4cc75-text-7cf4be6dc276ae4d8ea2":{"id":"pc552fcc4cc75-text-7cf4be6dc276ae4d8ea2","person_id":"pc552fcc4cc75","title":"渡桑乾河","titles":["渡桑乾河"],"text":"南客豈曾諳塞北，年年唯見鴈飛回。\n今朝忽渡桑乾水，不似身來似夢來。"},"pc552fcc4cc75-text-12305ea210fdacac4215":{"id":"pc552fcc4cc75-text-12305ea210fdacac4215","person_id":"pc552fcc4cc75","title":"懷無可上人","titles":["懷無可上人"],"text":"山寺秋時後，僧家夏滿時。\n清涼多古跡，幾處有新詩。"},"pc552fcc4cc75-text-619afff306c474850012":{"id":"pc552fcc4cc75-text-619afff306c474850012","person_id":"pc552fcc4cc75","title":"盧岳閑居十韻","titles":["盧岳閑居十韻"],"text":"擾擾走人寰，爭如占得閑。\n防愁心付酒，求靜力登山。\n見藥芳時採，逢花好處攀。\n望雲開病眼，臨澗洗愁顏。\n春色流巖下，秋聲碎竹間。\n錦文苔點點，錢樣菊斑斑。\n路遠朝無客，門深夜不關。\n鶴飛高縹緲，鶯語巧綿蠻。\n養拙甘沈默，忘懷絕險艱。\n更憐雲外路，空去又空還。"}}}
