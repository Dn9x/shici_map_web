c":{"id":"p51cea09bd89d-item-6bb1d25756bf2463e13c","person_id":"p51cea09bd89d","title":"","units":[]},"p51cea09bd89d-item-d54f273a2f98200c1559":{"id":"p51cea09bd89d-item-d54f273a2f98200c1559","person_id":"p51cea09bd89d","title":"春帖子 皇帝閣","units":[{"id":"p51cea09bd89d-item-d54f273a2f98200c1559-part-01","status":"automatic","work_id":"p51cea09bd89d-text-11191ca9bcf0ba112e17","title":"春帖子 皇帝閣"}]},"p51cea09bd89d-item-ce0dac99b99c1fd07e40":{"id":"p51cea09bd89d-item-ce0dac99b99c1fd07e40","person_id":"p51cea09bd89d","title":"春帖子 貴妃閣","units":[{"id":"p51cea09bd89d-item-ce0dac99b99c1fd07e40-part-01","status":"automatic","work_id":"p51cea09bd89d-text-b04c6a59c649d2053919","title":"春帖子 貴妃閣"}]},"p51cea09bd89d-item-2c32b0b6e0943b3538eb":{"id":"p51cea09bd89d-item-2c32b0b6e0943b3538eb","person_id":"p51cea09bd89d","title":"端午帖子 皇帝閣","units":[{"id":"p51cea09bd89d-item-2c32b0b6e0943b3538eb-part-01","status":"automatic","work_id":"p51cea09bd89d-text-e5520684aa5bd142bf0d","title":"端午帖子 皇帝閣"}]},"p51cea09bd89d-item-38d5c7b2cb6d35e49a3e":{"id":"p51cea09bd89d-item-38d5c7b2cb6d35e49a3e","person_id":"p51cea09bd89d","title":"端午帖子 夫人閣","units":[{"id":"p51cea09bd89d-item-38d5c7b2cb6d35e49a3e-part-01","status":"automatic","work_id":"p51cea09bd89d-text-5ec4f21d35a6696f54b5","title":"端午帖子 夫人閣"}]},"p51cea09bd89d-item-cfc70a39495b581049c1":{"id":"p51cea09bd89d-item-cfc70a39495b581049c1","person_id":"p51cea09bd89d","title":"声声慢","units":[{"id":"p51cea09bd89d-item-cfc70a39495b581049c1-part-01","status":"automatic","work_id":"p51cea09bd89d-text-9a13789e393a0e28067a","title":"声声慢"}]}},"works":{"p51cea09bd89d-text-f11c5f655ee482485a7e":{"id":"p51cea09bd89d-text-f11c5f655ee482485a7e","person_id":"p51cea09bd89d","title":"春殘","titles":["春殘"],"text":"春殘何事苦思鄉，病裏梳頭恨最長。\n梁燕語多終日在，薔薇風細一簾香。"},"p51cea09bd89d-text-b22bebf2a8f8f0af6260":{"id":"p51cea09bd89d-text-b22bebf2a8f8f0af6260","person_id":"p51cea09bd89d","title":"鹧鸪天","titles":["鹧鸪天"],"text":"暗淡轻黄体性柔。\n情疏迹远只香留。\n何须浅碧深红色，自是花中第一流。\n梅定妒，菊应羞。\n画阑开处冠中秋。\n骚人可煞无情思，何事当年不见收。"},"p51cea09bd89d-text-8de4778b660e0d322ec6":{"id":"p51cea09bd89d-text-8de4778b660e0d322ec6","person_id":"p51cea09bd89d","title":"浣溪沙","titles":["浣溪沙"],"text":"莫许杯深琥珀浓。\n未成沈醉意先融。\n□□已应晚来风。\n瑞脑香消魂梦断，辟寒金小髻鬟松。\n醒时空对烛花红。"},"p51cea09bd89d-text-d9e6685970de2a9673db":{"id":"p51cea09bd89d-text-d9e6685970de2a9673db","person_id":"p51cea09bd89d","title":"渔家傲","titles":["渔家傲"],"text":"雪里已知春信至。\n寒梅点缀琼枝腻。\n香脸半开娇旖旎。\n当庭际。\n玉人浴出新妆洗。\n造化可能偏有意。\n故教明月玲珑地。\n共赏金尊沈绿蚁。\n莫辞醉。\n此花不与群花比。"},"p51cea09bd89d-text-c97ca39aa56e885df7e9":{"id":"p51cea09bd89d-text-c97ca39aa56e885df7e9","person_id":"p51cea09bd89d","title":"和張文潛浯溪中興頌二首  其一","titles":["和張文潛浯溪中興頌二首  其一"],"text":"五十年功如電掃，華清花柳咸陽草。\n五坊供奉鬬雞兒，酒肉堆中不知老。\n胡兵忽自天上來，逆胡亦是姦雄才。\n勤政樓前走胡馬，珠翠踏盡香塵埃。\n何爲出戰輒披靡，傳置荔枝多馬死。\n堯功舜德本如天，安用區區紀文字。\n著碑銘德真陋哉，乃令神鬼磨山崖。\n子儀光弼不自猜，天心悔禍人心開。\n夏商有鑒當深戒，簡策汗青今具在。\n君不見當時張說最多機，雖生已被姚崇賣。"},"p51cea09bd89d-text-cf3ea6151507c97a17d2":{"id":"p51cea09bd89d-text-cf3ea6151507c97a17d2","person_id":"p51cea09bd89d","title":"和張文潛浯溪中興頌二首  其二","titles":["和張文潛浯溪中興頌二首  其二"],"text":"君不見驚人廢興傳天寶，中興碑上今生草。\n不知負國有姦雄，但說成功尊國老。\n誰令妃子天上來，虢秦韓國皆天才。\n花桑羯鼓玉方響，春風不敢生塵埃。\n姓名誰復知安史，健兒猛將安眠死。\n去天尺五抱甕峰，峰頭鑿出開元字。\n時移勢去真可哀，姦人心醜深如崖。\n西蜀萬里尚能反，南內一閉何時開。\n可憐孝德如天大，反使將軍稱好在。\n嗚呼奴輩乃不能道輔國用事張后尊，乃能念春薺長安作斤賣。"},"p51cea09bd89d-text-3c6f3de328c20f56e805":{"id":"p51cea09bd89d-text-3c6f3de328c20f56e805","person_id":"p51cea09bd89d","title":"减字木兰花","titles":["减字木兰花"],"text":"卖花担上。\n买得一枝春欲放。\n泪染轻匀。\n犹带彤霞晓露痕。\n怕郎猜道。\n奴面不如花面好。\n云鬓斜簪。\n徒要教郎比并看。"},"p51cea09bd89d-text-e7dfa885a431b52becdf":{"id":"p51cea09bd89d-text-e7dfa885a431b52becdf","person_id":"p51cea09bd89d","title":"浣溪沙","titles":["浣溪沙"],"text":"绣面芙蓉一笑开。\n斜飞宝鸭衬香腮。\n眼波才动被人猜。\n一面风情深有韵，半笺娇恨寄幽怀。\n月移花影约重来。"},"p51cea09bd89d-text-271f615f3897b05ee416":{"id":"p51cea09bd89d-text-271f615f3897b05ee416","person_id":"p51cea09bd89d","title":"如梦令","titles":["如梦令"],"text":"昨夜雨疏风骤。\n浓睡不消残酒。\n试问卷帘人，却道海棠依旧。\n知否。\n知否。\n应是绿肥红瘦。"},"p51cea09bd89d-text-845d88624381d1eb2da9":{"id":"p51cea09bd89d-text-845d88624381d1eb2da9","person_id":"p51cea09bd89d","title":"怨王孙・忆王孙","titles":["怨王孙・忆王孙"],"text":"帝里春晚。\n重门深院。\n草绿阶前，暮天雁断。\n楼上远信谁传。\n恨绵绵。\n多情自是多沾惹。\n难拚舍。\n又是寒食也。\n秋千巷陌，人静皎月初斜。\n浸梨花。"},"p51cea09bd89d-text-ef1fe8cc9c05228f6472":{"id":"p51cea09bd89d-text-ef1fe8cc9c05228f6472","person_id":"p51cea09bd89d","title":"玉楼春","titles":["玉楼春"],"text":"红酥肯放琼苞碎。\n探著南枝开遍未。\n不知酝藉几多香，但见包藏无限意。\n道人憔悴春窗底。\n闷损阑干愁不倚。\n要来小酌便来休，未必明朝风不起。"},"p51cea09bd89d-text-40c0772e8dee3c0ae81c":{"id":"p51cea09bd89d-text-40c0772e8dee3c0ae81c","person_id":"p51cea09bd89d","title":"行香子","titles":["行香子"],"text":"草际鸣蛩。\n惊落梧桐。\n正人间、天上愁浓。\n云阶月地，关锁千重。\n纵浮槎来，浮槎去，不相逢。\n星桥鹊驾，经年才见，想离情、别恨难穷。\n牵牛织女，莫是离中。\n甚霎儿晴，霎儿雨，霎儿风。"},"p51cea09bd89d-text-afc9b16798a1afe145d9":{"id":"p51cea09bd89d-text-afc9b16798a1afe145d9","person_id":"p51cea09bd89d","title":"南歌子","titles":["南歌子"],"text":"天上星河转，人间帘幕垂。\n凉生枕簟泪痕滋。\n起解罗衣、聊问夜何其。\n翠贴莲蓬小，金销藕叶稀。\n旧时天气旧时衣。\n只有情怀、不似旧家时。"},"p51cea09bd89d-text-d25b41ed371c976373a3":{"id":"p51cea09bd89d-text-d25b41ed371c976373a3","person_id":"p51cea09bd89d","title":"如梦令","titles":["如梦令"],"text":"常记溪亭日暮。\n沈醉不知归路。\n兴尽晚回舟，误入藕花深处。\n争渡。\n争渡。\n惊起一滩鸥鹭。"},"p51cea09bd89d-text-b42aa4c6e712e4efd584":{"id":"p51cea09bd89d-text-b42aa4c6e712e4efd584","person_id":"p51cea09bd89d","title":"新荷叶","titles":["新荷叶"],"text":"薄露初零，长宵共、永昼分停。\n绕水楼台，高耸万丈蓬瀛。\n芝兰为寿，相辉映、簪笏盈庭。\n花柔玉净，捧觞别有娉婷。\n鹤瘦松青，精神与、秋月争明。\n德行文章，素驰日下声名。\n东山高蹈，虽卿相、不足为荣。\n安石须起，要苏天下苍生。"},"p51cea09bd89d-text-48f0d8b0d8a621cc506e":{"id":"p51cea09bd89d-text-48f0d8b0d8a621cc506e","person_id":"p51cea09bd89d","title":"浣溪沙","titles":["浣溪沙"],"text":"小院闲窗春色深。\n重帘未卷影沈沈。\n倚楼无语理瑶琴。\n远岫出山催薄暮，细风吹雨弄轻阴。\n梨花欲谢恐难禁。"},"p51cea09bd89d-text-7b2c201b986c54a0f126":{"id":"p51cea09bd89d-text-7b2c201b986c54a0f126","person_id":"p51cea09bd89d","title":"分得知字韻","titles":["分得知字韻"],"text":"學詩三十年，緘口不求知。\n誰遣好奇士，相逢說項斯。"},"p51cea09bd89d-text-79bd02593860267f137b":{"id":"p51cea09bd89d-text-79bd02593860267f137b","person_id":"p51cea09bd89d","title":"浣溪沙","titles":["浣溪沙"],"text":"髻子伤春慵更梳。\n晚风庭院落梅初。\n淡云来往月疏疏。\n玉鸭熏炉闲瑞脑，朱樱斗帐掩流苏。\n通犀还解辟寒无。"},"p51cea09bd89d-text-aeaefbc958cee6378215":{"id":"p51cea09bd89d-text-aeaefbc958cee6378215","person_id":"p51cea09bd89d","title":"感懷","titles":["感懷"],"text":"寒窗敗几無書史，公路可憐竟至此。\n青州從事孔方君，終日紛紛喜生事。\n作詩謝絕聊閉門，燕寢凝香有佳思。\n靜中我乃得知交，烏有先生子虛子。"},"p51cea09bd89d-text-1c9c8b71145cfb5a039b":{"id":"p51cea09bd89d-text-1c9c8b71145cfb5a039b","person_id":"p51cea09bd89d","title":"曉夢","titles":["曉夢"],"text":"曉夢隨疏鐘，飄然躡雲霞。\n因緣安期生，邂逅萼綠華。\n秋風正無賴，吹盡玉井花。\n共看藕如船，同食棗如瓜。\n翩翩坐上客，意妙語亦佳。\n嘲辭鬬詭辨，活火分新茶。\n雖非助帝功，其樂莫可涯。\n人生能如此，何必歸故家。\n起來斂衣坐，掩耳厭喧嘩。\n心知不可見，念念猶咨嗟。"},"p51cea09bd89d-text-87e416a46a1d12dd148a":{"id":"p51cea09bd89d-text-87e416a46a1d12dd148a","person_id":"p51cea09bd89d","title":"蝶恋花","titles":["蝶恋花"],"text":"永夜恹恹欢意少。\n空梦长安，认取长安道。\n为报今年春色好。\n花光月影宜相照。\n随意杯盘虽草草。\n酒美梅酸，恰称人怀抱。\n醉莫插花花莫笑。\n可怜春似人将老。"},"p51cea09bd89d-text-4e762fd5c3f08aaca77f":{"id":"p51cea09bd89d-text-4e762fd5c3f08aaca77f","person_id":"p51cea09bd89d","title":"小重山","titles":["小重山"],"text":"春到长门春草青。\n江梅些子破，未开匀。\n碧云笼碾玉成尘。\n留晓梦，惊破一瓯春。\n花影压重门。\n疏帘铺淡月，好黄昏。\n二年三度负东君。\n归来也，著意过今春。"},"p51cea09bd89d-text-c6eb06e71d56368a98b6":{"id":"p51cea09bd89d-text-c6eb06e71d56368a98b6","person_id":"p51cea09bd89d","title":"添字丑奴儿・采桑子","titles":["添字丑奴儿・采桑子"],"text":"窗前谁种芭蕉树，阴满中庭。\n阴满中庭。\n叶叶心心，舒卷有馀情。\n伤心枕上三更雨，点滴霖霪。\n点滴霖霪。\n愁损北人，不惯起来听。"},"p51cea09bd89d-text-1ee9b6f545f8e848ceef":{"id":"p51cea09bd89d-text-1ee9b6f545f8e848ceef","person_id":"p51cea09bd89d","title":"鹧鸪天","titles":["鹧鸪天"],"text":"寒日萧萧上锁窗。\n梧桐应恨夜来霜。\n酒阑更喜团茶苦，梦断偏宜瑞脑香。\n秋已尽，日犹长。\n仲宣怀远更凄凉。\n不如随分尊前醉，莫负东篱菊蕊黄。"},"p51cea09bd89d-text-a7c82d9d7a0de492f04f":{"id":"p51cea09bd89d-text-a7c82d9d7a0de492f04f","person_id":"p51cea09bd89d","title":"菩萨蛮","titles":["菩萨蛮"],"text":"归鸿声断残云碧。\n背窗雪落炉烟直。\n烛底凤钗明。\n钗头人胜轻。\n角声催晓漏。\n曙色回牛斗。\n春意看花难。\n西风留旧寒。"},"p51cea09bd89d-text-2b24987948d4c3038232":{"id":"p51cea09bd89d-text-2b24987948d4c3038232","person_id":"p51cea09bd89d","title":"浣溪沙","titles":["浣溪沙"],"text":"淡荡春光寒食天。\n玉炉沈水袅残烟。\n梦回山枕隐花钿。\n海燕未来人斗草，江海已过柳生绵。\n黄昏疏雨湿秋千。"},"p51cea09bd89d-text-8acc07332317d4daa65c":{"id":"p51cea09bd89d-text-8acc07332317d4daa65c","person_id":"p51cea09bd89d","title":"摊破浣溪沙・山花子","titles":["摊破浣溪沙・山花子"],"text":"病起萧萧两鬓华。\n卧看残月上窗纱。\n豆蔻连梢煎熟水，莫分茶。\n枕上诗书闲处好，门前风景雨来佳。\n终日向人多酝藉，木犀花。"},"p51cea09bd89d-text-3d97e8acd3f320fb673b":{"id":"p51cea09bd89d-text-3d97e8acd3f320fb673b","person_id":"p51cea09bd89d","title":"清平乐","titles":["清平乐"],"text":"年年雪里。\n常插梅花醉。\n挼尽梅花无好意。\n赢得满衣清泪。\n今年海角天涯。\n萧萧两鬓生华。\n看取晚来风势，故应难看梅花。"},"p51cea09bd89d-text-31595b0281fe73d8ac30":{"id":"p51cea09bd89d-text-31595b0281fe73d8ac30","person_id":"p51cea09bd89d","title":"渔家傲","titles":["渔家傲"],"text":"天接云涛连晓雾。\n星河欲转千帆舞。\n彷佛梦魂归帝所。\n闻天语。\n殷勤问我归何处。\n我报路长嗟日暮。\n学诗谩有惊人句。\n九万里风鹏正举。\n风休住。\n蓬舟吹取三山去。"},"p51cea09bd89d-text-ed44e90586a63eaa89fa":{"id":"p51cea09bd89d-text-ed44e90586a63eaa89fa","person_id":"p51cea09bd89d","title":"偶成","titles":["偶成"],"text":"十五年前花月底，相從曾賦賞花詩。\n今看花月渾相似，安得情懷似往時。"},"p51cea09bd89d-text-b59602df7cc5728d68f9":{"id":"p51cea09bd89d-text-b59602df7cc5728d68f9","person_id":"p51cea09bd89d","title":"菩萨蛮","titles":["菩萨蛮"],"text":"风柔日薄春犹早。\n夹衫乍著心情好。\n睡起觉微寒。\n梅花鬓上残。\n故乡何处是。\n忘了除非醉。\n沈水卧时烧。\n香消酒未消。"},"p51cea09bd89d-text-21f9a26936a24ad36e01":{"id":"p51cea09bd89d-text-21f9a26936a24ad36e01","person_id":"p51cea09bd89d","title":"好事近","titles":["好事近"],"text":"风定落花深，帘外拥红堆雪。\n长记海棠开后，正是伤春时节。\n酒阑歌罢玉尊空，青缸暗明灭。\n魂梦不堪幽怨，更一声啼鴂。"},"p51cea09bd89d-text-edd16b4eb35f642aff38":{"id":"p51cea09bd89d-text-edd16b4eb35f642aff38","person_id":"p51cea09bd89d","title":"长寿乐","titles":["长寿乐"],"text":"微寒应候。\n望日边六叶，阶蓂初秀。\n爱景欲挂扶桑，漏残银箭，杓回摇斗。\n庆高闳此际，掌上一颗明珠剖。\n有令容淑质，归逢佳偶。\n到如今，昼锦满堂贵胄。\n荣耀，文步紫禁，一一金章绿绶。\n更值棠棣连阴，虎符熊轼，夹河分守。\n况青云咫尺，朝暮重入承明后。\n看彩衣争献，兰羞玉酎。\n祝千龄，借指松椿比寿。"},"p51cea09bd89d-text-d67952a4dba673ce81db":{"id":"p51cea09bd89d-text-d67952a4dba673ce81db","person_id":"p51cea09bd89d","title":"武陵春","titles":["武陵春"],"text":"风住尘香花已尽，日晚倦梳头。\n物是人非事事休。\n欲语泪先流。\n闻说双溪春尚好，也拟泛轻舟。\n只恐双溪舴艋舟。\n载不动、许多愁。"},"p51cea09bd89d-text-ced9e2cfc57058b30b57":{"id":"p51cea09bd89d-text-ced9e2cfc57058b30b57","person_id":"p51cea09bd89d","title":"婺州八咏樓","titles":["婺州八咏樓"],"text":"千古風流八詠樓，江山留與後人愁。\n水通南國三千里，氣壓江城十四州。"},"p51cea09bd89d-text-782e45610c81647eac08":{"id":"p51cea09bd89d-text-782e45610c81647eac08","person_id":"p51cea09bd89d","title":"永遇乐","titles":["永遇乐"],"text":"落日熔金，暮云合璧，人在何处。\n染柳烟浓，吹梅笛怨，春意知几许。\n元宵佳节，融和天气，次第岂无风雨。\n来相召、香车宝马，谢他酒朋诗侣。\n中州盛日，闺门多暇，记得偏重三五。\n铺翠冠儿，拈金雪柳，簇带争济楚。\n如今憔悴，风鬟霜鬓，怕见夜间出去。\n不如向、帘儿底下，听人笑语。"},"p51cea09bd89d-text-11191ca9bcf0ba112e17":{"id":"p51cea09bd89d-text-11191ca9bcf0ba112e17","person_id":"p51cea09bd89d","title":"春帖子 皇帝閣","titles":["春帖子 皇帝閣"],"text":"莫進黄金簟，新除玉局牀。\n春風送庭燎，不復用沈香。"},"p51cea09bd89d-text-b04c6a59c649d2053919":{"id":"p51cea09bd89d-text-b04c6a59c649d2053919","person_id":"p51cea09bd89d","title":"春帖子 貴妃閣","titles":["春帖子 貴妃閣"],"text":"金環半后禮，鉤弋比昭陽。\n春生百子帳，喜入萬年觴。"},"p51cea09bd89d-text-e5520684aa5bd142bf0d":{"id":"p51cea09bd89d-text-e5520684aa5bd142bf0d","person_id":"p51cea09bd89d","title":"端午帖子 皇帝閣","titles":["端午帖子 皇帝閣"],"text":"日月堯天大，璿璣舜歷長。\n側聞行殿帳，多集上書囊。"},"p51cea09bd89d-text-5ec4f21d35a6696f54b5":{"id":"p51cea09bd89d-text-5ec4f21d35a6696f54b5","person_id":"p51cea09bd89d","title":"端午帖子 夫人閣","titles":["端午帖子 夫人閣"],"text":"三宮催解糉，妝罷未天明。\n便面天題字，歌頭御賜名。"},"p51cea09bd89d-text-9a13789e393a0e28067a":{"id":"p51cea09bd89d-text-9a13789e393a0e28067a","person_id":"p51cea09bd89d","title":"声声慢","titles":["声声慢"],"text":"寻寻觅觅，冷冷清清，凄凄惨惨戚戚。\n乍暖还寒时候，最难将息。\n三杯两盏淡酒，怎敌他、晚来风急。\n雁过也，正伤心，却是旧时相识。\n满地黄花堆积。\n憔悴损，如今有谁忺摘。\n守著窗儿，独自怎生得黑。\n梧桐更兼细雨，到黄昏、点点滴滴。\n这次第，怎一个、愁字了得。"}}}
