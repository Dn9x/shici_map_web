3773daa81572dff82c95-part-01","status":"automatic","work_id":"p21321ecd1a34-text-71a2716b6f6f5df92244","title":"送皇甫司錄赴黔南幕"}]},"p21321ecd1a34-item-7472820d8a71ca9b66aa":{"id":"p21321ecd1a34-item-7472820d8a71ca9b66aa","person_id":"p21321ecd1a34","title":"送內鄉張主簿赴任","units":[{"id":"p21321ecd1a34-item-7472820d8a71ca9b66aa-part-01","status":"automatic","work_id":"p21321ecd1a34-text-29ca5bbef0af1bc6149b","title":"送內鄉張主簿赴任"}]},"p21321ecd1a34-item-472046f575d255eefb77":{"id":"p21321ecd1a34-item-472046f575d255eefb77","person_id":"p21321ecd1a34","title":"關試後嘉會里聞蟬感懷呈主司","units":[{"id":"p21321ecd1a34-item-472046f575d255eefb77-part-01","status":"automatic","work_id":"p21321ecd1a34-text-061f078144bd5279f7df","title":"關試後嘉會里聞蟬感懷呈主司"}]},"p21321ecd1a34-item-a77bdff7c233bd7987b8":{"id":"p21321ecd1a34-item-a77bdff7c233bd7987b8","person_id":"p21321ecd1a34","title":"酬陳摽評事喜及第與段何共貽","units":[{"id":"p21321ecd1a34-item-a77bdff7c233bd7987b8-part-01","status":"automatic","work_id":"p21321ecd1a34-text-8f13a64af2a6fe132e44","title":"酬陳摽評事喜及第與段何共貽"}]},"p21321ecd1a34-item-26fe5cdb3f0785b6ec35":{"id":"p21321ecd1a34-item-26fe5cdb3f0785b6ec35","person_id":"p21321ecd1a34","title":"送造微上人歸淮南覲兄","units":[{"id":"p21321ecd1a34-item-26fe5cdb3f0785b6ec35-part-01","status":"automatic","work_id":"p21321ecd1a34-text-38896779004e3d8a2647","title":"送造微上人歸淮南覲兄"}]},"p21321ecd1a34-item-d40d3699b849e449c595":{"id":"p21321ecd1a34-item-d40d3699b849e449c595","person_id":"p21321ecd1a34","title":"萬年厲員外宅殘菊","units":[{"id":"p21321ecd1a34-item-d40d3699b849e449c595-part-01","status":"automatic","work_id":"p21321ecd1a34-text-b51cce44d9fe5b5c9e8c","title":"萬年厲員外宅殘菊"}]},"p21321ecd1a34-item-863624ee1f824a422b9d":{"id":"p21321ecd1a34-item-863624ee1f824a422b9d","person_id":"p21321ecd1a34","title":"成名後將歸茅山酬羣公見送","units":[{"id":"p21321ecd1a34-item-863624ee1f824a422b9d-part-01","status":"automatic","work_id":"p21321ecd1a34-text-c10a8de2c5b710034a5a","title":"成名後將歸茅山酬羣公見送"}]},"p21321ecd1a34-item-77c85cec885bd5091c5e":{"id":"p21321ecd1a34-item-77c85cec885bd5091c5e","person_id":"p21321ecd1a34","title":"酬均州鄭使君見送歸茅山","units":[{"id":"p21321ecd1a34-item-77c85cec885bd5091c5e-part-01","status":"automatic","work_id":"p21321ecd1a34-text-826695776dc9e227c1af","title":"酬均州鄭使君見送歸茅山"}]},"p21321ecd1a34-item-9e7c1da69824a998e2e2":{"id":"p21321ecd1a34-item-9e7c1da69824a998e2e2","person_id":"p21321ecd1a34","title":"行經褒城寄興元姚從事","units":[{"id":"p21321ecd1a34-item-9e7c1da69824a998e2e2-part-01","status":"automatic","work_id":"p21321ecd1a34-text-b83ca975ee8992d9eef6","title":"行經褒城寄興元姚從事"}]},"p21321ecd1a34-item-d48740ef8bcca944bd0f":{"id":"p21321ecd1a34-item-d48740ef8bcca944bd0f","person_id":"p21321ecd1a34","title":"武宗挽歌詞二首 一 / 武宗挽歌詞二首 二","units":[{"id":"p21321ecd1a34-item-d48740ef8bcca944bd0f-part-01","status":"automatic","work_id":"p21321ecd1a34-text-29f2cb511eb884a6f198","title":"武宗挽歌詞二首 一"},{"id":"p21321ecd1a34-item-d48740ef8bcca944bd0f-part-02","status":"automatic","work_id":"p21321ecd1a34-text-0ac6905ee43339a098bc","title":"武宗挽歌詞二首 二"}]}},"works":{"p21321ecd1a34-text-6c41b96c64aae9ab712a":{"id":"p21321ecd1a34-text-6c41b96c64aae9ab712a","person_id":"p21321ecd1a34","title":"送徐五綸南行過吳","titles":["送徐五綸南行過吳"],"text":"吳門東去路三千，到得閶門暫泊船。\n老父出迎應倒屣，貧居江上信誰傳。"},"p21321ecd1a34-text-aa473b0f8c448eebedd6":{"id":"p21321ecd1a34-text-aa473b0f8c448eebedd6","person_id":"p21321ecd1a34","title":"秋夜長安病後作","titles":["秋夜長安病後作"],"text":"秋中帝里經旬雨，晴後蟬聲更不聞。\n牢落閑庭新病起，故鄉南去雁成羣。"},"p21321ecd1a34-text-8578ddcd5852e1fb7789":{"id":"p21321ecd1a34-text-8578ddcd5852e1fb7789","person_id":"p21321ecd1a34","title":"下第後曉坐","titles":["下第後曉坐"],"text":"遠客滯都邑，老驚時節催。\n海邊身夢覺，枕上鼓聲來。\n起見銀河沒，坐知閶闔開。\n何爲此生內，終夜泣塵埃。"},"p21321ecd1a34-text-f773767ca5a0be251c4b":{"id":"p21321ecd1a34-text-f773767ca5a0be251c4b","person_id":"p21321ecd1a34","title":"會中賦得新年","titles":["會中賦得新年"],"text":"萬古如昨日，一年加一晨。\n暗生無限事，潛老幾多人。\n歸路舊侶盡，故鄉回鴈新。\n那堪獨惆悵，猶是白衣身。"},"p21321ecd1a34-text-7f045359f37a3ad556a7":{"id":"p21321ecd1a34-text-7f045359f37a3ad556a7","person_id":"p21321ecd1a34","title":"寄九華山費拾遺","titles":["寄九華山費拾遺"],"text":"先生九華隱，鳥道隔塵埃。\n石室和雲住，山田引燒開。\n久閑仙客降，高臥詔書來。\n一入深林去，人間更不回。"},"p21321ecd1a34-text-b305607efc3a6fadeb9a":{"id":"p21321ecd1a34-text-b305607efc3a6fadeb9a","person_id":"p21321ecd1a34","title":"崔卿雙白鷺","titles":["崔卿雙白鷺"],"text":"朝客高清愛水禽，綠波雙鷺在園林。\n立當風裏絲搖急，步遶池邊字印深。\n刷羽競生堪畫勢，依泉各有取魚心。\n我鄉多傍門前見，坐覺煙波思不禁。"},"p21321ecd1a34-text-7bd4cc603f2eb7e02ddc":{"id":"p21321ecd1a34-text-7bd4cc603f2eb7e02ddc","person_id":"p21321ecd1a34","title":"送于中丞入回鶻","titles":["送于中丞入回鶻"],"text":"風沙萬里行，邊色看雙旌。\n去展中華禮，將安外國情。\n朝衣驚異俗，牙帳見新正。\n料得歸來路，春深草未生。"},"p21321ecd1a34-text-a7afe84d30e2b47bfddc":{"id":"p21321ecd1a34-text-a7afe84d30e2b47bfddc","person_id":"p21321ecd1a34","title":"陳情上鄭主司","titles":["陳情上鄭主司"],"text":"登第久無緣，歸情思渺然。\n藝慙公道日，身賤太平年。\n未識笙歌樂，虛逢歲月遷。\n羈懷吟獨苦，愁眼媿花妍。\n求達非榮己，修辭欲繼先。\n秦城春十二，吳苑路三千。\n茅屋山嵐入，柴門海浪連。\n遙心猶送鴈，歸夢不離船。\n時節思家夜，風霜作客天。\n庭闈乖旦暮，兄弟阻團圓。\n朝乏新知己，邨荒舊業田。\n受恩期望外，效死誓生前。\n願察爲裘意，彷徉和角篇。\n懇情今吐盡，萬一冀哀憐。"},"p21321ecd1a34-text-138db1370796bbd97edc":{"id":"p21321ecd1a34-text-138db1370796bbd97edc","person_id":"p21321ecd1a34","title":"天津橋晚望","titles":["天津橋晚望"],"text":"晴登洛橋望，寒色古槐稀。\n流水東不息，翠華西未歸。\n雲收中岳近，鐘出後宮微。\n回首禁門路，羣鴉度落暉。"},"p21321ecd1a34-text-80b8fe6da462a64a7024":{"id":"p21321ecd1a34-text-80b8fe6da462a64a7024","person_id":"p21321ecd1a34","title":"月夜登王屋仙壇","titles":["月夜登王屋仙壇"],"text":"月臨峰頂壇，氣爽覺天寬。\n身去銀河近，衣霑玉露寒。\n雲中日已赤，山外夜初殘。\n即此是仙境，惟愁再上難。"},"p21321ecd1a34-text-51b2d1b95889d65a89ec":{"id":"p21321ecd1a34-text-51b2d1b95889d65a89ec","person_id":"p21321ecd1a34","title":"送馬戴入山","titles":["送馬戴入山"],"text":"古木亂重重，何人識去蹤。\n斜陽收萬壑，圓月上三峰。\n雲裏泉縈石，窗間鳥下松。\n唯應採藥客，時與此相逢。"},"p21321ecd1a34-text-0bb66394bce1d51a1ec8":{"id":"p21321ecd1a34-text-0bb66394bce1d51a1ec8","person_id":"p21321ecd1a34","title":"送李廓侍御赴劒南","titles":["送李廓侍御赴劒南"],"text":"鳥道見狼烟，元戎正急賢。\n圖書借朋友，吟詠入戈鋋。\n山色城池近，江聲鼓角連。\n不應誇戰勝，知在檄蠻篇。"},"p21321ecd1a34-text-c5e15b3d4361eb97beed":{"id":"p21321ecd1a34-text-c5e15b3d4361eb97beed","person_id":"p21321ecd1a34","title":"送杭州姚員外","titles":["送杭州姚員外"],"text":"浙江江上郡，楊柳到時春。\n塹起背城雁，帆分向海人。\n嶠雲侵寺吐，汀月隔樓新。\n靜理更何事，還應詠白蘋。"},"p21321ecd1a34-text-00b417578b265c0bd12e":{"id":"p21321ecd1a34-text-00b417578b265c0bd12e","person_id":"p21321ecd1a34","title":"送喻鳧春歸江南","titles":["送喻鳧春歸江南"],"text":"去年登第客，今日及春歸。\n鸎影離秦馬，蓮香入楚衣。\n里閭爭慶賀，親戚共光輝。\n唯我門前浦，苔應滿釣磯。"},"p21321ecd1a34-text-8b2f940a3c0fef51ee61":{"id":"p21321ecd1a34-text-8b2f940a3c0fef51ee61","person_id":"p21321ecd1a34","title":"冬日寄蔡先輩校書京","titles":["冬日寄蔡先輩校書京"],"text":"弱冠下茅嶺，中年道不行。\n舊交因貴絕，新月對愁生。\n旅思風飄葉，歸心鴈過城。\n惟君知我苦，何異爨桐鳴。"},"p21321ecd1a34-text-ba93e903024b922dc27d":{"id":"p21321ecd1a34-text-ba93e903024b922dc27d","person_id":"p21321ecd1a34","title":"與無可宿輝公院","titles":["與無可宿輝公院"],"text":"夜僧同靜語，秋寺近嚴城。\n世路雖多梗，玄心各自明。\n寒池清月彩，危閣聽林聲。\n儻許雙摩頂，隨緣萬劫生。"},"p21321ecd1a34-text-9d73a0f6d8f8a06d5a02":{"id":"p21321ecd1a34-text-9d73a0f6d8f8a06d5a02","person_id":"p21321ecd1a34","title":"題馬儒乂石門山居","titles":["題馬儒乂石門山居"],"text":"尋君石門隱，山近漸無青。\n鹿迹入柴戶，樹身穿草亭。\n雲低收藥徑，苔惹取泉瓶。\n此地客難到，夜琴誰共聽。"},"p21321ecd1a34-text-71a2716b6f6f5df92244":{"id":"p21321ecd1a34-text-71a2716b6f6f5df92244","person_id":"p21321ecd1a34","title":"送皇甫司錄赴黔南幕","titles":["送皇甫司錄赴黔南幕"],"text":"黔南從事客，祿利先來饒。\n官受外臺屈，家移一舸遙。\n夜猿聲不斷，寒木葉微凋。\n遠別因多感，新郎倍寂寥。"},"p21321ecd1a34-text-29ca5bbef0af1bc6149b":{"id":"p21321ecd1a34-text-29ca5bbef0af1bc6149b","person_id":"p21321ecd1a34","title":"送內鄉張主簿赴任","titles":["送內鄉張主簿赴任"],"text":"松窗久是飡霞客，山縣新爲主印官。\n混俗故來分利祿，不教長作異人看。"},"p21321ecd1a34-text-061f078144bd5279f7df":{"id":"p21321ecd1a34-text-061f078144bd5279f7df","person_id":"p21321ecd1a34","title":"關試後嘉會里聞蟬感懷呈主司","titles":["關試後嘉會里聞蟬感懷呈主司"],"text":"昔聞驚節換，常抱異鄉愁。\n今聽當命遂，方歡上國遊。\n吟纔依樹午，風已報庭秋。\n併覺聲聲好，懷恩忽淚流。"},"p21321ecd1a34-text-8f13a64af2a6fe132e44":{"id":"p21321ecd1a34-text-8f13a64af2a6fe132e44","person_id":"p21321ecd1a34","title":"酬陳摽評事喜及第與段何共貽","titles":["酬陳摽評事喜及第與段何共貽"],"text":"至公平得意，自喜不因媒。\n榜入金門去，名從玉案來。\n歡情聽鳥語，笑眼對花開。\n若擬華筵賀，當期醉百杯。"},"p21321ecd1a34-text-38896779004e3d8a2647":{"id":"p21321ecd1a34-text-38896779004e3d8a2647","person_id":"p21321ecd1a34","title":"送造微上人歸淮南覲兄","titles":["送造微上人歸淮南覲兄"],"text":"到家方坐夏，柳巷對兄禪。\n雨斷蕪城路，虹分建鄴天。\n赴齋隨野鶴，迎水上漁船。\n終擬歸何處，三湘思渺然。"},"p21321ecd1a34-text-b51cce44d9fe5b5c9e8c":{"id":"p21321ecd1a34-text-b51cce44d9fe5b5c9e8c","person_id":"p21321ecd1a34","title":"萬年厲員外宅殘菊","titles":["萬年厲員外宅殘菊"],"text":"纔過重陽後，人心已爲殘。\n近霜須苦惜，帶蝶更宜看。\n色減頻經雨，香銷恐漸寒。\n今朝陶令宅，不醉却應難。"},"p21321ecd1a34-text-c10a8de2c5b710034a5a":{"id":"p21321ecd1a34-text-c10a8de2c5b710034a5a","person_id":"p21321ecd1a34","title":"成名後將歸茅山酬羣公見送","titles":["成名後將歸茅山酬羣公見送"],"text":"此名誰不得，人賀至公難。\n素業承家了，離筵去國歡。\n暮天行鴈斷，曉渡落潮寒。\n舊隱茅峰下，松根石上盤。"},"p21321ecd1a34-text-826695776dc9e227c1af":{"id":"p21321ecd1a34-text-826695776dc9e227c1af","person_id":"p21321ecd1a34","title":"酬均州鄭使君見送歸茅山","titles":["酬均州鄭使君見送歸茅山"],"text":"餞行詩意厚，惜別獨筵重。\n解纜城邊柳，還舟海上峰。\n飲猨當瀨見，浴鳥帶槎逢。\n吏隱應難逐，爲霖是蟄龍。"},"p21321ecd1a34-text-b83ca975ee8992d9eef6":{"id":"p21321ecd1a34-text-b83ca975ee8992d9eef6","person_id":"p21321ecd1a34","title":"行經褒城寄興元姚從事","titles":["行經褒城寄興元姚從事"],"text":"往歲客龜城，同時聽鹿鳴。\n君兼蓮幕貴，我得桂枝榮。\n棧閣危初盡，褒川路忽平。\n心期一壺酒，靜話別離情。"},"p21321ecd1a34-text-29f2cb511eb884a6f198":{"id":"p21321ecd1a34-text-29f2cb511eb884a6f198","person_id":"p21321ecd1a34","title":"武宗挽歌詞二首 一","titles":["武宗挽歌詞二首 一"],"text":"睿略皇威遠，英風帝業開。\n竹林方受位，薤露忽興哀。\n靜塞妖星落，和戎貴主回。\n龍髯不可附，空見望仙臺。"},"p21321ecd1a34-text-0ac6905ee43339a098bc":{"id":"p21321ecd1a34-text-0ac6905ee43339a098bc","person_id":"p21321ecd1a34","title":"武宗挽歌詞二首 二","titles":["武宗挽歌詞二首 二"],"text":"蒼生期漸泰，皇道欲中興。\n國用銷靈像，農功復冗僧。\n冕旒辭北闕，歌舞怨西陵。\n惟有金莖石，長宵對玉繩。"}}}
