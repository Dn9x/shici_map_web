":"p49eb7bc0295e-item-36fb2f63962011639c22-part-01","status":"automatic","work_id":"p49eb7bc0295e-text-e32973695e2affd371c6","title":"九日送別"}]},"p49eb7bc0295e-item-bdebee7e1f1006f2a4bb":{"id":"p49eb7bc0295e-item-bdebee7e1f1006f2a4bb","person_id":"p49eb7bc0295e","title":"登鸛雀樓","units":[{"id":"p49eb7bc0295e-item-bdebee7e1f1006f2a4bb-part-01","status":"automatic","work_id":"p49eb7bc0295e-text-33836d104644fd0bd8ae","title":"登鸛雀樓"}]}},"works":{"p49eb7bc0295e-text-4bc4e21b398622fb2154":{"id":"p49eb7bc0295e-text-4bc4e21b398622fb2154","person_id":"p49eb7bc0295e","title":"宴詞","titles":["宴詞"],"text":"長堤春水綠悠悠，畎入漳河一道流。\n莫聽聲聲催去櫂，桃溪淺處不勝舟。"},"p49eb7bc0295e-text-cc3f376eac2dbf3de101":{"id":"p49eb7bc0295e-text-cc3f376eac2dbf3de101","person_id":"p49eb7bc0295e","title":"送別","titles":["送別"],"text":"楊柳東風樹，青青夾御河。\n近來攀折苦，應爲別離多。"},"p49eb7bc0295e-text-e32973695e2affd371c6":{"id":"p49eb7bc0295e-text-e32973695e2affd371c6","person_id":"p49eb7bc0295e","title":"九日送別","titles":["九日送別"],"text":"薊庭蕭瑟故人稀，何處登高且送歸。\n今日暫同芳菊酒，明朝應作斷蓬飛。"},"p49eb7bc0295e-text-33836d104644fd0bd8ae":{"id":"p49eb7bc0295e-text-33836d104644fd0bd8ae","person_id":"p49eb7bc0295e","title":"登鸛雀樓","titles":["登鸛雀樓"],"text":"白日依山盡，黃河入海流。\n欲窮千里目，更上一層樓。"}}}
