em_ids":[]},"event-456b66e3467badcbfd8c":{"year":1059,"lon":116.644148,"lat":27.574743,"item_ids":[]}},"items":{"p2bddb4ad13df-item-b803113bd05f65cbc4d3":{"id":"p2bddb4ad13df-item-b803113bd05f65cbc4d3","person_id":"p2bddb4ad13df","title":"","units":[]},"p2bddb4ad13df-item-c24407a0680dd0aa35d2":{"id":"p2bddb4ad13df-item-c24407a0680dd0aa35d2","person_id":"p2bddb4ad13df","title":"","units":[]},"p2bddb4ad13df-item-b34e93e054a2db048a85":{"id":"p2bddb4ad13df-item-b34e93e054a2db048a85","person_id":"p2bddb4ad13df","title":"","units":[]},"p2bddb4ad13df-item-b6f494d7b5d931857804":{"id":"p2bddb4ad13df-item-b6f494d7b5d931857804","person_id":"p2bddb4ad13df","title":"","units":[]},"p2bddb4ad13df-item-38bbe213f44ae4deb392":{"id":"p2bddb4ad13df-item-38bbe213f44ae4deb392","person_id":"p2bddb4ad13df","title":"","units":[]},"p2bddb4ad13df-item-7635ec55919439a54864":{"id":"p2bddb4ad13df-item-7635ec55919439a54864","person_id":"p2bddb4ad13df","title":"","units":[]},"p2bddb4ad13df-item-625906b7557be6400587":{"id":"p2bddb4ad13df-item-625906b7557be6400587","person_id":"p2bddb4ad13df","title":"","units":[]},"p2bddb4ad13df-item-388634ad78f5b21ecfdd":{"id":"p2bddb4ad13df-item-388634ad78f5b21ecfdd","person_id":"p2bddb4ad13df","title":"聞女子虐疾偶書二十四韻寄示","units":[{"id":"p2bddb4ad13df-item-388634ad78f5b21ecfdd-part-01","status":"automatic","work_id":"p2bddb4ad13df-text-1302b8f4f05869ac945a","title":"聞女子虐疾偶書二十四韻寄示"}]},"p2bddb4ad13df-item-68c595e4e484bb6e0345":{"id":"p2bddb4ad13df-item-68c595e4e484bb6e0345","person_id":"p2bddb4ad13df","title":"","units":[]},"p2bddb4ad13df-item-56f2c56110380eaf177f":{"id":"p2bddb4ad13df-item-56f2c56110380eaf177f","person_id":"p2bddb4ad13df","title":"題靈陽宮","units":[{"id":"p2bddb4ad13df-item-56f2c56110380eaf177f-part-01","status":"automatic","work_id":"p2bddb4ad13df-text-eea898bacf45369b1232","title":"題靈陽宮"}]},"p2bddb4ad13df-item-64fd3ba2349c14b98bfe":{"id":"p2bddb4ad13df-item-64fd3ba2349c14b98bfe","person_id":"p2bddb4ad13df","title":"龜峰精舍","units":[{"id":"p2bddb4ad13df-item-64fd3ba2349c14b98bfe-part-01","status":"automatic","work_id":"p2bddb4ad13df-text-b2a9e13698b9cc034198","title":"龜峰精舍"}]},"p2bddb4ad13df-item-791cba87af2f96f41c9e":{"id":"p2bddb4ad13df-item-791cba87af2f96f41c9e","person_id":"p2bddb4ad13df","title":"葛陂懷古","units":[{"id":"p2bddb4ad13df-item-791cba87af2f96f41c9e-part-01","status":"automatic","work_id":"p2bddb4ad13df-text-427793260ad90ce6d379","title":"葛陂懷古"}]},"p2bddb4ad13df-item-85c7b8ec807472c5e096":{"id":"p2bddb4ad13df-item-85c7b8ec807472c5e096","person_id":"p2bddb4ad13df","title":"葛陂逢何道士","units":[{"id":"p2bddb4ad13df-item-85c7b8ec807472c5e096-part-01","status":"automatic","work_id":"p2bddb4ad13df-text-afc74177ddd568757ea4","title":"葛陂逢何道士"}]}},"works":{"p2bddb4ad13df-text-1302b8f4f05869ac945a":{"id":"p2bddb4ad13df-text-1302b8f4f05869ac945a","person_id":"p2bddb4ad13df","title":"聞女子虐疾偶書二十四韻寄示","titles":["聞女子虐疾偶書二十四韻寄示"],"text":"昨日家人來，言汝苦寒熱。\n想由卑濕地，頗失飲食節。\n脾官驕不治，氣馬癡如絏。\n乃致四體煩，故當雙日發。\n江南此疾多，理不憂顛越。\n顧汝僅毀齒，何力禁喘噎。\n寄書詰醫師，有藥且嚼啜。\n方經固靈應，病根終翦滅。\n但恐祟所爲，嘗聞里中說。\n茲地有罔兩，乘時相罥結。\n嗟哉鬼無知，何於我爲孽。\n我本重脩飾，胸中掬冰雪。\n禍淫雖甚苛，無所可挑抉。\n疑是饕餮魂，私求盤碗設。\n盡室唯琴書，何路致葷血。\n無錢顧越巫，刀劍百斬决。\n徒恣彼昏邪，公然敢抄撮。\n吾聞上帝靈，網目匪疎缺。\n行當悉追捕，汝苦旦夕歇。\n慈愛早有加，憶念今逾切。\n塵勞差可畏，歸計又云輟。\n所生能劬勞，祖母矧聰哲。\n羸卧縱未蘇，撫視諒非拙。\n勉勉多自安，風來信勿絕。"},"p2bddb4ad13df-text-eea898bacf45369b1232":{"id":"p2bddb4ad13df-text-eea898bacf45369b1232","person_id":"p2bddb4ad13df","title":"題靈陽宮","titles":["題靈陽宮"],"text":"費君投杖處，行客過彷徨。\n水面風雷散，沙頭草木荒。\n一壺誰世界，千古共凄凉。\n大塊偏勞我，燒丹未有方。"},"p2bddb4ad13df-text-b2a9e13698b9cc034198":{"id":"p2bddb4ad13df-text-b2a9e13698b9cc034198","person_id":"p2bddb4ad13df","title":"龜峰精舍","titles":["龜峰精舍"],"text":"去縣二十里，路平時正春。\n四山唯有石，一寺更無塵。\n融結疑天意，經營憶古人。\n但知安樂處，何必是金身。"},"p2bddb4ad13df-text-427793260ad90ce6d379":{"id":"p2bddb4ad13df-text-427793260ad90ce6d379","person_id":"p2bddb4ad13df","title":"葛陂懷古","titles":["葛陂懷古"],"text":"長房化去已千年，鬼魅紛紛不畏天。\n老鼈若來爲太守，何人殺向葛陂邊。"},"p2bddb4ad13df-text-afc74177ddd568757ea4":{"id":"p2bddb4ad13df-text-afc74177ddd568757ea4","person_id":"p2bddb4ad13df","title":"葛陂逢何道士","titles":["葛陂逢何道士"],"text":"十數年前別我行，相逢猶是舊顔形。\n琴聲漸古聽來淡，藥味雖凡試最靈。\n出有酒錢天下富，住無家地浪頭萍。\n神仙可學應須學，萬里蓬萊一點青。"}}}
