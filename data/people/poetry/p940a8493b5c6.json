:"automatic","work_id":"p940a8493b5c6-text-bab86259b430fcb0e7ee","title":"寄題福州程進道止戈堂二首  其二"}]},"p940a8493b5c6-item-1896cae717164fcd13d4":{"id":"p940a8493b5c6-item-1896cae717164fcd13d4","person_id":"p940a8493b5c6","title":"次韻李丞相送行二首  其一 / 次韻李丞相送行二首  其二","units":[{"id":"p940a8493b5c6-item-1896cae717164fcd13d4-part-01","status":"automatic","work_id":"p940a8493b5c6-text-19f91e0168fa235058a7","title":"次韻李丞相送行二首  其一"},{"id":"p940a8493b5c6-item-1896cae717164fcd13d4-part-02","status":"automatic","work_id":"p940a8493b5c6-text-52a4704679bf58f38984","title":"次韻李丞相送行二首  其二"}]},"p940a8493b5c6-item-fac8fca0b55b6eb5fd04":{"id":"p940a8493b5c6-item-fac8fca0b55b6eb5fd04","person_id":"p940a8493b5c6","title":"故相少師李公挽詩  其一","units":[{"id":"p940a8493b5c6-item-fac8fca0b55b6eb5fd04-part-01","status":"automatic","work_id":"p940a8493b5c6-text-445572fb48bca73d91b6","title":"故相少師李公挽詩  其一"}]},"p940a8493b5c6-item-bc355377045829ef5ea4":{"id":"p940a8493b5c6-item-bc355377045829ef5ea4","person_id":"p940a8493b5c6","title":"故相少師李公挽詩  其二","units":[{"id":"p940a8493b5c6-item-bc355377045829ef5ea4-part-01","status":"automatic","work_id":"p940a8493b5c6-text-1d1a79f7af09d40f8006","title":"故相少師李公挽詩  其二"}]},"p940a8493b5c6-item-3628948def2b7cf68aea":{"id":"p940a8493b5c6-item-3628948def2b7cf68aea","person_id":"p940a8493b5c6","title":"","units":[]},"p940a8493b5c6-item-edcd649f85e723561072":{"id":"p940a8493b5c6-item-edcd649f85e723561072","person_id":"p940a8493b5c6","title":"","units":[]},"p940a8493b5c6-item-1fa88aab4c7ed5b3ebb2":{"id":"p940a8493b5c6-item-1fa88aab4c7ed5b3ebb2","person_id":"p940a8493b5c6","title":"","units":[]},"p940a8493b5c6-item-8d01b5b25d0d1e77a610":{"id":"p940a8493b5c6-item-8d01b5b25d0d1e77a610","person_id":"p940a8493b5c6","title":"次韻蘇粹之發幹見贈  其一","units":[{"id":"p940a8493b5c6-item-8d01b5b25d0d1e77a610-part-01","status":"automatic","work_id":"p940a8493b5c6-text-1d09c65385198b289d23","title":"次韻蘇粹之發幹見贈  其一"}]},"p940a8493b5c6-item-8743543ac1bad902cb92":{"id":"p940a8493b5c6-item-8743543ac1bad902cb92","person_id":"p940a8493b5c6","title":"次韻蘇粹之發幹見贈  其二","units":[{"id":"p940a8493b5c6-item-8743543ac1bad902cb92-part-01","status":"automatic","work_id":"p940a8493b5c6-text-cbe5020c7f5fe87aa2be","title":"次韻蘇粹之發幹見贈  其二"}]},"p940a8493b5c6-item-1a2f209fc73cb5d98f1a":{"id":"p940a8493b5c6-item-1a2f209fc73cb5d98f1a","person_id":"p940a8493b5c6","title":"初歸筠荘蘇粹之以詩見貽次韻答之  其一","units":[{"id":"p940a8493b5c6-item-1a2f209fc73cb5d98f1a-part-01","status":"automatic","work_id":"p940a8493b5c6-text-5c1f2a0b993855aef383","title":"初歸筠荘蘇粹之以詩見貽次韻答之  其一"}]},"p940a8493b5c6-item-74e3582c1fd54ce614c2":{"id":"p940a8493b5c6-item-74e3582c1fd54ce614c2","person_id":"p940a8493b5c6","title":"","units":[]},"p940a8493b5c6-item-2faa1c240be75bba1092":{"id":"p940a8493b5c6-item-2faa1c240be75bba1092","person_id":"p940a8493b5c6","title":"","units":[]},"p940a8493b5c6-item-bd64b7e996cf4b4ff48b":{"id":"p940a8493b5c6-item-bd64b7e996cf4b4ff48b","person_id":"p940a8493b5c6","title":"","units":[]},"p940a8493b5c6-item-516b6d5e9b40f81fc09a":{"id":"p940a8493b5c6-item-516b6d5e9b40f81fc09a","person_id":"p940a8493b5c6","title":"","units":[]},"p940a8493b5c6-item-2e8d7100568f0223db37":{"id":"p940a8493b5c6-item-2e8d7100568f0223db37","person_id":"p940a8493b5c6","title":"仲宗過筠荘作詩見招且有借庵之意次其韻","units":[{"id":"p940a8493b5c6-item-2e8d7100568f0223db37-part-01","status":"automatic","work_id":"p940a8493b5c6-text-2a01e71bd917ff6b61c9","title":"仲宗過筠荘作詩見招且有借庵之意次其韻"}]},"p940a8493b5c6-item-b6d2f6a8f72657b4f052":{"id":"p940a8493b5c6-item-b6d2f6a8f72657b4f052","person_id":"p940a8493b5c6","title":"次韻葉觀文遊鼓山","units":[{"id":"p940a8493b5c6-item-b6d2f6a8f72657b4f052-part-01","status":"automatic","work_id":"p940a8493b5c6-text-4c3bdefd9327eb0538d7","title":"次韻葉觀文遊鼓山"}]},"p940a8493b5c6-item-180df37294cf76fb895f":{"id":"p940a8493b5c6-item-180df37294cf76fb895f","person_id":"p940a8493b5c6","title":"次韻葉觀文東禪開堂","units":[{"id":"p940a8493b5c6-item-180df37294cf76fb895f-part-01","status":"automatic","work_id":"p940a8493b5c6-text-08f6f66d5e57db210144","title":"次韻葉觀文東禪開堂"}]},"p940a8493b5c6-item-0aadf707f1cab417e1b0":{"id":"p940a8493b5c6-item-0aadf707f1cab417e1b0","person_id":"p940a8493b5c6","title":"","units":[]},"p940a8493b5c6-item-17143ecc6994d2a1065c":{"id":"p940a8493b5c6-item-17143ecc6994d2a1065c","person_id":"p940a8493b5c6","title":"仲宗訪我筠溪出陪富文粹之遊天宫詩見索屬和次韻","units":[{"id":"p940a8493b5c6-item-17143ecc6994d2a1065c-part-01","status":"automatic","work_id":"p940a8493b5c6-text-646c310b719f13070934","title":"仲宗訪我筠溪出陪富文粹之遊天宫詩見索屬和次韻"}]},"p940a8493b5c6-item-539d3bfff0eba73adb8b":{"id":"p940a8493b5c6-item-539d3bfff0eba73adb8b","person_id":"p940a8493b5c6","title":"蝶恋花","units":[{"id":"p940a8493b5c6-item-539d3bfff0eba73adb8b-part-01","status":"automatic","work_id":"p940a8493b5c6-text-10620ce55a10dc0325e7","title":"蝶恋花"}]}},"works":{"p940a8493b5c6-text-15faf6d4ae1b8de07638":{"id":"p940a8493b5c6-text-15faf6d4ae1b8de07638","person_id":"p940a8493b5c6","title":"秋居雜詠  其一","titles":["秋居雜詠  其一"],"text":"久懷簡書畏，幸解紳笏束。\n忘年効兒女，適意揮僮僕。\n植杖理新蕉，埋盆養寒菊。\n前除馴鵲烏，近檻遊麋鹿。\n遐觀時倚楹，瞑坐或忘燭。\n門闌迹如掃，我亦甘幽獨。"},"p940a8493b5c6-text-c60d53c8a3036f5348ad":{"id":"p940a8493b5c6-text-c60d53c8a3036f5348ad","person_id":"p940a8493b5c6","title":"秋居雜詠  其二","titles":["秋居雜詠  其二"],"text":"薿薿庭前林，離離夾中道。\n靈柯結繁陰，顔色四時好。\n豈無霜雪侵，不改凌雲操。\n緬懷壯士心，雅契幽人抱。\n如何方寸搖，懸若風中纛。\n吾廬偶與鄰，聊擬七松號。"},"p940a8493b5c6-text-e390270c32a635c79c84":{"id":"p940a8493b5c6-text-e390270c32a635c79c84","person_id":"p940a8493b5c6","title":"秋居雜詠  其三","titles":["秋居雜詠  其三"],"text":"青春背我去，白日不吾謀。\n霜飈驚草木，寒威戒衣裘。\n寓形復幾時，四序忽一周。\n世路伏劍戟，中懷孕螟蟊。\n營營事長久，頽齡如置郵。\n丘園倘未卜，悟悅心自休。"},"p940a8493b5c6-text-9d9919aa3cc9a9774c06":{"id":"p940a8493b5c6-text-9d9919aa3cc9a9774c06","person_id":"p940a8493b5c6","title":"秋居雜詠  其四","titles":["秋居雜詠  其四"],"text":"窮秋雜花遠，眷此霜下傑。\n明金委珞瓔，寶璐綴環玦。\n依依風遞蘭，皓皓日穿雪。\n若無夭冶姿，不受衆目悅。\n共杯泛其英，攬之腸爲結。\n誰能踵高門，持以浣中熱。"},"p940a8493b5c6-text-442670a4159204f2e974":{"id":"p940a8493b5c6-text-442670a4159204f2e974","person_id":"p940a8493b5c6","title":"秋居雜詠  其五","titles":["秋居雜詠  其五"],"text":"出門泥活活，不聞車馬喧。\n一身謝羈絆，百事從弃捐。\n坐曠非息慮，逃空遂忘言。\n青燈有餘燼，妙香無續烟。\n涓涓簷間霤，獵獵窗上鳶。\n夫物具成禮，胡爲尚求筌。"},"p940a8493b5c6-text-74678c99fbd7111ebe65":{"id":"p940a8493b5c6-text-74678c99fbd7111ebe65","person_id":"p940a8493b5c6","title":"秋居雜詠  其六","titles":["秋居雜詠  其六"],"text":"顒顒集癯仙，娟娟羅靜女。\n孤標與秀色，翛然出環堵。\n我來三二月，離立僅成伍。\n及秋新梢敷，接葉庇風雨。\n一日不可無，幸兹共寒暑。\n高枝有垂賞，鳴鳯在何許。"},"p940a8493b5c6-text-a4755fa64e8b32b632da":{"id":"p940a8493b5c6-text-a4755fa64e8b32b632da","person_id":"p940a8493b5c6","title":"秋居雜詠  其七","titles":["秋居雜詠  其七"],"text":"駕言出城闕，行行陟崇山。\n舒懷到昭曠，未覺天地寬。\n鴥彼離群雁，嘹嘹浮雲端。\n嗟我遠兄弟，千里同歲寒。\n舉頭不見日，况復遠長安。\n歸飛胡不早，聽此彫朱顔。"},"p940a8493b5c6-text-128ddcdf9d71308f86dd":{"id":"p940a8493b5c6-text-128ddcdf9d71308f86dd","person_id":"p940a8493b5c6","title":"秋居雜詠  其八","titles":["秋居雜詠  其八"],"text":"茅茨八九椽，中有插架軸。\n琅函與貝葉，落落皆在目。\n閑依浄几繙，緩繞疏篁讀。\n困即抱之眠，擁鼾寧厭熟。\n不知老將至，一時肯載腹。\n此樂殊未央，吾生亦云足。"},"p940a8493b5c6-text-e5e2fc1ab5ab3a648449":{"id":"p940a8493b5c6-text-e5e2fc1ab5ab3a648449","person_id":"p940a8493b5c6","title":"秋居雜詠  其九","titles":["秋居雜詠  其九"],"text":"公園十畝餘，日陟亦成趣。\n浮陰未全收，晴沙已勝步。\n杖藜相與行，童稚雜冠履。\n枯魚泳微瀾，悴菊飲晞露。\n欣物各有時，撫懷偶軒慮。\n安得三徑餘，誅茅種瓜芋。"},"p940a8493b5c6-text-4d75c7b3ec3024339d3b":{"id":"p940a8493b5c6-text-4d75c7b3ec3024339d3b","person_id":"p940a8493b5c6","title":"寄題福州程進道止戈堂二首  其一","titles":["寄題福州程進道止戈堂二首  其一"],"text":"不識威名擅漢廷，雲仍今復見材卿。\n萬家桃李栽培盛，千里妖氛卻掃清。\n羽扇綸巾聊自適，風聲鶴唳已魂驚。\n向來雪鍔櫜藏地，賸築詩壇按酒兵。"},"p940a8493b5c6-text-bab86259b430fcb0e7ee":{"id":"p940a8493b5c6-text-bab86259b430fcb0e7ee","person_id":"p940a8493b5c6","title":"寄題福州程進道止戈堂二首  其二","titles":["寄題福州程進道止戈堂二首  其二"],"text":"一麾局促楚江東，時喜鄰藩好信通。\n坐厭文書朱墨裏，靜思談笑聖賢中。\n浮甌小試茶膏白，照眼分嘗荔子紅。\n想見髙堂分鳬鶩，競追樂事賞年豐。"},"p940a8493b5c6-text-19f91e0168fa235058a7":{"id":"p940a8493b5c6-text-19f91e0168fa235058a7","person_id":"p940a8493b5c6","title":"次韻李丞相送行二首  其一","titles":["次韻李丞相送行二首  其一"],"text":"三年袖手臥江濱，着眼終成出世人。\n筆下風雲作時雨，胸中丘壑作陽春。\n買山塵外曾相見，漉酒愁邉情更親。\n惜取風騷等閑句，他時密膝詠臣鄰。"},"p940a8493b5c6-text-52a4704679bf58f38984":{"id":"p940a8493b5c6-text-52a4704679bf58f38984","person_id":"p940a8493b5c6","title":"次韻李丞相送行二首  其二","titles":["次韻李丞相送行二首  其二"],"text":"山畔孤亭一水濱，歸來華髪已欺人。\n脱身異縣干戈地，得意吾廬筍蕨春。\n早着青衫成底事，慣遭白眼欲誰親。\n此君真有髙人節，肯與山翁作近鄰。"},"p940a8493b5c6-text-445572fb48bca73d91b6":{"id":"p940a8493b5c6-text-445572fb48bca73d91b6","person_id":"p940a8493b5c6","title":"故相少師李公挽詩  其一","titles":["故相少師李公挽詩  其一"],"text":"天意康時難，賢生蓋世雄。\n風流晉人上，事業舜歌中。\n許國回天力，懷君貫日忠。\n平生英爽氣，凛凛未成空。"},"p940a8493b5c6-text-1d1a79f7af09d40f8006":{"id":"p940a8493b5c6-text-1d1a79f7af09d40f8006","person_id":"p940a8493b5c6","title":"故相少師李公挽詩  其二","titles":["故相少師李公挽詩  其二"],"text":"國步乘陽九，胡塵暗上京。\n支傾隆大厦，卻敵隱長城。\n草木知春澤，狐狸絕夜鳴。\n雲臺瞻袞繡，千古繼哀榮。"},"p940a8493b5c6-text-1d09c65385198b289d23":{"id":"p940a8493b5c6-text-1d09c65385198b289d23","person_id":"p940a8493b5c6","title":"次韻蘇粹之發幹見贈  其一","titles":["次韻蘇粹之發幹見贈  其一"],"text":"頽齡知有幾，誰復問行藏。\n散策蒼林靜，抛書白晝長。\n相呼山鳥聚，自落澗花香。\n此地無車馬，真成物我忘。"},"p940a8493b5c6-text-cbe5020c7f5fe87aa2be":{"id":"p940a8493b5c6-text-cbe5020c7f5fe87aa2be","person_id":"p940a8493b5c6","title":"次韻蘇粹之發幹見贈  其二","titles":["次韻蘇粹之發幹見贈  其二"],"text":"漂泊音書斷，艱難會合遲。\n那知休老地，卻數别君時。\n歲晚商山寂，天寒楚水悲。\n無言一杯酒，懷抱各相知。"},"p940a8493b5c6-text-5c1f2a0b993855aef383":{"id":"p940a8493b5c6-text-5c1f2a0b993855aef383","person_id":"p940a8493b5c6","title":"初歸筠荘蘇粹之以詩見貽次韻答之  其一","titles":["初歸筠荘蘇粹之以詩見貽次韻答之  其一"],"text":"八尺茅茨老竹林，細償南北故園心。\n一溪止水清涵月，三日行雲薄釀霖。\n歸計欲成猶恨晚，醉愁無賴正傷今。\n喚回柏子香中夢，屋角秋聲亂翠陰。"},"p940a8493b5c6-text-2a01e71bd917ff6b61c9":{"id":"p940a8493b5c6-text-2a01e71bd917ff6b61c9","person_id":"p940a8493b5c6","title":"仲宗過筠荘作詩見招且有借庵之意次其韻","titles":["仲宗過筠荘作詩見招且有借庵之意次其韻"],"text":"横山留我正青眼，不是歸心久更微。\n病後團蒲隨地隐，望中落木故園稀。\n一區已辦雲爲蓋，四壁但從山作圍。\n不厭是中無一物，徑來相就老禪扉。"},"p940a8493b5c6-text-4c3bdefd9327eb0538d7":{"id":"p940a8493b5c6-text-4c3bdefd9327eb0538d7","person_id":"p940a8493b5c6","title":"次韻葉觀文遊鼓山","titles":["次韻葉觀文遊鼓山"],"text":"謝公憂民餘，妙語繼兩禪。\n兹遊瞰滄溟，宛在一葉蓮。\n木密虚可步，石立髙莫緣。\n從來看山眼，一洗俱茫然。\n蓬萊如有無，空翠蒙雲烟。\n卻疑浩蕩中，天津渺歸船。\n崎嶇訪幽勝，衆象爭相鮮。\n凌髙寓遠目，孤雲共軒軿。\n歸來擁寒衾，耳底酒鳴泉。\n覓句了不工，青燈暗孤眠。"},"p940a8493b5c6-text-08f6f66d5e57db210144":{"id":"p940a8493b5c6-text-08f6f66d5e57db210144","person_id":"p940a8493b5c6","title":"次韻葉觀文東禪開堂","titles":["次韻葉觀文東禪開堂"],"text":"閩山多勝地，列屋栖髙禪。\n妙供積香苾，寶華散金蓮。\n往時入廛手，來見住世緣。\n遼遼百年後，慧炬無復然。\n我公具正眼，爲續旃檀烟。\n諸方坐老衲，具足世法船。\n少開迷雲昬，氛埃遂澄鮮。\n我來偶相值，杖履參髙軿。\n拈花起一笑，歸去跨林泉。\n從兹竹陰下，飽飯縱横眠。"},"p940a8493b5c6-text-646c310b719f13070934":{"id":"p940a8493b5c6-text-646c310b719f13070934","person_id":"p940a8493b5c6","title":"仲宗訪我筠溪出陪富文粹之遊天宫詩見索屬和次韻","titles":["仲宗訪我筠溪出陪富文粹之遊天宫詩見索屬和次韻"],"text":"作伴僊翁覓轉春，净坊俱現宰官身。\n蘭亭夢想如三月，蓮社追遊少一人。\n雨磴勞君鳴屐齒，風軒爲我掃衣塵。\n應憐野老聞韶後，旋束蔬腸學練津。"},"p940a8493b5c6-text-10620ce55a10dc0325e7":{"id":"p940a8493b5c6-text-10620ce55a10dc0325e7","person_id":"p940a8493b5c6","title":"蝶恋花","titles":["蝶恋花"],"text":"百叠青山江一缕。\n十里人家，路绕南台去。\n榕叶满川飞白鹭。\n疏帘半卷黄昏雨。\n楼阁峥嵘天尺五。\n荷芰风清，习习消袢暑。\n老子人间无著处。\n一尊来作横山主。"}}}
